def parse_probe_output(out, rc, err):
    """the probe's JSON lines -> {"platform", "egl", "contexts": [...], "error" when anything went wrong}. One line
    per context, flushed as it is made: a crash in a later context, or stray stdout from a vendor library, loses
    nothing that came before. The single-document form of the first version is read too."""
    res = {"egl": {}, "contexts": []}
    done = False
    for line in (out or "").splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            obj = json.loads(line)
        except ValueError:
            continue
        if "context" in obj:
            res["contexts"].append(obj["context"])
        elif "contexts" in obj:
            res["contexts"].extend(obj["contexts"])
            res["egl"] = obj.get("egl", {})
            if obj.get("error"):
                res["error"] = obj["error"]
            done = True
        elif obj.get("done"):
            done = True
        else:
            for k in ("platform", "egl", "error"):
                if k in obj:
                    res[k] = obj[k]
    if not done or rc != 0:
        res["error"] = "%sprobe rc=%s%s: %s" % ((res["error"] + "; ") if res.get("error") else "", rc,
                                                "" if done else " (incomplete)", _tail(err, 400))
    return res


def probe_main():
    """JSON lines on stdout: the EGL surfaceless display facts, then one line per context kind (es, compat, core)
    with its version strings, extension list and GL_INTS (None = the query was rejected in that context), then
    {"done": true}; parse_probe_output reads them"""
    import ctypes as C
    EGL_NONE, EGL_EXTENSIONS, EGL_VENDOR, EGL_VERSION, EGL_CLIENT_APIS = 0x3038, 0x3055, 0x3053, 0x3054, 0x308D
    EGL_PLATFORM_SURFACELESS_MESA, EGL_OPENGL_API, EGL_OPENGL_ES_API = 0x31DD, 0x30A2, 0x30A0
    MAJOR, MINOR, PROFILE = 0x3098, 0x30FB, 0x30FD
    GL_VENDOR, GL_RENDERER, GL_VERSION, GL_SLV, GL_EXTS, GL_NUM_EXTS = 0x1F00, 0x1F01, 0x1F02, 0x8B8C, 0x1F03, 0x821D
    res = {"platform": "surfaceless", "egl": {}}

    def emit(obj):
        sys.stdout.write(json.dumps(obj) + "\n")
        sys.stdout.flush()

    def done():
        emit(res)
        emit({"done": True})
        return 0

    try:
        egl = C.CDLL("libEGL.so.1")
    except OSError as e:
        res["error"] = "libEGL.so.1: %s" % e
        return done()
    vp = C.c_void_p
    egl.eglGetProcAddress.restype, egl.eglGetProcAddress.argtypes = vp, [C.c_char_p]
    egl.eglQueryString.restype, egl.eglQueryString.argtypes = C.c_char_p, [vp, C.c_int]
    egl.eglInitialize.restype, egl.eglInitialize.argtypes = C.c_uint, [vp, C.POINTER(C.c_int), C.POINTER(C.c_int)]
    egl.eglBindAPI.restype, egl.eglBindAPI.argtypes = C.c_uint, [C.c_uint]
    egl.eglCreateContext.restype, egl.eglCreateContext.argtypes = vp, [vp, vp, vp, C.POINTER(C.c_int)]
    egl.eglMakeCurrent.restype, egl.eglMakeCurrent.argtypes = C.c_uint, [vp, vp, vp, vp]
    egl.eglDestroyContext.restype, egl.eglDestroyContext.argtypes = C.c_uint, [vp, vp]
    egl.eglTerminate.restype, egl.eglTerminate.argtypes = C.c_uint, [vp]
    egl.eglGetError.restype = C.c_int
    ce = egl.eglQueryString(None, EGL_EXTENSIONS)
    res["egl"]["client_extensions"] = (ce or b"").decode(errors="replace").split()
    addr = egl.eglGetProcAddress(b"eglGetPlatformDisplayEXT")
    if not addr:
        res["error"] = "no eglGetPlatformDisplayEXT"
        return done()
    get_display = C.CFUNCTYPE(vp, C.c_uint, vp, vp)(addr)
    dpy = get_display(EGL_PLATFORM_SURFACELESS_MESA, None, None)
    ma, mi = C.c_int(), C.c_int()
    if not dpy or not egl.eglInitialize(dpy, C.byref(ma), C.byref(mi)):
        res["error"] = "surfaceless eglInitialize failed (0x%x)" % egl.eglGetError()
        return done()
    for k, e in (("vendor", EGL_VENDOR), ("version", EGL_VERSION), ("client_apis", EGL_CLIENT_APIS),
                 ("extensions", EGL_EXTENSIONS)):
        s = (egl.eglQueryString(dpy, e) or b"").decode(errors="replace")
        res["egl"][k] = s.split() if k == "extensions" else s
    qd = egl.eglGetProcAddress(b"eglGetDisplayDriverName")
    if qd:
        name = C.CFUNCTYPE(C.c_char_p, vp)(qd)(dpy)
        res["egl"]["driver"] = (name or b"").decode()

    def gl(name, restype, argtypes):
        a = egl.eglGetProcAddress(name.encode())
        return C.CFUNCTYPE(restype, *argtypes)(a) if a else None

    # GLES first: a GLES-only vendor stack that dies on a desktop-GL request must leave its ES context behind
    emit({"platform": "surfaceless", "egl": res["egl"]})
    # the highest ES first: a vendor EGL that answers a 2.0 request with exactly 2.0 rejects every ES 3 limit query
    specs = [("es", EGL_OPENGL_ES_API, [[MAJOR, 3, MINOR, 2], [MAJOR, 3, MINOR, 1], [MAJOR, 3, MINOR, 0], [MAJOR, 2]]),
             ("compat", EGL_OPENGL_API, [[]]),
             ("core", EGL_OPENGL_API, [[MAJOR, 3, MINOR, 2, PROFILE, 1], [MAJOR, 3, MINOR, 1]])]
    for api, bind, attempts in specs:
        c = {"api": api, "ok": False}
        if not egl.eglBindAPI(bind):
            c["error"] = "eglBindAPI failed (0x%x)" % egl.eglGetError()
            emit({"context": c})
            continue
        ctx = None
        for attrs in attempts:
            arr = (C.c_int * (len(attrs) + 1))(*attrs, EGL_NONE)
            ctx = egl.eglCreateContext(dpy, None, None, arr)
            if ctx:
                c["requested"] = attrs
                break
        if not ctx:
            c["error"] = "eglCreateContext failed (0x%x)" % egl.eglGetError()
            emit({"context": c})
            continue
        if not egl.eglMakeCurrent(dpy, None, None, ctx):
            c["error"] = "eglMakeCurrent failed (0x%x)" % egl.eglGetError()
            egl.eglDestroyContext(dpy, ctx)
            emit({"context": c})
            continue
        get_string = gl("glGetString", C.c_char_p, [C.c_uint])
        get_stringi = gl("glGetStringi", C.c_char_p, [C.c_uint, C.c_uint])
        get_integerv = gl("glGetIntegerv", None, [C.c_uint, C.POINTER(C.c_int)])
        get_error = gl("glGetError", C.c_uint, [])

        def s(e):
            v = get_string(e)
            return v.decode(errors="replace") if v else None

        c.update(ok=True, vendor=s(GL_VENDOR), renderer=s(GL_RENDERER), version=s(GL_VERSION), sl_version=s(GL_SLV))
        for _ in range(16):
            if not get_error():
                break
        buf = (C.c_int * 4)()
        mask = None
        if api != "es":
            get_integerv(0x9126, buf)              # GL_CONTEXT_PROFILE_MASK, GL 3.2+
            mask = None if get_error() else buf[0]
        c["requested_api"], c["api"] = api, actual_api(api, c["version"], mask)
        n = None
        if get_stringi and (gl_version_number(c["version"]) or 0) >= 30:
            get_integerv(GL_NUM_EXTS, buf)
            n = buf[0] if not get_error() else None
        if n:
            c["extensions"] = [x.decode(errors="replace") for x in (get_stringi(GL_EXTS, i) for i in range(n)) if x]
        else:
            c["extensions"] = (s(GL_EXTS) or "").split()
        ints = {}
        for name, enum, count in GL_INTS:
            for _ in range(16):
                if not get_error():
                    break
            buf = (C.c_int * 4)()
            get_integerv(enum, buf)
            ints[name] = None if get_error() else list(buf[:count])
        # timestamp counter bits, only where a timer query exists: a listed timer extension may still count 0 bits,
        # and a dispatch stub for a missing function reads back 0 without an error
        ext = set(c["extensions"])
        bits = None
        if ("GL_EXT_disjoint_timer_query" in ext if c["api"] == "es"
                else "GL_ARB_timer_query" in ext or (gl_version_number(c["version"]) or 0) >= 33):
            get_queryiv = gl("glGetQueryivEXT" if c["api"] == "es" else "glGetQueryiv", None,
                             [C.c_uint, C.c_uint, C.POINTER(C.c_int)])
            if get_queryiv:
                for _ in range(16):
                    if not get_error():
                        break
                qb = (C.c_int * 1)()
                get_queryiv(0x8E28, 0x8864, qb)            # GL_TIMESTAMP, GL_QUERY_COUNTER_BITS
                bits = None if get_error() else [qb[0]]
        ints["GL_QUERY_COUNTER_BITS_TIMESTAMP"] = bits
        c["ints"] = ints
        egl.eglMakeCurrent(dpy, None, None, None)
        egl.eglDestroyContext(dpy, ctx)
        emit({"context": c})
    # no eglTerminate: the process exits anyway, and a vendor EGL that crashes in its teardown must not cost data
    emit({"done": True})
    return 0


