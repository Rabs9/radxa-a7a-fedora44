def primary_view(snap, name):
    """the named view of a snapshot; a missing one is an error, never a silent substitute (a vendor file recorded
    with --views fedora-mesa would otherwise make lavapipe "the DDK")"""
    views = snap.get("views", {})
    if name not in views:
        raise ValueError("the snapshot has no %r view (it has: %s)" % (name, ", ".join(views) or "none"))
    return name, views[name]


_SOFTWARE = re.compile(r"llvmpipe|softpipe|swrast|SwiftShader", re.I)


def platform_is_software(p):
    """an eglinfo platform served by a software rasterizer (eglinfo's "Device #1" on this board is llvmpipe)"""
    if (p.get("egl") or {}).get("driver") in ("swrast", "kms_swrast"):
        return True
    if "EGL_MESA_device_software" in (p.get("device_extensions") or []):
        return True
    return any(_SOFTWARE.search(prof.get("renderer") or "") for prof in (p.get("gl") or {}).values())


def _view_sources(view):
    """(kind, api, version string, extensions, source label) of every GL context a view recorded. Software
    platforms and a software glxinfo only count when the whole view is software (a GPU view must not borrow
    llvmpipe's extensions)"""
    if view.get("fallback"):
        return []                     # not the stack the view is named after (zink fell back to llvmpipe, ...)
    plats = [p for p in (view.get("eglinfo") or {}).get("platforms", []) if p.get("gl")]
    hw = [p for p in plats if not platform_is_software(p)]
    probe = [c for c in probe_contexts(view.get("probe")) if c.get("ok")]
    software_view = not hw and (not probe or all(_SOFTWARE.search(c.get("renderer") or "") for c in probe))
    out = []
    for c in probe:
        if _SOFTWARE.search(c.get("renderer") or "") and not software_view:
            continue
        n = gl_version_number(c.get("version"))
        out.append(("probe", c["api"], c.get("version"), c.get("extensions", []), c.get("label", "normal"),
                    "%s probe %s %d.%d" % (c.get("label", "normal"), c["api"], *divmod(n or 0, 10))))
    for p in (plats if software_view else hw):
        for api, prof in p["gl"].items():
            n = gl_version_number(prof.get("version"))
            out.append(("eglinfo", api, prof.get("version"), prof.get("extensions", []), "normal",
                        "eglinfo %s %s %d.%d" % (p["name"], api, *divmod(n or 0, 10))))
    g = view.get("glxinfo") or {}
    for api in ("compat", "core", "es"):
        prof = g.get(api)
        if not prof:
            continue
        rend = prof.get("renderer") or (g.get("compat") or {}).get("renderer") or ""
        if _SOFTWARE.search(rend) and not software_view:
            continue
        n = gl_version_number(prof.get("version"))
        out.append(("glxinfo", api, prof.get("version"), prof.get("extensions", []), "normal",
                    "glxinfo %s %d.%d" % (api, *divmod(n or 0, 10))))
    return out


def view_versions(view):
    """highest GL compat / GL core / GLES version the view's GPU contexts report (no override), with the strings"""
    out = {"compat": None, "core": None, "es": None}
    strings = {"compat": None, "core": None, "es": None}
    for kind, api, s, _ext, label, _src in _view_sources(view):
        if label != "normal":
            continue
        n = gl_version_number(s)
        if n and (out[api] is None or n > out[api]):
            out[api], strings[api] = n, s
    return out, strings


def view_contexts(view):
    """every GL context of a view with its extension list, for observe_flags"""
    return [{"api": api, "version": gl_version_number(s), "extensions": ext, "source": src}
            for _kind, api, s, ext, _label, src in _view_sources(view)]


def _step_label(key, step):
    return {"gl_compat": "OpenGL %s (compatibility)", "gl_core": "OpenGL %s (core)", "es": "OpenGL ES %s"}[key] % step


def _yn(v):
    return {True: "yes", False: "**no**", None: "?"}[v]


def _fmt(v):
    if isinstance(v, list):
        return ", ".join(str(x).replace("VK_SAMPLE_COUNT_", "").replace("_BIT", "") for x in v)
    return str(v)


def _flag_of(term):
    m = re.match(r"^extensions->(\w+)$", term)
    return m.group(1) if m else None


def render_report(open_snap, vendor_snap, gates, title="GPU gap report", open_file=None, vendor_file=None,
                  notes=None, gates_file=None, open_view="open", vendor_view="ddk"):
    L = []
    w = L.append
    on, ov = primary_view(open_snap, open_view)
    vn, vv = primary_view(vendor_snap, vendor_view)
    ovk, vvk = ov.get("vulkan") or {}, vv.get("vulkan") or {}
    ext_table = gates["ext_table"]
    g = gates["gates"]
    flags = observe_flags(ext_table, view_contexts(ov))
    consts = consts_from_probe(ov.get("probe"), ov.get("glxinfo"))
    ev = evaluate_gates(g, flags, consts)
    over, ostr = view_versions(ov)
    vver, vstr = view_versions(vv)
    diff = diff_vulkan(ovk, vvk) if "extensions" in ovk and "extensions" in vvk else None

    w("# %s" % title)
    w("")
    w("Generated by `tools/board/a7a-gpu-gap report` (a7a-gpu-tools) from `%s` (open stack) and `%s` (vendor boot). "
      "Mesa's version gates: Mesa %s `src/mesa/main/version.c` (sha256 `%s`), extracted verbatim by `a7a-gpu-gap gates`%s. "
      "Do not edit the generated sections by hand: change the tool or the notes file and re-run."
      % (open_file or "open snapshot", vendor_file or "vendor snapshot", gates.get("mesa_version"),
         (gates.get("version_c_sha256") or "")[:16], " into `%s`" % gates_file if gates_file else ""))
    w("")
    for label, snap in (("open", open_snap), ("vendor", vendor_snap)):
        s = snap.get("system", {})
        w("- **%s snapshot** %s on %s: kernel `%s`, driver `%s`, GPU %s MHz @ %s mV (pll-gpu %s MHz), runtime PM %s, "
          "session %s%s" % (label, snap.get("taken", "?"), snap.get("host", "?"), s.get("kernel"), s.get("driver"),
                            s.get("gpu_clock_mhz", "?"), s.get("dcdc4_mv", "?"), s.get("pll_gpu_mhz", "?"),
                            "/".join(str(x) for x in (s.get("runtime_pm") or {}).values()) or "?",
                            "logged in" if snap.get("session") else "none",
                            ", DDK %s" % s["ddk_version"] if s.get("ddk_version") and label == "vendor" else ""))
    w("")

    # ---- summary
    w("## Summary")
    w("")
    w("| | GL compat | GL core | GLES | Vulkan |")
    w("|---|---|---|---|---|")
    for name, view, snap in [(on, ov, open_snap)] + [(n, x, vendor_snap) for n, x in vendor_snap.get("views", {}).items()]:
        vr, vs = view_versions(view)
        vk = view.get("vulkan") or {}
        if view.get("fallback"):
            w("| **%s** (reference) | fell back, not used: %s | | | |" % (name, view["fallback"]))
            continue
        w("| **%s**%s | %s | %s | %s | %s |" % (
            name, " (primary)" if name in (on, vn) else " (reference)",
            vs["compat"] or "-", vs["core"] or "-", vs["es"] or "-",
            "%s %s (%s)" % (vk.get("api_version"), vk.get("device_name"), vk.get("driver_info") or vk.get("driver_name"))
            if "api_version" in vk else vk.get("error", "-")))
    w("")
    nxt = []
    for key in ("es", "gl_compat"):
        for row in ev[key]:
            if row["value"] is not True:
                nxt.append((key, row))
                break
    for key, row in nxt:
        terms = row["fails"] + ["%s (unobservable)" % u for u in row["unknown"]]
        w("- Next step for the open stack: **%s** fails on %s." % (
            _step_label(key, row["step"]),
            ", ".join("`%s`" % t for t in terms) if terms else "the previous step (%s)" % row["blocked_by"]))
    if diff:
        w("- Vulkan, DDK against the open driver: %d features the DDK has and the open driver lacks, %d extensions, "
          "%d limits lower on the open driver, %d formats missing, %d formats with fewer features."
          % (len(diff["features_missing"]), len(diff["extensions_missing"]), len(diff["limits_worse"]),
             len(diff["formats_missing"]), len(diff["formats_fewer"])))
    w("")

    # ---- ranked actions
    # a vendor view that fell back (llvmpipe instead of the DDK) proves nothing: its limits are not vendor evidence
    ves = [c for c in probe_contexts(vv.get("probe")) if c.get("ok") and c.get("api") == "es"
           and c.get("label", "normal") == "normal" and not vv.get("fallback")]
    # no ES context recorded for the vendor = no data (unknown), not "no extensions" / "no limits"
    vints = ves[0].get("ints") if ves else None
    vexts = sorted({e for _k, api, _s, ext, label, _src in _view_sources(vv) if api == "es" and label == "normal"
                    for e in ext}) or None
    ra = rank_actions(g, flags, consts, ovk, vvk if "extensions" in vvk else None, vver, vexts, vints)
    w("## Ranked actions")
    w("")
    w("Milestones in the order that unlocks the most applications (table below) per unit of work: a limit counts 1, "
      "a feature 10, an item the vendor stack does not prove 1000. Every item is a Vulkan requirement the open "
      "driver fails today. *Vendor* = what proves the hardware has it: the DDK's own Vulkan driver, else its GLES "
      "(version, extension or limit). *After* = the versions Mesa's gates give once this item and every item "
      "above it are fixed (simulated with the same gate evaluation).")
    w("")
    labels = {"limit": "config/limit (hours)", "project": "missing feature with hardware support: a project",
              "hardware": "hardware-absent per the vendor stack: skip", "unknown": "no vendor data",
              "unmapped": "not mapped to a Vulkan item"}
    n = 0
    for m in ra["milestones"]:
        w("### %s%s" % (m["step"], "" if m["complete"] else " (not complete with these items: see unmapped terms)"))
        w("")
        if m["unlocks"]:
            w("Unlocks: %s." % ", ".join(m["unlocks"]))
            w("")
        for it in m["items"]:
            n += 1
            evid = "DDK Vulkan %s" % _yn(it["vendor_vulkan"])
            if it["vendor_gles"]:
                evid += "; DDK GLES proves it (%s)" % ", ".join("`%s`" % x for x in it["vendor_gles"])
            sizes = sorted({(ra["terms"][t]["knowledge"] or {}).get("size", "") for t in it["terms"]
                            if t in ra["terms"]} - {""})
            aft = it["reached_after"]
            w("%d. `%s`: **%s**. Vendor: %s. Needed by %s. After: GL %s, GLES %s.%s%s"
              % (n, it["req"], labels[it["class"]], evid, ", ".join("`%s`" % t for t in it["terms"]),
                 aft["gl_compat"] or "-", aft["es"] or "-",
                 (" " + VK_ITEM_NOTES[it["req"]] + ".") if it["req"] in VK_ITEM_NOTES else "",
                 (" Scope: " + " / ".join(sizes) + ".") if sizes else ""))
        w("")
    if not ra["milestones"]:
        w("Every GL and GLES step Mesa knows is reached.")
        w("")

    # ---- gates
    w("## The Mesa version gates on the open stack")
    w("")
    w("Every step Mesa %s computes, evaluated against the open stack's flags (extension strings of every context "
      "eglinfo, glxinfo and the probe opened, plus the override probe's full flag list) and limits (glGetIntegerv). "
      "`?` = not observable. Reached: GL compat **%s**, GL core **%s**, GLES **%s** (the version strings say %s / %s / %s)."
      % (gates.get("mesa_version"), ev["reached"]["gl_compat"] or "-", ev["reached"]["gl_core"] or "none",
         ev["reached"]["es"] or "-", ostr["compat"] or "-", ostr["core"] or "none", ostr["es"] or "-"))
    w("")
    for key in ("es", "gl_compat", "gl_core"):
        rows = [r for r in ev[key] if r["value"] is not True]
        if not rows:
            continue
        w("| %s step | own terms that fail | unobservable | also blocked by |" % {"es": "GLES", "gl_compat": "GL compat", "gl_core": "GL core"}[key])
        w("|---|---|---|---|")
        for r in rows:
            w("| %s | %s | %s | %s |" % (r["step"], "<br>".join("`%s`" % t for t in r["fails"]) or "-",
                                         "<br>".join("`%s`" % t for t in r["unknown"]) or "-", r["blocked_by"] or "-"))
        w("")
    w("Limits the gates read (open stack):")
    w("")
    for name in gate_consts(g):
        c = consts.get(name, {})
        w("- `%s` = %s (%s)" % (name, c.get("value"), c.get("evidence", "not measured")))
    w("")

    # ---- Vulkan
    w("## Vulkan: the DDK against the open driver")
    w("")
    if not diff:
        w("No Vulkan data on one side: open `%s`, vendor `%s`." % (ovk.get("error", "ok"), vvk.get("error", "ok")))
    else:
        w("API version: open %s, DDK %s." % tuple(diff["api"]))
        w("")
        w("### Features true on the DDK, false on the open driver (%d)" % len(diff["features_missing"]))
        w("")
        w("| feature | reported in |")
        w("|---|---|")
        for f in diff["features_missing"]:
            w("| `%s` | %s |" % (f["member"], ", ".join(f["structs"])))
        w("")
        w("### Extensions the DDK has and the open driver lacks (%d)" % len(diff["extensions_missing"]))
        w("")
        w(", ".join("`%s`" % e for e in diff["extensions_missing"]) or "none")
        w("")
        w("### Limits lower on the open driver (%d)" % len(diff["limits_worse"]))
        w("")
        w("| limit | open | DDK |")
        w("|---|---|---|")
        for r in diff["limits_worse"]:
            w("| `%s` | %s | %s |" % (r["name"], _fmt(r["open"]), _fmt(r["vendor"])))
        w("")
        w("### Formats")
        w("")
        w("Formats the DDK supports and the open driver does not list at all (%d): %s"
          % (len(diff["formats_missing"]), ", ".join("`%s`" % f.replace("VK_FORMAT_", "") for f in diff["formats_missing"]) or "none"))
        w("")
        if diff["formats_fewer"]:
            w("| format | tiling | features only the DDK has |")
            w("|---|---|---|")
            for r in diff["formats_fewer"]:
                w("| `%s` | %s | %s |" % (r["format"].replace("VK_FORMAT_", ""), r["tiling"],
                                          ", ".join(x.replace("VK_FORMAT_FEATURE_", "").replace("_BIT", "") for x in r["missing"])))
            w("")
        w("### The other direction (the open driver has, the DDK does not)")
        w("")
        w("Features: %s." % (", ".join("`%s`" % f["member"] for f in diff["features_extra"]) or "none"))
        w("")
        w("Extensions: %s." % (", ".join("`%s`" % e for e in diff["extensions_extra"]) or "none"))
        w("")
        w("Limits higher on the open driver: %s." % (", ".join("`%s` %s vs %s" % (r["name"], _fmt(r["open"]), _fmt(r["vendor"]))
                                                             for r in diff["limits_better"]) or "none"))
        w("")
        if diff["limits_differ"]:
            w("Limits that differ without a better/worse direction: %s." % ", ".join(
                "`%s` %s vs %s" % (r["name"], _fmt(r["open"]), _fmt(r["vendor"])) for r in diff["limits_differ"]))
            w("")

    # ---- apps
    w("## What applications need")
    w("")
    unlock_at = {a: m["step"] for m in ra["milestones"] for a in m["unlocks"]}

    def missing(needs, versions, vk, fl):
        """the unmet terms of the alternative closest to being met"""
        best = None
        for alt in needs:
            miss = ["%s:%s" % t for t in parse_need(alt) if not app_meets(["%s:%s" % t], versions, vk, fl)]
            if best is None or len(miss) < len(best):
                best = miss
        return best or []

    w("| application / toolkit | needs (any of) | open stack | vendor DDK | open stack gets it at | source |")
    w("|---|---|---|---|---|---|")
    for a in APPS:
        needs = " or ".join(" + ".join("%s %s" % t for t in parse_need(n)) for n in a["needs"])
        mo, mv = app_meets(a["needs"], over, ovk, flags), app_meets(a["needs"], vver, vvk)
        if mo:
            at = "-"
        elif a["name"] in unlock_at:
            at = unlock_at[a["name"]]
        else:
            at = "not in the ranked items; still missing: %s" % ", ".join(
                "`%s`" % x for x in missing(a["needs"], over, ovk, flags))
        w("| %s | %s | %s | %s | %s | %s |" % (a["name"], needs, _yn(mo), _yn(mv), at, a["source"]))
    w("")
    gviews = [(on, ov)] + [(n, x) for n, x in vendor_snap.get("views", {}).items() if n != on or x is not ov]

    def gtk_txt(x):
        g2 = x.get("gtk4") or {}
        if x.get("fallback"):
            return "not a measurement of this view (it fell back)"
        if "renderer" in g2:
            return "GTK %s %s" % (g2.get("gtk"), g2.get("renderer"))
        if "error" not in g2:
            return "not measured"
        return "GTK probe failed: %s" % gtk_error_summary(g2["error"])

    if any(x.get("gtk4") for _n, x in gviews):
        w("Measured on this board, a real GTK window per view (`a7a-gpu-gap` asks GTK which renderer it created): %s."
          % "; ".join("%s: %s" % (n, gtk_txt(x)) for n, x in gviews))
        w("")

    # ---- envelope
    w("## Hardware envelope")
    w("")
    ob, vb = open_snap.get("bench") or {}, vendor_snap.get("bench") or {}
    if ob.get("clients") or vb.get("clients"):
        w("glmark2-es2, median fps of %s runs after a discarded warm-up (build / texture scenes). Renderer = what "
          "glmark2 itself reported, so a silent software fallback shows." % (ob.get("reps") or vb.get("reps")))
        w("")
        w("| stack | client | size | build | texture | renderer |")
        w("|---|---|---|---|---|---|")
        for label, b in (("open", ob), ("DDK", vb)):
            for cname, sizes in (b.get("clients") or {}).items():
                for size, r in sizes.items():
                    m = r.get("median_fps", {})
                    w("| %s | %s | %s | %s | %s | %s |" % (label, cname, size, m.get("build"), m.get("texture"),
                                                           (r.get("renderer") or "?")[:60]))
        w("")
        fulls = [(label, c, r) for label, b in (("open", ob), ("DDK", vb)) for c, r in (b.get("full") or {}).items()]
        if fulls:
            w("Whole glmark2 suite at %s: %s." % ((ob or vb).get("sizes", ["?"])[0], "; ".join(
                "%s %s score %s" % (label, c, r.get("score")) for label, c, r in fulls)))
            w("")
        # the ratio, only where both stacks ran the same client at the same size
        pairs = []
        for cname, sizes in (vb.get("clients") or {}).items():
            for size, r in sizes.items():
                om = (((ob.get("clients") or {}).get(cname) or {}).get(size) or {}).get("median_fps") or {}
                vm = r.get("median_fps") or {}
                parts = ["%s %.1fx" % (sc, vm[sc] / om[sc]) for sc in ("build", "texture") if om.get(sc) and vm.get(sc)]
                if parts:
                    pairs.append("%s %s: %s" % (cname, size, ", ".join(parts)))
        for cname, r in (vb.get("full") or {}).items():
            oscore = ((ob.get("full") or {}).get(cname) or {}).get("score")
            if oscore and r.get("score"):
                pairs.append("whole suite %s: %.1fx" % (cname, r["score"] / oscore))
        if pairs:
            w("The vendor stack against the open stack, same client and size: %s." % "; ".join(pairs))
            w("")
        for label, b in (("open", ob), ("DDK", vb)):
            th = b.get("thermal")
            if th:
                w("- Thermals during the %s bench (%d samples): max %s; lowest CPU clocks %s; thermal/throttle kernel "
                  "lines during the run: %s." % (label, th.get("samples", 0),
                                                ", ".join("%s %.0f C" % kv for kv in sorted(th.get("max_temp_c", {}).items())),
                                                ", ".join("%s %d MHz" % kv for kv in sorted(th.get("min_cpu_mhz", {}).items())),
                                                th.get("throttle_lines_during")))
        w("")
    else:
        w("No bench data in the snapshots (`a7a-gpu-gap snapshot --bench` inside a logged-in desktop).")
        w("")
    w("GPU clock/voltage envelope (validated on this board):")
    w("")
    w("| pair | status | evidence |")
    w("|---|---|---|")
    for pair, status, evd in CLOCK_ENVELOPE:
        w("| %s | %s | %s |" % (pair, status, evd))
    w("")

    # ---- reference views
    refs = [(n, x) for n, x in vendor_snap.get("views", {}).items() if n != vn]
    if refs:
        w("## Reference views on the vendor boot")
        w("")
        for n, x in refs:
            if x.get("fallback"):
                w("- **%s**: fell back, so none of its numbers are used: %s." % (n, x["fallback"]))
                continue
            vr, vs = view_versions(x)
            vk = x.get("vulkan") or {}
            w("- **%s** (%s): GL compat %s, GL core %s, GLES %s; Vulkan %s." % (
                n, " ".join("%s=%s" % kv for kv in (x.get("env") or {}).items()) or "no overrides",
                vs["compat"] or "-", vs["core"] or "-", vs["es"] or "-",
                "%s %s" % (vk.get("api_version"), vk.get("device_name")) if "api_version" in vk else vk.get("error", "-")))
        w("")

    # ---- method
    w("## Method and caveats")
    w("")
    w("- A flag counts as present when any context lists one of its extension strings, as absent only when a context "
      "in which Mesa would list it (extensions_table.h: API column and minimum version) does not; otherwise it is "
      "`?`. The override probe (`MESA_GL_VERSION_OVERRIDE=4.6COMPAT MESA_GLES_VERSION_OVERRIDE=3.2`, set for that "
      "probe process only) exists to make every flag observable; it is a read of Mesa's internal state, never a "
      "capability claim, and nothing an application runs uses it.")
    w("- The vendor DDK is not Mesa: its GL/GLES versions come from its own version strings, and \"DDK says yes\" "
      "for a Vulkan item comes from the DDK's own Vulkan driver (pvr-run).")
    w("- Mesa's gates are Mesa %s's; zink's mapping of Vulkan to GL (GL_FLAG_NEEDS in the tool) cites the 26.1.8 "
      "source lines it was read from." % gates.get("mesa_version"))
    w("")
    if notes:
        w(notes.rstrip())
        w("")
    return "\n".join(L)


def report(args):
    here = os.path.dirname(SELF)
    gates_file = args.gates or next((p for p in (os.path.join(here, "a7a-gpu-gap-mesa-26.1.8-gates.json"),
                                                 "/usr/local/share/a7a-gpu-gap/a7a-gpu-gap-mesa-26.1.8-gates.json")
                                     if os.path.exists(p)), None)
    if not gates_file:
        print("no gates file (a7a-gpu-gap gates --mesa-src <mesa tree>)", file=sys.stderr)
        return 1
    gates = json.load(open(gates_file))
    o, v = json.load(open(args.open)), json.load(open(args.vendor))
    notes = open(args.notes).read() if args.notes else None
    try:
        md = render_report(o, v, gates, title=args.title, open_file=args.open, vendor_file=args.vendor, notes=notes,
                           gates_file=os.path.basename(gates_file), open_view=args.open_view,
                           vendor_view=args.vendor_view)
    except ValueError as e:
        print("a7a-gpu-gap report: %s" % e, file=sys.stderr)
        return 1
    if args.out:
        with open(args.out, "w") as f:
            f.write(md + "\n")
        print(args.out)
    else:
        print(md)
    return 0


def gates_cmd(args):
    import hashlib
    vc = os.path.join(args.mesa_src, "src/mesa/main/version.c")
    et = os.path.join(args.mesa_src, "src/mesa/main/extensions_table.h")
    vtext, etext = open(vc).read(), open(et).read()
    g = parse_version_gates(vtext)
    table = parse_ext_table(etext)
    used = gate_flags(g)
    missing = [f for f in used if f not in table]
    if missing:
        print("flags in the gates without an extensions_table.h row: %s" % ", ".join(missing), file=sys.stderr)
    ver = open(os.path.join(args.mesa_src, "VERSION")).read().strip() if os.path.exists(
        os.path.join(args.mesa_src, "VERSION")) else None
    out = {"mesa_version": ver, "version_c_sha256": hashlib.sha256(vtext.encode()).hexdigest(),
           "extensions_table_sha256": hashlib.sha256(etext.encode()).hexdigest(),
           "gates": g, "ext_table": {f: table[f] for f in used if f in table}}
    dst = args.out or "a7a-gpu-gap-mesa-%s-gates.json" % ver
    with open(dst, "w") as f:
        json.dump(out, f, indent=1, sort_keys=True)
        f.write("\n")
    print(dst)
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="a7a-gpu-gap", description=__doc__.split("\n\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter,
                                 epilog="modes: snapshot (on the board), report (anywhere), gates (from a Mesa tree)")
    sub = ap.add_subparsers(dest="mode", required=True)
    s = sub.add_parser("snapshot", help="record the booted stack's capabilities into a JSON file")
    s.add_argument("--out", help="output file (default a7a-gpu-caps-<stack>-<stamp>.json here)")
    s.add_argument("--views", help="comma list of views to record (default: all of this boot)")
    s.add_argument("--bench", action="store_true", help="glmark2-es2 + thermals (needs the logged-in desktop)")
    s.add_argument("--bench-full", action="store_true", help="also the whole glmark2 suite (~5 min per client)")
    s.add_argument("--reps", type=int, default=3)
    s.add_argument("--sizes", default=",".join(BENCH_SIZES))
    r = sub.add_parser("report", help="diff an open-stack and a vendor snapshot into a markdown report")
    r.add_argument("--open", required=True)
    r.add_argument("--vendor", required=True)
    r.add_argument("--gates", help="gates JSON (default: next to this script or /usr/local/share/a7a-gpu-gap)")
    r.add_argument("--notes", help="markdown appended verbatim (hand-written results)")
    r.add_argument("--title", default="GPU gap report")
    r.add_argument("--out")
    r.add_argument("--open-view", default="open", help="the view of --open to compare (default open)")
    r.add_argument("--vendor-view", default="ddk",
                   help="the view of --vendor to compare (default ddk; 'open' compares two open-stack snapshots)")
    gp = sub.add_parser("gates", help="extract the version gates + extension table rows from a Mesa source tree")
    gp.add_argument("--mesa-src", required=True)
    gp.add_argument("--out")
    sub.add_parser("probe", help=argparse.SUPPRESS)
    a = ap.parse_args(argv)
    return {"snapshot": snapshot, "report": report, "gates": gates_cmd, "probe": lambda _a: probe_main()}[a.mode](a)


if __name__ == "__main__":
    sys.exit(main())
