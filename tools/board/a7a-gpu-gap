def parse_need(alt):
    """one alternative of an APPS entry -> [(kind, arg)] terms that must all hold"""
    terms = []
    for t in alt.split("+"):
        kind, _, arg = t.strip().partition(":")
        rx = {"ver": r"^\d+\.\d+$", "id": r"^\w+$"}.get(_NEED_KINDS.get(kind))
        if not rx or not re.match(rx, arg):
            raise ValueError("bad need %r" % alt)
        terms.append((kind, arg))
    return terms


def app_meets(needs, versions, vk, flags=None, fixed=()):
    """True when any alternative of `needs` holds for a stack with these GL versions, this Vulkan view and these
    Mesa flags (glext terms; None = unknown = not met). `fixed`: Vulkan requirement strings to treat as met (the
    simulation of a fix)"""
    def ok(kind, arg):
        if kind in ("gl", "glcore", "es"):
            want = gl_version_number(arg)
            have = {"gl": max(versions.get("compat") or 0, versions.get("core") or 0),
                    "glcore": versions.get("core") or 0, "es": versions.get("es") or 0}[kind]
            return have >= want
        if kind == "vk":
            return bool(vk) and "api_version" in vk and _api_tuple(vk.get("api_version")) >= _api_tuple(arg)
        if kind == "vkfeat":
            return "feat:" + arg in fixed or req_eval("feat:" + arg, vk) is True
        if kind == "vkext":
            return "ext:" + arg in fixed or req_eval("ext:" + arg, vk) is True
        return bool(flags) and _val(flags.get(arg)) is True
    return any(all(ok(k, a) for k, a in parse_need(alt)) for alt in needs)


def gles_evidence(spec, versions, exts, ints=None):
    """does the vendor's GLES prove a feature: es:X.Y (its GLES version), glesext:NAME (in its extension list) or
    glesint:GL_MAX_...>=N (a glGetIntegerv limit of its ES context); "a|b" = either. None without a spec, and None
    when the data an alternative needs was not recorded (no ES version, no limits, the enum not probed) and no
    other alternative proves it: missing data is unknown, never absent"""
    if not spec:
        return None
    found, unknown = False, False
    for alt in spec.split("|"):
        kind, _, arg = alt.partition(":")
        if kind == "es":
            if versions.get("es") is None:
                unknown = True
            else:
                found = found or versions["es"] >= gl_version_number(arg)
        elif kind == "glesext":
            if exts is None:
                unknown = True
            else:
                found = found or arg in set(exts)
        elif kind == "glesint":
            m = re.match(r"^(GL_\w+)>=(\d+)$", arg)
            if not m:
                raise ValueError("bad GLES evidence %r" % spec)
            if ints is None or m.group(1) not in ints:
                unknown = True
            else:
                v = ints[m.group(1)]
                found = found or (bool(v) and v[0] >= int(m.group(2)))
        else:
            raise ValueError("bad GLES evidence %r" % spec)
    if found:
        return True
    return None if unknown else False


CLASS_COST = {"limit": 1, "project": 10, "unknown": 50, "unmapped": 100, "hardware": 1000}


def _const_term(t):
    m = re.match(r"^consts->(\S+) (>=|<=|==|!=|>|<) (\d+)$", t)
    return (m.group(1), int(m.group(3))) if m else None


def _versions_of(reached):
    return {"compat": gl_version_number(reached.get("gl_compat")), "core": gl_version_number(reached.get("gl_core")),
            "es": gl_version_number(reached.get("es"))}


def rank_actions(gates, flags, consts, ovk, vvk, vendor_versions, vendor_exts, vendor_ints=None, needs=None,
                 const_needs=None, apps=None, items=None):
    """the ranked, actionable list: Vulkan-level items grouped into milestones (version steps), each milestone the
    step with the most applications unlocked per unit of cost that is not reached yet, its new items cheapest
    first, every item with its vendor evidence, its class and the versions reached once it (and everything
    before it) is fixed"""
    needs = GL_FLAG_NEEDS if needs is None else needs
    const_needs = CONST_NEEDS if const_needs is None else const_needs
    apps = APPS if apps is None else apps
    flags0 = {k: _val(v) for k, v in flags.items()}
    consts0 = {k: _val(v) for k, v in consts.items()}
    base = evaluate_gates(gates, flags0, consts0)
    terms = {}
    for key in ("es", "gl_compat", "gl_core"):
        for row in base[key]:
            for t in row["fails"] + row["unknown"]:
                k = _flag_of(t) or t
                if k not in terms:
                    c = _const_term(t)
                    terms[k] = {"text": t, "const": c, "knowledge": const_needs.get(c[0]) if c else needs.get(k)}
    users = {}
    for k, t in terms.items():
        for r in (t["knowledge"] or {}).get("needs", []):
            users.setdefault(r, []).append(k)

    def satisfied(req, fixed):
        return req in fixed or req_eval(req, ovk) is True

    def simulate(fixed):
        f, c = dict(flags0), dict(consts0)
        for k, t in terms.items():
            if t["knowledge"] and all(satisfied(r, fixed) for r in t["knowledge"]["needs"]):
                if t["const"]:
                    c[t["const"][0]] = t["const"][1]
                else:
                    f[k] = True
        return evaluate_gates(gates, f, c), f

    def items_for(k, fixed):
        know = terms[k]["knowledge"]
        if not know:
            return ["unmapped:" + terms[k]["text"]]
        return [r for r in know["needs"] if not satisfied(r, fixed)]

    cls_cache = {}

    def classify(req):
        if req in cls_cache:
            return cls_cache[req]
        if req.startswith("unmapped:"):
            res = {"class": "unmapped", "vendor_vulkan": None, "vendor_gles": []}
        else:
            # the item's own declared class and its own GLES proof (second reviewer pass: not the GL flag's)
            vv = req_eval(req, vvk)
            table = VK_ITEMS if items is None else items
            item = table.get(req) or {"class": "limit" if {a.partition(":")[0] for a in req.split("|")} == {"limit"}
                                      else "project", "gles": None}
            spec = item.get("gles")
            g = gles_evidence(spec, vendor_versions, vendor_exts, vendor_ints)
            if vv is True or g:
                cls = item["class"]
            elif spec and g is None:
                cls = "unknown"               # the vendor's GLES data is missing: never call that absent
            elif g is False or vv is False:
                cls = "hardware"
            else:
                cls = "unknown"
            res = {"class": cls, "vendor_vulkan": vv, "vendor_gles": [spec] if g else []}
        cls_cache[req] = res
        return res

    def needed_for(key, step, fixed):
        out = []
        for r in base[key]:
            if gl_version_number(r["step"]) > gl_version_number(step):
                break
            if r["value"] is True:
                continue
            for t in r["fails"] + r["unknown"]:
                for it in items_for(_flag_of(t) or t, fixed):
                    if it not in out:
                        out.append(it)
        return out

    def gained_apps(sim, fixed, before):
        ev, f = sim
        vers = _versions_of(ev["reached"])
        return [a["name"] for a in apps if a["name"] not in before and app_meets(a["needs"], vers, ovk, f, fixed)]

    fixed = []
    met = {a["name"] for a in apps if app_meets(a["needs"], _versions_of(base["reached"]), ovk, flags0)}
    remaining = [(key, row["step"]) for key in ("es", "gl_compat") for row in base[key] if row["value"] is not True]
    milestones = []
    while remaining:
        best = None
        # only the lowest missing step of each API is a candidate: the list advances one version at a time and
        # never lumps several steps into one milestone because a later one unlocks an application
        cands = []
        for k2 in ("es", "gl_compat"):
            ks = [s2 for k3, s2 in remaining if k3 == k2]
            if ks:
                cands.append((k2, min(ks, key=gl_version_number)))
        for key, step in cands:
            need = needed_for(key, step, set(fixed))
            cost = sum(CLASS_COST[classify(r)["class"]] for r in need)
            gained = gained_apps(simulate(set(fixed) | set(need)), set(fixed) | set(need), met)
            score = (-len(gained) / max(cost, 1), cost, gl_version_number(step), key != "es")
            if best is None or score < best[0]:
                best = (score, key, step, need, gained)
        _, key, step, need, gained = best
        mitems = []                           # not "items": that is the item table classify() reads
        for r in sorted(need, key=lambda r: (CLASS_COST[classify(r)["class"]], r)):
            fixed.append(r)
            mitems.append(dict(classify(r), req=r, reached_after=simulate(set(fixed))[0]["reached"],
                               terms=users.get(r) or [r[len("unmapped:"):]]))
        now, _f = simulate(set(fixed))
        done = {k2: {x["step"]: x["value"] for x in now[k2]} for k2 in ("es", "gl_compat")}
        milestones.append({"step": _step_label(key, step), "key": key, "version": step, "items": mitems,
                           "reached": now["reached"], "unlocks": gained, "complete": done[key][step] is True})
        met |= set(gained)
        remaining = [(k2, s2) for k2, s2 in remaining if done[k2][s2] is not True and (k2, s2) != (key, step)]
    return {"milestones": milestones, "base_reached": base["reached"], "terms": terms}


