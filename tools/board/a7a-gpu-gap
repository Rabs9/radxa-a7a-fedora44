def probe_contexts(probe):
    if not probe:
        return []
    if "contexts" in probe:
        return probe["contexts"]
    out = []
    for label in ("normal", "override"):
        for c in (probe.get(label) or {}).get("contexts", []):
            out.append(dict(c, label=c.get("label", label)))
    return out


def consts_from_probe(probe, glx=None):
    """the gl_constants the gates compare, from the probe's glGetIntegerv (normal contexts first), else glxinfo -l"""
    ctxs = [c for c in probe_contexts(probe) if c.get("ok")]
    order = sorted(ctxs, key=lambda c: (c.get("label") != "normal", {"compat": 0, "es": 1, "core": 2}.get(c.get("api"), 3)))
    out = {}
    for name, (enum, how) in CONST_QUERY.items():
        val, ev = None, "not readable: %s rejected in every context probed" % enum
        for c in order:
            v = (c.get("ints") or {}).get(enum)
            if v:
                val = v[0]
                ev = "%s in the %s %s context (%s)" % (enum, c.get("label"), c.get("api"), c.get("version"))
                break
        if val is None and glx:
            for prof in ("compat", "core", "es"):
                lim = (glx.get("limits") or {}).get(prof) or {}
                for k in (enum, enum + "_ARB", enum + "_EXT"):
                    if k in lim and re.match(r"^\d+$", lim[k]):
                        val, ev = int(lim[k]), "%s from glxinfo -l (%s)" % (k, prof)
                        break
                if val is not None:
                    break
        if val is not None and how == "levels":
            val = int(math.log2(val)) + 1 if val > 0 else 0
        out[name] = {"value": val, "evidence": ev}
    # GLSL: a normal 2.1 context reports the clamped 1.20 (version.c _mesa_compute_version); the override context
    # skips that clamp and reports consts->GLSLVersion itself
    gv, gev = None, "no compat context probed"
    for c in sorted(ctxs, key=lambda c: c.get("label") != "override"):
        if c.get("api") == "compat" and c.get("sl_version"):
            gv = glsl_number(c["sl_version"])
            gev = "GL_SHADING_LANGUAGE_VERSION %s in the %s compat context%s" % (
                c["sl_version"], c.get("label"), "" if c.get("label") == "override" else " (clamped to the context version)")
            break
    out["GLSLVersion"] = {"value": gv, "evidence": gev}
    for name, (v, why) in CONST_SOURCE.items():
        out[name] = {"value": v, "evidence": why}
    return out


# ------------------------------------------------------------------------------------------------ Vulkan diff
_LOWER_BETTER = ("bufferImageGranularity", "nonCoherentAtomSize", "pointSizeGranularity", "lineWidthGranularity",
                 "optimalBufferCopyOffsetAlignment", "optimalBufferCopyRowPitchAlignment")
_HIGHER_BETTER = ("subPixelPrecisionBits", "subTexelPrecisionBits", "mipmapPrecisionBits", "viewportSubPixelBits",
                  "subPixelInterpolationOffsetBits", "discreteQueuePriorities", "sparseAddressSpaceSize")
_INFO_ONLY = ("timestampPeriod",)


def limit_cmp(name, o, v):
    """'worse' | 'better' | 'equal' | 'differs' for the open driver's value o against the vendor's v"""
    if o == v:
        return "equal"
    if o is None or v is None or name in _INFO_ONLY:
        return "differs"
    if isinstance(o, bool) or isinstance(v, bool):
        return "better" if o else "worse"
    if isinstance(o, list) and isinstance(v, list):
        if all(isinstance(x, str) for x in o + v):
            so, sv = set(o), set(v)
            return "worse" if so < sv else ("better" if sv < so else "differs")
        if len(o) == len(v) and all(isinstance(x, (int, float)) for x in o + v):
            if name.endswith("Range") and len(o) == 2:
                if o[0] >= v[0] and o[1] <= v[1]:
                    return "worse"
                if o[0] <= v[0] and o[1] >= v[1]:
                    return "better"
                return "differs"
            if all(a <= b for a, b in zip(o, v)):
                return "worse"
            if all(a >= b for a, b in zip(o, v)):
                return "better"
        return "differs"
    if not isinstance(o, (int, float)) or not isinstance(v, (int, float)):
        return "differs"
    if name in _LOWER_BETTER or name.startswith("min") or name.endswith("Granularity"):
        return "worse" if o > v else "better"
    if name.startswith("max") or name in _HIGHER_BETTER:
        return "worse" if o < v else "better"
    return "differs"


def _member_map(features):
    m = {}
    for key, val in features.items():
        struct, _, member = key.rpartition(".")
        e = m.setdefault(member, {"value": False, "structs": []})
        if val is True:
            e["value"] = True
            e["structs"].append(struct)
    return m


def diff_vulkan(o, v):
    """open view o against vendor view v"""
    om, vm = _member_map(o.get("features", {})), _member_map(v.get("features", {}))
    missing = [{"member": m, "structs": e["structs"], "open": om.get(m, {}).get("value", None)}
               for m, e in vm.items() if e["value"] and not om.get(m, {}).get("value")]
    extra = [{"member": m, "structs": e["structs"]} for m, e in om.items() if e["value"] and not vm.get(m, {}).get("value")]
    missing.sort(key=lambda x: (x["structs"][0], x["member"]))
    extra.sort(key=lambda x: (x["structs"][0], x["member"]))
    lw, lb, ld = [], [], []
    for name in sorted(set(o.get("limits", {})) | set(v.get("limits", {}))):
        ov, vv = o.get("limits", {}).get(name), v.get("limits", {}).get(name)
        c = limit_cmp(name, ov, vv)
        row = {"name": name, "open": ov, "vendor": vv}
        {"worse": lw, "better": lb, "differs": ld}.get(c, []).append(row)
    fo, fv = o.get("formats", {}), v.get("formats", {})
    fmissing, ffewer = [], []
    for fmt, feats in sorted(fv.items()):
        if not any(feats.values()):
            continue
        of = fo.get(fmt)
        if not of or not any(of.values()):
            fmissing.append(fmt)
            continue
        for tiling in ("optimal", "linear", "buffer"):
            lack = [f for f in feats.get(tiling, []) if f not in of.get(tiling, [])]
            if lack:
                ffewer.append({"format": fmt, "tiling": tiling, "missing": lack})
    return {"api": [o.get("api_version"), v.get("api_version")],
            "features_missing": missing, "features_extra": extra,
            "extensions_missing": sorted(set(v.get("extensions", {})) - set(o.get("extensions", {}))),
            "extensions_extra": sorted(set(o.get("extensions", {})) - set(v.get("extensions", {}))),
            "limits_worse": lw, "limits_better": lb, "limits_differ": ld,
            "formats_missing": fmissing, "formats_fewer": ffewer}


def _api_tuple(s):
    return tuple(int(x) for x in re.findall(r"\d+", s or "")[:2]) if s else (0, 0)


def _req_check(req):
    kind, _, arg = req.partition(":")
    if kind not in ("ext", "feat", "limit", "fmt", "api", "bit") or not arg:
        raise ValueError("bad requirement %r" % req)
    if kind == "limit" and not re.match(r"^\w+(>=|<=|==|>|<)-?[\d.]+$", arg):
        raise ValueError("bad limit requirement %r" % req)
    if kind == "fmt" and len(arg.split(":")) != 3:
        raise ValueError("bad format requirement %r" % req)
    if kind == "bit" and not re.match(r"^\w+:\w+$", arg):
        raise ValueError("bad bit requirement %r" % req)
    return kind, arg


def _vk_value(vk, name):
    """a limit or property by member name: VkPhysicalDeviceLimits, any properties struct, else the first graphics
    queue family (timestampValidBits lives there)"""
    if name in vk.get("limits", {}):
        return vk["limits"][name]
    for k, x in vk.get("properties", {}).items():
        if k.rpartition(".")[2] == name:
            return x
    for qf in vk.get("queue_families", []):
        p = qf.get("VkQueueFamilyProperties", qf)
        if "VK_QUEUE_GRAPHICS_BIT" in p.get("queueFlags", []):
            return p.get(name)
    return None


def req_eval(req, vk):
    """one requirement against a normalized Vulkan view: ext:NAME | feat:member | limit:NAME>=N | api:1.3 |
    fmt:VK_FORMAT_X:<optimal/linear/buffer>:VK_FORMAT_FEATURE_..._BIT | bit:member:FLAG_BIT (a flag list contains
    the flag); "a|b" = either. True/False, None without a view."""
    alts = [_req_check(a) for a in req.split("|")]
    if not vk or "extensions" not in vk:
        return None
    return any(_req_one(kind, arg, vk) for kind, arg in alts)


def _req_one(kind, arg, vk):
    if kind == "ext":
        return arg in vk["extensions"]
    if kind == "feat":
        return any(val is True for k, val in vk["features"].items() if k.rpartition(".")[2] == arg)
    if kind == "api":
        return _api_tuple(vk.get("api_version")) >= _api_tuple(arg)
    if kind == "fmt":
        fmt, tiling, flag = arg.split(":")
        return flag in vk.get("formats", {}).get(fmt, {}).get(tiling, [])
    if kind == "bit":
        member, flag = arg.split(":")
        val = _vk_value(vk, member)
        return isinstance(val, list) and flag in val
    m = re.match(r"^(\w+)(>=|<=|==|>|<)(-?[\d.]+)$", arg)
    name, op, num = m.group(1), m.group(2), float(m.group(3))
    val = _vk_value(vk, name)
    if isinstance(val, list) and val and all(isinstance(x, str) and x.startswith("VK_SAMPLE_COUNT_") for x in val):
        val = max(int(re.search(r"(\d+)", x).group(1)) for x in val)
    if not isinstance(val, (int, float)) or isinstance(val, bool):
        return False
    return {">=": val >= num, "<=": val <= num, "==": val == num, ">": val > num, "<": val < num}[op]


