def collect_gtk4(env, session, run=run_cmd):
    if not session:
        return {"error": "no desktop session (the GTK probe opens a window on the logged-in desktop)"}
    t = 40
    rc, out, err = run([sys.executable, "-c", GTK4_PROBE], env=dict(env, **session), timeout=t)
    for line in reversed(out.strip().splitlines()):
        if line.startswith("{"):
            try:
                return json.loads(line)
            except ValueError:
                break
    # run_cmd ends a timeout's stderr with the command line, i.e. this whole script: say what happened instead
    if rc == 124:
        return {"error": "rc=124: timed out after %d s" % t}
    if rc == 125:
        return {"error": "rc=125: did not exit after the kill (D state?)"}
    return {"error": "rc=%d: %s" % (rc, (err or out).strip()[-300:])}


def gtk_error_summary(err):
    """one line for the report from a gtk4 error: "rc=N: <stderr tail>" keeps the tail's last line (a traceback's
    exception), rc 124/125 say what happened (older snapshots kept the probe script as a timeout's tail), any other
    text ("<ExceptionType>: <message>" from snapshot, "no desktop session ...") keeps its first line"""
    lines = [ln.strip() for ln in str(err).splitlines() if ln.strip()]
    if not lines:
        return "no error text"
    rc = lines[0].split(":", 1)[0] if lines[0].startswith("rc=") else ""
    if rc == "rc=124":
        return "rc=124: timed out"
    if rc == "rc=125":
        return "rc=125: did not exit after the kill (D state?)"
    if rc and len(lines) > 1:
        return "%s: %s" % (rc, lines[-1])
    return lines[0]


