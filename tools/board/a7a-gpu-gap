def ddk_vulkan_only_env(tmpdir, libdir="/opt/pvr/lib", icd=DDK_ENV["VK_ICD_FILENAMES"], run=run_cmd,
                        sysdirs=("/usr/lib64", "/lib64")):
    """VK_ICD_FILENAMES + a library directory holding the DDK's Vulkan ICD and exactly the libraries it needs from
    `libdir`, linked under the names they are asked for: its link-time dependencies (ldd) and what it opens at
    run time (the dynamic loader's own trace, LD_DEBUG=libs, of a vulkaninfo on the DDK). So Fedora's zink drives
    the DDK's Vulkan driver while GL, EGL and the Vulkan loader stay Fedora's. A whitelist, and never a library
    Fedora ships itself: /opt/pvr/lib also holds libraries staged from the Debian card (tools/stage-extras.sh)
    that would shadow Fedora's inside Fedora's Mesa"""
    farm = os.path.join(tmpdir, "ddk-vulkan-libs")
    os.makedirs(farm, exist_ok=True)
    try:
        lib = json.load(open(icd))["ICD"]["library_path"]
    except (OSError, ValueError, KeyError, TypeError):
        lib = "libVK_IMG.so"
    src = lib if os.path.isabs(lib) else os.path.join(libdir, lib)
    links = {os.path.basename(lib): src}
    base = libdir.rstrip("/")

    def fedora_has(name):
        return any(os.path.exists(os.path.join(d, name)) for d in sysdirs)

    rc, out, _ = run(["ldd", src], env={"LD_LIBRARY_PATH": libdir}, timeout=30)
    for line in out.splitlines():
        m = re.match(r"^\s*(\S+) => (\S+)", line)
        if m and os.path.dirname(m.group(2)) == base and not fedora_has(m.group(1)):
            links[m.group(1)] = m.group(2)
    rc, out, err = run(["vulkaninfo", "--summary"],
                       env={"LD_DEBUG": "libs", "VK_ICD_FILENAMES": icd, "LD_LIBRARY_PATH": libdir}, timeout=60)
    for m in re.finditer(r"file=(\S+) \[0\];\s+(?:needed|dynamically loaded) by", (err or "") + (out or "")):
        name = os.path.basename(m.group(1))
        if os.path.exists(os.path.join(base, name)) and not fedora_has(name):
            links.setdefault(name, os.path.join(base, name))
    for name, target in links.items():
        dst = os.path.join(farm, name)
        if not os.path.lexists(dst):
            os.symlink(target, dst)
    return {"VK_ICD_FILENAMES": icd, "LD_LIBRARY_PATH": farm, "MESA_LOADER_DRIVER_OVERRIDE": "zink"}


class ThermalSampler(threading.Thread):
    def __init__(self, read=read_file, period=2.0):
        super().__init__(daemon=True)
        self.read, self.period, self.samples, self.stop = read, period, [], threading.Event()

    def sample(self):
        t = {}
        for z in listdir("/sys/class/thermal"):
            if z.startswith("thermal_zone"):
                ty, v = self.read("/sys/class/thermal/%s/type" % z), self.read("/sys/class/thermal/%s/temp" % z)
                if ty and v and v.strip().lstrip("-").isdigit():
                    t[ty.strip()] = int(v) / 1000
        f = {}
        for cpu in ("cpu0", "cpu6"):
            v = self.read("/sys/devices/system/cpu/%s/cpufreq/scaling_cur_freq" % cpu)
            if v and v.strip().isdigit():
                f[cpu] = int(v) // 1000
        return {"t": round(time.time(), 1), "temps": t, "mhz": f}

    def run(self):
        while not self.stop.is_set():
            self.samples.append(self.sample())
            self.stop.wait(self.period)

    def summary(self):
        mx, mn = {}, {}
        for s in self.samples:
            for k, v in s["temps"].items():
                mx[k] = max(mx.get(k, v), v)
            for k, v in s["mhz"].items():
                mn[k] = min(mn.get(k, v), v)
        return {"samples": len(self.samples), "max_temp_c": mx, "min_cpu_mhz": mn}


def _throttle_lines(run):
    rc, out, _ = run(["sudo", "-n", "dmesg"])
    return sum(1 for l in out.splitlines() if re.search(r"thermal|throttl|cpufreq.*limit", l, re.I))


def collect_bench(stack, view_env, session, run=run_cmd, sizes=BENCH_SIZES, reps=3, full=False, on_progress=None):
    """glmark2-es2 at the same sizes on both stacks (build + texture, median of reps after a discarded warm-up),
    plus the whole suite off-screen and windowed when full=True; thermal samples all the way through.
    on_progress(res) after every client/size and every full run (snapshot writes the file each time)"""
    progress = on_progress or (lambda _res: None)
    clients = ([("wayland", ["glmark2-es2-wayland"]), ("x11", ["glmark2-es2"]), ("offscreen", ["glmark2-es2", "--off-screen"])]
               if stack == "open" else [("x11", ["glmark2-es2"]), ("offscreen", ["glmark2-es2", "--off-screen"])])
    env = dict(view_env, **(session or {}))
    th = ThermalSampler()
    t0 = _throttle_lines(run)
    th.start()
    res = {"stack": stack, "sizes": list(sizes), "reps": reps, "clients": {}, "full": {}}
    try:
        for cname, cmd in clients:
            for size in sizes:
                run(cmd + ["-s", size, "-b", "build:duration=2"], env=env, timeout=120)       # warm-up, discarded
                runs = []
                for _ in range(reps):
                    rc, out, err = run(cmd + ["-s", size, "-b", "build:duration=3", "-b", "texture:duration=3"],
                                       env=env, timeout=180)
                    r = parse_glmark2(out)
                    r["rc"] = rc
                    if rc != 0 and not r["scenes"]:
                        r["errors"].append((err or out).strip()[-300:])
                    runs.append(r)
                med = {sc: median([next((x[2] for x in r["scenes"] if x[0] == sc), None) for r in runs])
                       for sc in ("build", "texture")}
                res["clients"].setdefault(cname, {})[size] = {"median_fps": med, "runs": runs,
                                                              "renderer": runs[0]["renderer"] if runs else None}
                progress(res)
        if full:
            native = "wayland" if stack == "open" else "x11"
            for cname, cmd in clients:
                if cname not in (native, "offscreen"):
                    continue
                rc, out, err = run(cmd + ["-s", sizes[0]], env=env, timeout=900)
                r = parse_glmark2(out)
                r["rc"] = rc
                res["full"][cname] = r
                progress(res)
    finally:
        th.stop.set()
        th.join(5)
    res["thermal"] = th.summary()
    res["thermal"]["throttle_lines_during"] = _throttle_lines(run) - t0
    return res


def snapshot(args):
    sysinfo = collect_system()
    session = session_env()
    snap = {"schema": 1, "tool": "a7a-gpu-gap", "tool_version": TOOL_VERSION,
            "taken": datetime.now().isoformat(timespec="seconds"), "host": os.uname().nodename,
            "stack": sysinfo["stack"], "system": sysinfo, "session": bool(session), "views": {}}
    out = args.out or "a7a-gpu-caps-%s-%s.json" % (sysinfo["stack"], datetime.now().strftime("%Y%m%d-%H%M"))
    tmp = tempfile.mkdtemp(prefix="a7a-gpu-gap-")
    if sysinfo["stack"] == "open":
        views = [("open", lambda: {}, True)]
    elif sysinfo["stack"] == "ddk":
        views = [("ddk", lambda: dict(DDK_ENV), False), ("fedora-mesa", lambda: {}, True),
                 ("zink-on-ddk", lambda: ddk_vulkan_only_env(tmp), True)]
    else:
        views = [("fedora-mesa", lambda: {}, True)]
    # the vendor stack is a reboot away: one failing view or bench must not cost the rest, and the file is
    # rewritten after every stage
    for name, mkenv, ovr in views:
        if args.views and name not in args.views.split(","):
            continue
        env = {}
        try:
            env = mkenv()
            print("== view %s %s" % (name, " ".join("%s=%s" % kv for kv in env.items())), file=sys.stderr)
            d = os.path.join(tmp, name)
            os.makedirs(d, exist_ok=True)
            v = collect_view(name, env, session=session, tmp=d, override_probe=ovr,
                             expect_renderer=EXPECT_RENDERER.get(name))
            if name == "zink-on-ddk":
                v["farm"] = sorted(listdir(env.get("LD_LIBRARY_PATH", "")))
        except Exception as e:
            v = {"view": name, "error": "%s: %s" % (type(e).__name__, e)}
        # the GTK probe on its own: its failure must not replace the view
        try:
            v["gtk4"] = collect_gtk4(env, session)
        except Exception as e:
            v["gtk4"] = {"error": "%s: %s" % (type(e).__name__, e)}
        snap["views"][name] = v
        _write_json(snap, out)
    if args.bench:
        def progress(res):
            snap["bench"] = res
            _write_json(snap, out)

        try:
            if not session:
                snap["bench"] = {"error": "no logged-in desktop session: --bench needs one"}
            else:
                benv = DDK_ENV if sysinfo["stack"] == "ddk" else {}
                print("== bench (%s)" % ("build+texture x%d%s" % (args.reps, ", full suite" if args.bench_full else "")),
                      file=sys.stderr)
                snap["bench"] = collect_bench(sysinfo["stack"], benv, session, reps=args.reps, full=args.bench_full,
                                              sizes=tuple(args.sizes.split(",")), on_progress=progress)
        except Exception as e:
            snap["bench"] = dict(snap.get("bench") or {}, error="%s: %s" % (type(e).__name__, e))
    try:
        snap["system_after"] = {"temps_c": collect_system()["temps_c"]}
    except Exception as e:
        snap["system_after"] = {"error": "%s: %s" % (type(e).__name__, e)}
    _write_json(snap, out)
    print(out)
    return 0


def _write_json(obj, path):
    part = path + ".part"
    with open(part, "w") as f:
        json.dump(obj, f, indent=1, sort_keys=True)
        f.write("\n")
    os.replace(part, path)


