def session_env(run=run_cmd, read=read_file, listdir=listdir):
    """the environment of the logged-in desktop, from the session KWin's own command line (--socket,
    --xwayland-display, --xwayland-xauthority: /proc/<pid>/cmdline is readable even with KWin's capabilities);
    None when only the greeter runs. Never guesses between several xauth files: a stale one from an earlier
    login would lose every X11 client"""
    rc, out, _ = run(["pgrep", "-x", "kwin_wayland"])
    for pid in out.split():
        st = read("/proc/%s/status" % pid) or ""
        m = re.search(r"^Uid:\s+(\d+)", st, re.M)
        if not m or int(m.group(1)) < 1000:
            continue
        rt = "/run/user/%s" % m.group(1)
        argv = (read("/proc/%s/cmdline" % pid) or "").split("\0")
        arg = {a: argv[i + 1] for i, a in enumerate(argv[:-1])
               if a in ("--socket", "--xwayland-display", "--xwayland-xauthority")}
        env = {"XDG_RUNTIME_DIR": rt, "WAYLAND_DISPLAY": arg.get("--socket", "wayland-0"),
               "DISPLAY": arg.get("--xwayland-display", ":0")}
        xa = [f for f in listdir(rt) if f.startswith("xauth_")]
        if "--xwayland-xauthority" in arg:
            env["XAUTHORITY"] = arg["--xwayland-xauthority"]
        elif len(xa) == 1:
            env["XAUTHORITY"] = "%s/%s" % (rt, xa[0])
        return env
    return None


def _vulkan_gpu_index(summary):
    gpus, cur = [], None
    for line in summary.splitlines():
        m = re.match(r"^GPU(\d+):", line.strip())
        if m:
            cur = {"index": int(m.group(1))}
            gpus.append(cur)
        elif cur is not None and "deviceType" in line:
            cur["type"] = line.split("=")[-1].strip()
    for g in gpus:
        if "CPU" not in g.get("type", ""):
            return g["index"]
    return gpus[0]["index"] if gpus else 0


def _tail(s, n=800):
    return (s or "").strip()[-n:]


def collect_view(name, env, run=run_cmd, session=None, tmp=None, override_probe=True, expect_renderer=None):
    """capabilities of one view: vulkaninfo, eglinfo, glxinfo -l, the EGL probe (and its override pass), plus the
    stderr tail of each. expect_renderer: a string the view's GL renderer must contain (zink for zink-on-ddk);
    when no renderer does, the view is marked as a fallback (Mesa falls back to llvmpipe silently, exit 0) and
    the report ignores its numbers"""
    v = {"view": name, "env": dict(env), "stderr": {}}
    senv = dict(session or {})
    tmpdir = tmp or tempfile.mkdtemp(prefix="a7a-gpu-gap-")
    rc, out, err = run(["vulkaninfo", "--summary"], env=env, timeout=60)
    idx = _vulkan_gpu_index(out)
    v["vulkan_gpu"] = idx
    for f in os.listdir(tmpdir):
        if f.startswith("VP_VULKANINFO"):
            os.unlink(os.path.join(tmpdir, f))
    rc, out, err = run(["vulkaninfo", "--json=%d" % idx], env=env, cwd=tmpdir, timeout=120)
    files = sorted(f for f in os.listdir(tmpdir) if f.startswith("VP_VULKANINFO") and f.endswith(".json"))
    if files:
        v["vulkan_file"] = files[0]
        try:
            with open(os.path.join(tmpdir, files[0])) as f:
                v["vulkan"] = normalize_vulkan(json.load(f))
        except (ValueError, KeyError, TypeError, AttributeError) as e:
            v["vulkan"] = {"error": "unreadable %s: %s: %s" % (files[0], type(e).__name__, e)}
    else:
        v["vulkan"] = {"error": "vulkaninfo --json=%d rc=%d: %s" % (idx, rc, (err or out).strip()[-400:])}
    v["stderr"]["vulkaninfo"] = _tail(err)
    rc, out, err = run(["eglinfo"], env=dict(env, **senv), timeout=120)
    v["eglinfo"] = parse_eglinfo(out)
    v["eglinfo"]["rc"] = rc
    v["stderr"]["eglinfo"] = _tail(err)
    if session and session.get("DISPLAY"):
        rc, out, err = run(["glxinfo", "-l"], env=dict(env, **senv), timeout=60)
        v["glxinfo"] = parse_glxinfo(out) if rc == 0 else {"error": "glxinfo rc=%d: %s" % (rc, err.strip()[-300:])}
        v["stderr"]["glxinfo"] = _tail(err)
    else:
        v["glxinfo"] = {"error": "no X session (glxinfo needs the DISPLAY/XAUTHORITY of a logged-in desktop)"}
    v["probe"] = {}
    passes = [("normal", {})] + ([("override", OVERRIDE_ENV)] if override_probe else [])
    for label, extra in passes:
        rc, out, err = run([sys.executable, SELF, "probe"], env=dict(env, **extra), timeout=120)
        p = parse_probe_output(out, rc, err)
        v["stderr"]["probe_" + label] = _tail(err)
        for c in p.get("contexts", []):
            c["label"] = label
        if label == "override":
            p["note"] = ("diagnostic: %s set for this probe only, so that Mesa lists every extension flag it computed "
                         "and every limit enum is legal; not what applications see" % " ".join(
                             "%s=%s" % kv for kv in extra.items()))
        v["probe"][label] = p
    rends = {c.get("renderer") for c in v["probe"].get("normal", {}).get("contexts", []) if c.get("ok")}
    rends |= {prof.get("renderer") for pl in v["eglinfo"].get("platforms", []) for prof in (pl.get("gl") or {}).values()}
    v["renderers"] = sorted(r for r in rends if r)
    v["expect_renderer"] = expect_renderer
    if expect_renderer and not any(re.search(expect_renderer, r) for r in v["renderers"]):
        v["fallback"] = "no renderer matching /%s/; got: %s" % (expect_renderer, "; ".join(v["renderers"]) or "none")
    return v


