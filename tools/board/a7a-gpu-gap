# ------------------------------------------------------------------------------------------------ small helpers
def run_cmd(cmd, env=None, cwd=None, timeout=60):
    """run a command with a scrubbed environment plus `env`; returns (rc, stdout, stderr); never raises and never
    waits for ever: after the timeout the child is killed and given 10 s to go (a GPU client stuck in D state
    inside the kernel driver cannot be reaped; it is then left behind and reported, rc 125)"""
    e = {k: v for k, v in os.environ.items() if k not in SCRUB}
    e.update(env or {})
    try:
        p = subprocess.Popen(cmd, env=e, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                             errors="replace")
    except FileNotFoundError:
        return 127, "", "not found: %s" % cmd[0]
    except OSError as ex:
        return 126, "", "%s: %s" % (type(ex).__name__, ex)
    try:
        out, err = p.communicate(timeout=timeout)
        return p.returncode, out, err
    except subprocess.TimeoutExpired:
        p.kill()
        try:
            out, err = p.communicate(timeout=10)
        except subprocess.TimeoutExpired:
            return 125, "", "unkillable after the %ss timeout (D state?): %s" % (timeout, " ".join(cmd))
        return 124, out, (err or "") + "\ntimeout after %ss: %s" % (timeout, " ".join(cmd))


def read_file(path):
    """text of a file, '->name' for a symlink (its target's basename), None when unreadable"""
    try:
        if os.path.islink(path):
            return "->" + os.path.basename(os.readlink(path))
        with open(path, errors="replace") as f:
            return f.read()
    except OSError:
        return None


def listdir(path):
    try:
        return sorted(os.listdir(path))
    except OSError:
        return []


def read_be32(path):
    """big-endian u32 cells of a device-tree property"""
    try:
        b = open(path, "rb").read()
    except OSError:
        return None
    return [int.from_bytes(b[i:i + 4], "big") for i in range(0, len(b) - len(b) % 4, 4)]


def gl_version_number(s):
    """'2.1 Mesa 26.1.8' -> 21, 'OpenGL ES 3.2 build ...' -> 32, 'OpenGL ES GLSL ES 3.20' -> 32"""
    if not s:
        return None
    m = re.search(r"(\d+)\.(\d)", s)
    return int(m.group(1)) * 10 + int(m.group(2)) if m else None


def glsl_number(s):
    """'4.60' -> 460, '1.20' -> 120 (the value Mesa's consts->GLSLVersion holds)"""
    m = re.search(r"(\d+)\.(\d+)", s or "")
    return int(m.group(1)) * 100 + int(m.group(2)[:2].ljust(2, "0")) if m else None


def actual_api(requested, version, profile_mask):
    """the profile a context really got: MESA_GL_VERSION_OVERRIDE=4.6COMPAT answers a core request with a
    compatibility context. profile_mask = GL_CONTEXT_PROFILE_MASK (None below GL 3.2)"""
    if requested == "es":
        return "es"
    if profile_mask:
        return "core" if profile_mask & 1 else "compat"
    if "(Core Profile)" in (version or ""):
        return "core"
    if "(Compatibility Profile)" in (version or ""):
        return "compat"
    return requested


def median(xs):
    xs = sorted(x for x in xs if x is not None)
    if not xs:
        return None
    n = len(xs)
    return xs[n // 2] if n % 2 else (xs[n // 2 - 1] + xs[n // 2]) / 2


# ------------------------------------------------------------------------------------------------ parsers
_PROFILE = re.compile(r"^OpenGL (core|compatibility|ES) profile (vendor|renderer|version|shading language version|extensions):\s*(.*)$")
_PROFILE_KEY = {"core": "core", "compatibility": "compat", "ES": "es"}
_FIELD = {"vendor": "vendor", "renderer": "renderer", "version": "version",
          "shading language version": "sl_version", "extensions": "extensions"}
_EGL_FIELD = {"EGL API version": "api_version", "EGL vendor string": "vendor", "EGL version string": "version",
              "EGL client APIs": "client_apis", "EGL driver name": "driver"}


def _list_items(line):
    return [x.strip() for x in line.split(",") if x.strip()]


def parse_eglinfo(text):
    """eglinfo (mesa-demos 9) output -> {"client_extensions": [...], "platforms": [{name, error, egl, gl, ...}]}"""
    res = {"client_extensions": [], "platforms": []}
    cur, device, dev_ext, target = None, None, [], None
    for line in text.splitlines():
        if target is not None and line.startswith("    ") and line.strip():
            target.extend(_list_items(line))
            continue
        target = None
        if not line.strip():
            continue
        if line == "EGL client extensions string:":
            target = res["client_extensions"]
            continue
        m = re.match(r"^Device #(\d+):$", line)
        if m:
            device, dev_ext, cur = int(m.group(1)), [], None
            continue
        if line == "EGL device extensions string:":
            target = dev_ext
            continue
        m = re.match(r"^(\S.*) platform:$", line)
        if m:
            name = m.group(1)
            if name == "Device":             # container; the per-device sections follow as "Platform Device platform:"
                cur = None
                continue
            if name == "Platform Device":
                name = "Device #%s" % device
            cur = {"name": name, "error": None, "egl": {}, "gl": {}}
            if name.startswith("Device #"):
                cur["device_extensions"] = dev_ext
            res["platforms"].append(cur)
            continue
        if cur is None:
            continue
        if line.startswith("eglinfo:"):
            cur["error"] = ((cur["error"] + "; ") if cur["error"] else "") + line[len("eglinfo:"):].strip()
            continue
        if line.startswith("EGL extensions string:"):
            cur["egl"]["extensions"] = []
            target = cur["egl"]["extensions"]
            continue
        k, _, v = line.partition(":")
        if k in _EGL_FIELD:
            cur["egl"][_EGL_FIELD[k]] = v.strip()
            continue
        m = _PROFILE.match(line)
        if m:
            prof = cur["gl"].setdefault(_PROFILE_KEY[m.group(1)], {})
            f = _FIELD[m.group(2)]
            if f == "extensions":
                prof["extensions"] = _list_items(m.group(3))
                target = prof["extensions"]
            else:
                prof[f] = m.group(3).strip()
    return res


def parse_glxinfo(text):
    """glxinfo -l output -> {max_versions, compat, core, es, limits: {compat|core|es: {GL_...: "value"}}}"""
    res = {"max_versions": {}, "compat": None, "core": None, "es": None, "limits": {}}
    target, limits = None, None
    mv = {"Max core profile version": "core", "Max compat profile version": "compat",
          "Max GLES1 profile version": "gles1", "Max GLES[23] profile version": "gles"}
    strings = [(re.compile(r"^OpenGL core profile (vendor|renderer|version|shading language version) string: (.*)$"), "core"),
               (re.compile(r"^OpenGL ES profile (vendor|renderer|version|shading language version) string: (.*)$"), "es"),
               (re.compile(r"^OpenGL (vendor|renderer|version|shading language version) string: (.*)$"), "compat")]
    for line in text.splitlines():
        if target is not None and line.startswith("    ") and line.strip():
            target.extend(_list_items(line))
            continue
        target = None
        if limits is not None:
            m = re.match(r"^\s+(GL_\w+) = (.*)$", line)
            if m:
                limits[m.group(1)] = m.group(2).strip()
                continue
            if re.match(r"^\s+\S.*:$", line):     # "  GL_ARB_framebuffer_object:" group header
                continue
            limits = None
        s = line.strip()
        k, _, v = s.partition(":")
        if k in mv:
            res["max_versions"][mv[k]] = v.strip()
            continue
        for rx, prof in strings:
            m = rx.match(line)
            if m:
                res[prof] = res[prof] or {}
                res[prof][_FIELD[m.group(1)]] = m.group(2).strip()
                break
        else:
            m = re.match(r"^OpenGL (?:(core|ES) profile )?extensions:$", line)
            if m:
                prof = {"core": "core", "ES": "es"}.get(m.group(1), "compat")
                res[prof] = res[prof] or {}
                res[prof]["extensions"] = []
                target = res[prof]["extensions"]
                continue
            m = re.match(r"^OpenGL (?:(core|ES) profile )?limits:$", line)
            if m:
                limits = res["limits"].setdefault({"core": "core", "ES": "es"}.get(m.group(1), "compat"), {})
    return res


def api_version_str(v):
    return "%d.%d.%d" % ((v >> 22) & 0x7F, (v >> 12) & 0x3FF, v & 0xFFF)


def normalize_vulkan(vp):
    """a `vulkaninfo --json` profile -> a flat view: features "Struct.member", limits, extensions, formats"""
    dev = vp["capabilities"]["device"]
    props = dev.get("properties", {})
    core = props.get("VkPhysicalDeviceProperties", {})
    v = {"device_name": core.get("deviceName"), "device_type": core.get("deviceType"),
         "vendor_id": core.get("vendorID"), "device_id": core.get("deviceID"),
         "driver_version": core.get("driverVersion"), "extensions": dict(dev.get("extensions", {})),
         "features": {}, "limits": dict(core.get("limits", {})), "properties": {}, "formats": {},
         "queue_families": dev.get("queueFamiliesProperties", [])}
    if "apiVersion" in core:
        v["api_version"] = api_version_str(core["apiVersion"])
    else:
        v["api_version"] = next(iter(vp.get("profiles", {}).values()), {}).get("api-version")
    for struct, members in dev.get("features", {}).items():
        for m, val in members.items():
            v["features"]["%s.%s" % (struct, m)] = val
    for struct, members in props.items():
        for m, val in members.items():
            if struct == "VkPhysicalDeviceProperties" and m in ("limits",):
                continue
            v["properties"]["%s.%s" % (struct, m)] = val
    for k in ("driverName", "driverInfo"):
        for key, val in v["properties"].items():
            if key.endswith("." + k):
                v["driver_name" if k == "driverName" else "driver_info"] = val
                break
    for fmt, entry in dev.get("formats", {}).items():
        fp = entry.get("VkFormatProperties") or entry.get("VkFormatProperties3") or {}
        v["formats"][fmt] = {"linear": list(fp.get("linearTilingFeatures", [])),
                             "optimal": list(fp.get("optimalTilingFeatures", [])),
                             "buffer": list(fp.get("bufferFeatures", []))}
    return v


def parse_glmark2(text):
    r = {"renderer": None, "version": None, "vendor": None, "surface": None, "scenes": [], "score": None, "errors": []}
    for line in text.splitlines():
        s = line.strip()
        for k, f in (("GL_RENDERER:", "renderer"), ("GL_VERSION:", "version"), ("GL_VENDOR:", "vendor"),
                     ("Surface Size:", "surface")):
            if s.startswith(k):
                r[f] = s[len(k):].strip()
        m = re.match(r"^\[([\w-]+)\] (.*?): FPS: (\d+)", s)
        if m:
            r["scenes"].append([m.group(1), m.group(2), int(m.group(3))])
        m = re.search(r"glmark2 Score: (\d+)", s)
        if m:
            r["score"] = int(m.group(1))
        if s.startswith("Error:") or "failed" in s.lower() and "Error" in s:
            r["errors"].append(s)
    return r


# ------------------------------------------------------------------------------------------------ Mesa gates
def _strip_c_comments(t):
    t = re.sub(r"/\*.*?\*/", " ", t, flags=re.S)
    return re.sub(r"//[^\n]*", " ", t)


def _function_body(text, name):
    m = re.search(r"\n%s\s*\(" % re.escape(name), text)
    if not m:
        raise ValueError("function %s not found" % name)
    start = text.index("{", m.end())
    end = re.search(r"\n}\n", text[start:])
    return text[start:start + end.start()] if end else text[start:]


def parse_version_gates(text):
    """version.c -> {"gl": [{step, var, expr}], "es": [...], "gl_defs": {}, "es_defs": {name: expr}}"""
    t = _strip_c_comments(text)
    res = {}
    for key, fn in (("gl", "compute_version"), ("es", "compute_version_es2")):
        body = _function_body(t, fn)
        steps, defs = [], {}
        for m in re.finditer(r"const\s+bool\s+(\w+)\s*=\s*(.*?);", body, flags=re.S):
            var, expr = m.group(1), " ".join(m.group(2).split())
            vm = re.match(r"^ver_(\d+)_(\d+)$", var)
            if vm:
                steps.append({"step": "%s.%s" % (vm.group(1), vm.group(2)), "var": var, "expr": expr})
            else:
                defs[var] = expr
        res[key], res[key + "_defs"] = steps, defs
    return res


_EXT_ROW = re.compile(r"^EXT\(\s*(\w+)\s*,\s*(\w+)\s*,\s*(\w+)\s*,\s*(\w+)\s*,\s*(\w+)\s*,\s*(\w+)\s*,\s*(\d+)\s*\)", re.M)


def parse_ext_table(text):
    """extensions_table.h -> {driver flag: [{name: "GL_...", gll, glc, es1, es2}]} (min version*10, None = never)"""
    def ver(tok):
        if tok in ("GLL", "GLC", "ES1", "ES2"):
            return 0
        if tok == "x":
            return None
        return int(tok)
    t = {}
    for m in _EXT_ROW.finditer(text):
        t.setdefault(m.group(2), []).append({"name": "GL_" + m.group(1), "gll": ver(m.group(3)), "glc": ver(m.group(4)),
                                             "es1": ver(m.group(5)), "es2": ver(m.group(6))})
    return t


_TOKEN = re.compile(r"\s*(extensions->\w+|consts->[\w\[\]\.]+|&&|\|\||>=|<=|==|!=|>|<|!|\(|\)|\w+|\S)")


def _tokens(expr):
    out, pos = [], 0
    while pos < len(expr):
        m = _TOKEN.match(expr, pos)
        if not m or not m.group(1).strip():
            break
        out.append(m.group(1))
        pos = m.end()
    return out


def parse_expr(expr):
    """C boolean expression of version.c -> AST: ("and"|"or", [nodes]) | ("not", n) | ("flag", name) |
    ("const", name, op, value) | ("api", "core") | ("ref", var)"""
    toks = _tokens(expr)
    pos = [0]

    def peek():
        return toks[pos[0]] if pos[0] < len(toks) else None

    def take(t=None):
        tok = peek()
        if t is not None and tok != t:
            raise ValueError("expected %r got %r in %r" % (t, tok, expr))
        pos[0] += 1
        return tok

    def orx():
        n = [andx()]
        while peek() == "||":
            take()
            n.append(andx())
        return n[0] if len(n) == 1 else ("or", n)

    def andx():
        n = [unary()]
        while peek() == "&&":
            take()
            n.append(unary())
        return n[0] if len(n) == 1 else ("and", n)

    def unary():
        if peek() == "!":
            take()
            return ("not", unary())
        if peek() == "(":
            take("(")
            n = orx()
            take(")")
            return n
        return atom()

    def atom():
        a = take()
        if a is None:
            raise ValueError("unexpected end of %r" % expr)
        if a.startswith("extensions->"):
            return ("flag", a[len("extensions->"):])
        if a.startswith("consts->"):
            name = a[len("consts->"):]
            if peek() in (">=", "<=", "==", "!=", ">", "<"):
                op = take()
                return ("const", name, op, int(take()))
            return ("const", name, "truthy", None)
        if a == "api":
            take("==")
            b = take()
            if b != "API_OPENGL_CORE":
                raise ValueError("unsupported api comparison %r" % b)
            return ("api", "core")
        if re.match(r"^\w+$", a):
            return ("ref", a)
        raise ValueError("unexpected token %r in %r" % (a, expr))

    node = orx()
    if peek() is not None:
        raise ValueError("trailing tokens %r in %r" % (toks[pos[0]:], expr))
    return node


def node_text(n):
    k = n[0]
    if k == "flag":
        return "extensions->" + n[1]
    if k == "const":
        return "consts->%s" % n[1] if n[2] == "truthy" else "consts->%s %s %d" % (n[1], n[2], n[3])
    if k == "api":
        return "api == API_OPENGL_CORE"
    if k == "ref":
        return n[1]
    if k == "not":
        return "!" + node_text(n[1])
    return "(" + (" && " if k == "and" else " || ").join(node_text(c) for c in n[1]) + ")"


def _k_and(vals):
    return False if False in vals else (None if None in vals else True)


def _k_or(vals):
    return True if True in vals else (None if None in vals else False)


def _val(x):
    return x.get("value") if isinstance(x, dict) else x


def gate_flags(gates):
    out = set()
    for key in ("gl", "es"):
        exprs = [s["expr"] for s in gates[key]] + list(gates.get(key + "_defs", {}).values())
        for e in exprs:
            out.update(re.findall(r"extensions->(\w+)", e))
    return sorted(out)


def gate_consts(gates):
    out = set()
    for key in ("gl", "es"):
        exprs = [s["expr"] for s in gates[key]] + list(gates.get(key + "_defs", {}).values())
        for e in exprs:
            out.update(re.findall(r"consts->([\w\[\]\.]+)", e))
    return sorted(out)


def evaluate_gates(gates, flags, consts):
    """three-valued evaluation of every version step for GL compat, GL core and GLES2+.
    flags {name: bool|None|{"value":..}}, consts {name: number|bool|None|{"value":..}}"""
    flags = {k: _val(v) for k, v in flags.items()}
    consts = {k: _val(v) for k, v in consts.items()}
    out, reached = {}, {}
    for key, api in (("gl_compat", "compat"), ("gl_core", "core"), ("es", "es")):
        steps = gates["gl" if key.startswith("gl") else "es"]
        defs = gates["gl_defs" if key.startswith("gl") else "es_defs"]
        var2step = {s["var"]: s["step"] for s in steps}
        values = {}

        def ev(n):
            k = n[0]
            if k == "flag":
                return flags.get(n[1])
            if k == "const":
                v = consts.get(n[1])
                if v is None:
                    return None
                if n[2] == "truthy":
                    return bool(v)
                return {">=": v >= n[3], "<=": v <= n[3], "==": v == n[3], "!=": v != n[3],
                        ">": v > n[3], "<": v < n[3]}[n[2]]
            if k == "api":
                return api == "core"
            if k == "ref":
                if n[1] in values:
                    return values[n[1]]
                if n[1] in defs:
                    return ev(parse_expr(defs[n[1]]))
                return None
            if k == "not":
                v = ev(n[1])
                return None if v is None else not v
            vals = [ev(c) for c in n[1]]
            return _k_and(vals) if k == "and" else _k_or(vals)

        rows = []
        for s in steps:
            node = parse_expr(s["expr"])
            items = list(node[1]) if node[0] == "and" else [node]
            # a reference to a helper definition (es31_compute_shader) is its own list of terms
            flat = []
            for it in items:
                if it[0] == "ref" and it[1] in defs:
                    d = parse_expr(defs[it[1]])
                    flat.extend(d[1] if d[0] == "and" else [d])
                else:
                    flat.append(it)
            fails, unknown, blocked = [], [], None
            for it in flat:
                v = ev(it)
                if it[0] == "ref" and it[1] in var2step:
                    if v is not True:
                        blocked = var2step[it[1]]
                    continue
                if v is False:
                    fails.append(node_text(it))
                elif v is None:
                    unknown.append(node_text(it))
            value = ev(node)
            values[s["var"]] = value
            rows.append({"step": s["step"], "var": s["var"], "value": value, "fails": fails, "unknown": unknown,
                         "blocked_by": blocked})
        out[key] = rows
        ok = [r["step"] for r in rows if r["value"] is True]
        best = ok[-1] if ok else None
        if key == "gl_core" and best is not None and gl_version_number(best) < 31:
            best = None                       # version.c: a core context needs 3.1 at least
        reached[key] = best
    out["reached"] = reached
    return out


_API_COL = {"compat": "gll", "core": "glc", "es": "es2"}


def observe_flags(ext_table, contexts):
    """what the extension strings of real contexts prove about each Mesa driver flag.
    contexts: [{api: compat|core|es, version: 21, extensions: [...], source: "..."}]"""
    ctx = [dict(c, ext=set(c.get("extensions") or [])) for c in contexts if c.get("version")]
    out = {}
    for flag, entries in ext_table.items():
        names = [e["name"] for e in entries]
        present = [c["source"] for c in ctx if any(n in c["ext"] for n in names)]
        if present:
            out[flag] = {"value": True, "evidence": "listed in " + ", ".join(present), "strings": names}
            continue
        visible = [c["source"] for c in ctx
                   if any(e[_API_COL[c["api"]]] is not None and c["version"] >= e[_API_COL[c["api"]]] for e in entries)]
        if visible:
            out[flag] = {"value": False, "evidence": "absent from " + ", ".join(visible), "strings": names}
        else:
            need = "; ".join("%s: %s" % (e["name"], ", ".join(
                "%s>=%s" % (api, "%d.%d" % divmod(e[col], 10) if e[col] else "any")
                for api, col in _API_COL.items() if e[col] is not None) or "not exposed") for e in entries)
            out[flag] = {"value": None, "evidence": "not observable in the contexts probed (%s)" % need, "strings": names}
    return out


