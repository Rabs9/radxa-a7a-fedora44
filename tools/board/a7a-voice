def held(path: Path) -> bool:
    """Someone holds the lock on `path` (a process number could be another program's by now: review 2026-11-18)."""
    try:
        with open(path) as f:
            fcntl.flock(f, fcntl.LOCK_SH | fcntl.LOCK_NB)
    except FileNotFoundError:
        return False
    except OSError:
        return True
    return False


def reader() -> int:
    """The process reading aloud now, 0 when none: SPEAKING locked, and the process it names an `a7a-voice say`. A
    lock held for a moment by someone looking (held, hush) leaves the number of a reader that has ended in the file,
    which could be another program's by now: that one is not a reader (review 2026-11-19)."""
    try:
        with open(SPEAKING) as f:
            try:
                fcntl.flock(f, fcntl.LOCK_SH | fcntl.LOCK_NB)
                return 0
            except OSError:
                pass
            pid = int(f.read().split()[0])
        argv = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
    except (OSError, ValueError, IndexError):
        return 0
    return pid if pid != os.getpid() and b"say" in argv and any(a.endswith(b"a7a-voice") for a in argv) else 0


def boot_seconds() -> float:
    return time.clock_gettime(time.CLOCK_BOOTTIME)


def started() -> float:
    """When this process started, in seconds since boot (as boot_seconds counts; into_venv's exec keeps it)."""
    with open("/proc/self/stat") as f:
        return int(f.read().rsplit(")", 1)[1].split()[19]) / os.sysconf("SC_CLK_TCK")


def hushed_since(t: float) -> bool:
    """A hush came after `t` (seconds since boot)."""
    try:
        return float(HUSHED.read_text()) > t
    except (OSError, ValueError):
        return False


def hush(wait: float = 2.0, everything: bool = True) -> bool:
    """Ends what is being read aloud: the reader's process group (it and its player), then empties SPEAKING. With
    `everything`, a reader started before now that has not taken the lock yet (half a second of starting up) gives
    up too: it finds the time written in HUSHED after its own start (say_aloud's own hush, making way for itself, is
    not one of those). True when a reader was ended."""
    if everything:
        try:
            HUSHED.parent.mkdir(parents=True, exist_ok=True)
            HUSHED.write_text(f"{boot_seconds():.3f}\n")
        except OSError:                     # (the runtime directory full: the reader that holds the lock still goes)
            pass
    pid = reader()
    if not pid:
        return False
    try:
        if os.getpgid(pid) == pid:
            os.killpg(pid, signal.SIGTERM)
        else:
            os.kill(pid, signal.SIGTERM)
    except OSError:
        return False
    end = time.monotonic() + wait
    try:
        with open(SPEAKING, "r+") as f:
            while time.monotonic() < end:       # the kernel lets go of its lock as it ends
                try:
                    fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except OSError:
                    time.sleep(0.02)
                    continue
                f.truncate(0)                   # its number goes with it
                break
    except OSError:
        pass
    return True


# ---------------------------------------------------------------- doing things

def detached(argv: list[str]) -> None:
    """Starts `argv` and does not wait for it: setsid -f returns at once, so nothing is left to reap."""
    try:
        subprocess.run(["setsid", "-f", *argv], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=10)
    except (OSError, subprocess.SubprocessError) as e:
        print(f"could not start {argv[0]}: {e}", flush=True)


def launch(line: str) -> None:
    """A command line, as the owner, in a scope of its own: outside the listener's service, so stopping the listener
    does not take an application it started with it."""
    detached(["systemd-run", "--user", "--scope", "--quiet", "--collect", "--", "/bin/sh", "-c", line])


def notify(title: str, body: str = "") -> None:
    """KDE reads markup in a notification's text: escaped, so what was heard or answered shows as it is (an answer's
    "<" or "&" garbled it, and a link in it was clickable: review 2026-11-18)."""
    detached(["notify-send", "--app-name=Voice commands", "--icon=audio-input-microphone", "--transient",
              "--expire-time=5000", html.escape(title, quote=False), html.escape(body, quote=False)])


def chime(path: str) -> None:
    if path:
        detached(["pw-play", path])


