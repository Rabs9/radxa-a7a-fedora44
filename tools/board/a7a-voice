def python_version() -> str:
    return f"{sys.version_info.major}.{sys.version_info.minor}"


def venv_ok(r) -> bool:
    """The marker setup writes last names these packages and this Python (the venv's python is the system's: after a
    Fedora update to another Python its packages are not found), and the venv is there."""
    return (isinstance(r, dict) and r.get("packages") == PACKAGES and r.get("python") == python_version()
            and (VENV / "bin" / "python").exists())


def ready(models=PARTS["listen"]) -> bool:
    """Set up for this version: the venv (venv_ok), and the models, checked by a setup (the marker names them) and on
    disk (each directory is moved into place whole)."""
    r = read_json(READY)
    return (venv_ok(r) and isinstance(r.get("models"), list)
            and all(m[0] in r["models"] and (MODELS / m[0]).is_dir() for m in models))


def mark(models, checked: bool = True) -> None:
    """The marker: this venv, and the models checked in it, these added (or, not `checked`, taken out)."""
    r = read_json(READY)
    have = set(r["models"]) if venv_ok(r) and isinstance(r.get("models"), list) else set()
    names = {m[0] for m in models}
    have = have | names if checked else have - names
    write_json(READY, {"packages": PACKAGES, "models": [m[0] for m in (KWS, ASR, TTS) if m[0] in have],
                       "python": python_version(), "at": time.strftime("%F %T")})


def progress(fraction: float, step: str, where: Path | None = None) -> None:
    write_json(where or PROGRESS, {"fraction": round(fraction, 3), "step": step, "pid": os.getpid()})


def setup_running(part: str | None = None) -> bool:
    """A setup holds the lock (of `part`, when given: the lock is one, and the other part's setup holding it says
    nothing of this part's progress file)."""
    lock = DATA / "setup.lock"
    if not held(lock):
        return False
    try:
        return part is None or lock.read_text().split()[1] == part
    except (OSError, IndexError):
        return False


def tell(text: str) -> None:
    """Printed for whoever started us; the panel may have closed, and setup goes on without it."""
    try:
        print(text, flush=True)
    except OSError:
        pass


# what a setup needs on the card besides its models (2026-11-24, measured on the board: the venv 131 MB, pip's cache
# 35 MB), and the room kept spare on top
VENV_BYTES = 200 << 20
SPARE_BYTES = 50 << 20
# pip's words for a board that cannot reach pypi.org
OFFLINE = ("Failed to establish a new connection", "Temporary failure in name resolution", "Name or service not known",
           "Network is unreachable", "No route to host", "Connection refused", "ConnectTimeoutError", "Read timed out",
           "ProxyError")


def free_bytes(path: Path) -> int:
    return shutil.disk_usage(path).free


def space_needed(models: tuple) -> int:
    """What a setup of `models` still needs on the card: the venv when it must be made, and for each model not
    unpacked yet its archive (less what of it is downloaded) and what it unpacks beside it (about its size again),
    with SPARE_BYTES on top (2026-11-24: a full card stopped a setup halfway with "No space left on device")."""
    need = SPARE_BYTES if venv_ok(read_json(READY)) else SPARE_BYTES + VENV_BYTES
    for name, _tag, size, _sha, _keep in models:
        if (MODELS / name).is_dir():
            continue
        part = MODELS / f"{name}.tar.bz2.part"
        have = part.stat().st_size if part.exists() else 0
        need += max(0, size - have) + size * 5 // 4
    return need


def pip_failed(logged: Path, code: int) -> str:
    """Why pip stopped, in words: no internet (the first run may well be offline), or its own last ERROR line."""
    try:
        said = logged.read_text(errors="replace")
    except OSError:
        said = ""
    if any(w in said for w in OFFLINE):
        return ("could not download the speech engine: no connection to pypi.org. Is the board on the internet? "
                "Connect, then try again")
    lines = [l.strip() for l in said.splitlines() if l.strip()]
    errors = [l for l in lines if l.startswith("ERROR:")]
    last = errors[-1] if errors else lines[-1] if lines else f"pip exit {code}"
    return f"installing the speech engine failed ({last}); pip's whole answer is in {logged}"


def download(model: tuple, lo: float, hi: float, where: Path | None = None) -> None:
    """One model: downloaded (continued if a part is there), its size and sha256 checked, the files it needs
    unpacked into MODELS/<name> (whole or not at all); its progress in `where` (PROGRESS)."""
    name, tag, size, sha, keep = model
    if (MODELS / name).is_dir():
        return
    MODELS.mkdir(parents=True, exist_ok=True)
    part = MODELS / f"{name}.tar.bz2.part"
    have = part.stat().st_size if part.exists() else 0
    if have > size:
        part.unlink()
        have = 0
    announced = None                     # the file's whole size as the server's answer gave it
    if have < size:
        req = urllib.request.Request(f"{RELEASES}/{tag}/{name}.tar.bz2", headers={"Range": f"bytes={have}-"} if have else {})
        # each way a first run's download fails, in words, what came kept for the next try (2026-11-24)
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                resumed = bool(have) and r.status == 206
                got = have if resumed else 0
                n = r.headers.get("Content-Length", "")
                announced = got + int(n) if n.isdigit() else None
                chunk = r.read(1 << 18)
                # an answer from the start is looked at before the part is touched (review 2026-11-24): a network's
                # login page, sent as a 200, truncated a part and then had it removed as another file
                if not resumed:
                    if not chunk.startswith(b"BZh"):
                        raise RuntimeError(f"{name}: the answer is not the model's archive (a network's login page?): "
                                           "is the board on the internet? Connect, then try again")
                    if announced is not None and announced != size:
                        raise RuntimeError(f"{name}: the server's file is {announced} bytes, {size} expected: not the "
                                           "file this setup knows")
                with open(part, "ab" if resumed else "wb") as f:
                    last = 0.0
                    while chunk:
                        f.write(chunk)
                        got += len(chunk)
                        if time.time() - last > 0.5:
                            last = time.time()
                            progress(lo + (hi - lo) * 0.9 * got / size,
                                     f"downloading {name} ({got >> 20} of {size >> 20} MB)", where)
                        chunk = r.read(1 << 18)
        except urllib.error.HTTPError as e:
            e.close()
            if e.code == 416:       # the part asks from past the server's file: every try would; it goes
                part.unlink(missing_ok=True)
                raise RuntimeError(f"{name}: the download server answered 416 (what was kept is longer than its file): "
                                   "removed, try again") from None
            raise RuntimeError(f"{name}: the download server answered {e.code} {e.reason}: try again later") from None
        except urllib.error.URLError as e:
            raise RuntimeError(f"{name}: no connection to the download server (github.com): {e.reason}. Is the board on "
                               "the internet? Connect, then try again") from None
        except (TimeoutError, ConnectionError, http.client.HTTPException) as e:
            raise RuntimeError(f"{name}: the download was cut ({type(e).__name__}): trying again carries on where it "
                               "stopped") from None
    came = part.stat().st_size
    if came != size and came == announced:
        # the server sent all it said, and that is not the file this setup expects: no try would get it
        part.unlink()
        raise RuntimeError(f"{name}: the server's file is {came} bytes, {size} expected: not the file this setup knows")
    if came != size:
        # the server stopped sending without an error: what came is kept
        raise RuntimeError(f"{name}: the download was cut ({came >> 20} of {size >> 20} MB): trying again carries on "
                           "where it stopped")
    h = hashlib.sha256()
    with open(part, "rb") as f:
        while block := f.read(1 << 20):
            h.update(block)
    if h.hexdigest() != sha:
        part.unlink()
        raise RuntimeError(f"{name}: the download is damaged (sha256 {h.hexdigest()}) and was removed: run setup again")
    progress(lo + (hi - lo) * 0.95, f"unpacking {name}", where)
    tmp = MODELS / f"{name}.unpacking"
    if tmp.exists():
        for f in sorted(tmp.rglob("*"), reverse=True):
            f.unlink() if f.is_file() else f.rmdir()
        tmp.rmdir()
    tmp.mkdir()
    with tarfile.open(part, "r:bz2") as t:
        for m in t.getmembers():
            if m.isfile() and Path(m.name).parent.name == name and re.match(keep, Path(m.name).name):
                m.name = Path(m.name).name
                t.extract(m, tmp, filter="data")
    if not any(tmp.iterdir()):
        raise RuntimeError(f"{name}: none of the files it needs in the download")
    tmp.rename(MODELS / name)
    part.unlink()


def listener_back() -> None:
    """Listening set up again: a listener that stopped on "not set up" (a package update or a new Python asked for a
    new venv) starts again, also when the voice's setup made it (review 2026-11-19)."""
    st = read_json(STATUS)
    if isinstance(st, dict) and st.get("state") == "error":
        STATUS.unlink(missing_ok=True)
    if systemctl("is-enabled", UNIT).stdout.strip() == "enabled":
        systemctl("reset-failed", UNIT)
        systemctl("restart", UNIT)


def setup(part: str = "listen") -> int:
    """The venv with the pinned wheels, the part's models, and a load check; the progress for the panel in PROGRESS
    (listening: the Voice tab's Set up) or SPEECH_PROGRESS (the voice: the Assistant tab's speak answers). One at a
    time (a lock under DATA); what pip and the check print goes to a log under DATA, not to the caller, who may have
    gone (the panel closed: a check writing to its closed pipe failed, review 2026-11-18). The venv is made beside the
    old one and moved into place whole, so an interrupted setup or a new Python leaves nothing half made. The other
    part's models, when they are on disk, are checked in it too, not downloaded again: a new venv for one part would
    otherwise leave the other unready without a word (review 2026-11-19)."""
    models, where = PARTS[part], PROGRESS if part == "listen" else SPEECH_PROGRESS
    DATA.mkdir(parents=True, exist_ok=True)
    lock = open(DATA / "setup.lock", "a+")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        lock.close()
        tell("setup is already running")
        return 1
    lock.truncate(0)
    lock.write(f"{os.getpid()} {part}\n")          # which part (setup_running)
    lock.flush()
    logged = DATA / ("setup.log" if part == "listen" else f"setup-{part}.log")
    log = open(logged, "w")
    try:
        # room first: a full card would stop it halfway (2026-11-24)
        need, free = space_needed(models), free_bytes(DATA)
        if free < need:
            raise RuntimeError(f"not enough space on the card: {free >> 20} MB free, setting up needs about "
                               f"{need >> 20} MB. Free some space, then try again")
        progress(0.0, "making the venv", where)
        if not venv_ok(read_json(READY)):
            new = VENV.with_name("venv.new")
            shutil.rmtree(new, ignore_errors=True)
            subprocess.run([sys.executable, "-m", "venv", str(new)], check=True, stdout=log, stderr=log)
            progress(0.05, "installing the speech engine (sherpa-onnx)", where)
            try:
                subprocess.run([str(new / "bin" / "python"), "-m", "pip", "install", "--quiet",
                                "--disable-pip-version-check", "--no-input", "--only-binary=:all:", *PACKAGES],
                               check=True, stdout=log, stderr=log)
            except subprocess.CalledProcessError as e:
                log.flush()
                shutil.rmtree(new, ignore_errors=True)          # its room back, on a small card
                raise RuntimeError(pip_failed(logged, e.returncode)) from None
            READY.unlink(missing_ok=True)
            shutil.rmtree(VENV, ignore_errors=True)
            new.rename(VENV)
        total, done = sum(m[2] for m in models), 0
        for m in models:                    # each its share of the bar, by its size
            download(m, 0.25 + 0.7 * done / total, 0.25 + 0.7 * (done + m[2]) / total, where)
            done += m[2]
        progress(0.96, "loading the models" if part == "listen" else "loading the voice", where)

        def checked(p: str) -> None:
            subprocess.run([str(VENV / "bin" / "python"), str(Path(__file__).resolve()), "check",
                            *([] if p == "listen" else [p])], check=True, stdout=log, stderr=log)

        try:
            # the engine's imports on their own first: one that crashes (a damaged library: SIGSEGV, not an
            # ImportError, so check's exit 3 is never reached) is the venv's, made again by the next setup, the
            # models left alone (review 2026-11-19)
            subprocess.run([str(VENV / "bin" / "python"), "-c", "import numpy, sentencepiece, sherpa_onnx"], check=True,
                           stdout=log, stderr=log)
        except subprocess.CalledProcessError as e:
            READY.unlink(missing_ok=True)
            raise RuntimeError(f"the speech engine does not load (exit {e.returncode}): the next setup makes it again")
        try:
            checked(part)
        except subprocess.CalledProcessError as e:
            # what does not load is made again by the next setup, and only that: the venv when the engine itself
            # does not load (exit 3; every part is checked in the new one); else the part's models, downloaded
            # again (a damaged file keeps its name, and download() takes a model whose directory is there for
            # done), unless the check was killed (out of memory beside the language model, say: they are kept)
            if e.returncode == 3:
                READY.unlink(missing_ok=True)
            else:
                mark(models, checked=False)
                if e.returncode != -signal.SIGKILL:     # a crash on a damaged file is downloaded again
                    for m in models:
                        shutil.rmtree(MODELS / m[0], ignore_errors=True)
            raise
        mark(models)
        listening = part == "listen"
        for other, theirs in PARTS.items():
            if other != part and not ready(theirs) and all((MODELS / m[0]).is_dir() for m in theirs):
                try:
                    checked(other)
                    mark(theirs)
                    listening |= other == "listen"
                except subprocess.CalledProcessError:
                    tell(f"{other}: its models do not load in the new venv: set that part up again")
        if listening:
            listener_back()
        tell("the voice is set up" if part == "speak" else "set up: turn it on in the panel's Voice tab, or a7a-voice on")
        return 0
    except (OSError, RuntimeError, subprocess.SubprocessError, tarfile.TarError, http.client.HTTPException) as e:
        # (a connection cut in the middle of a download is http.client's IncompleteRead, not an OSError: review)
        tell(f"setup failed: {e} (more in {logged})")
        write_json(where, {"fraction": 0.0, "step": "", "error": str(e), "pid": os.getpid()})
        return 1
    finally:
        cur = read_json(where)
        if not (isinstance(cur, dict) and cur.get("error")):
            where.unlink(missing_ok=True)
        log.close()
        lock.close()


# ---------------------------------------------------------------- the panel's commands

def systemctl(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["systemctl", "--user", *args], capture_output=True, text=True, timeout=30)


def status() -> dict:
    """The panel's view: the listener's own report while it runs; after it stopped, only the error it stopped on.
    Settings that do not read come with no commands: what a listener started now would run (not the built-in ones,
    which a Save from the tab would bring back)."""
    cfg, problem = load_config()
    if problem:
        cfg["commands"] = []
    running = systemctl("is-active", UNIT).stdout.strip() == "active"
    enabled = systemctl("is-enabled", UNIT).stdout.strip() == "enabled"
    st = read_json(STATUS)
    st = st if isinstance(st, dict) else {}
    progress_now = read_json(PROGRESS)
    # a setup that ended without finishing (killed, the board switched off) left its progress behind
    if isinstance(progress_now, dict) and not progress_now.get("error") and not setup_running("listen"):
        progress_now = {"fraction": 0.0, "step": "", "error": "the setup stopped before it finished: press Set up again"}
    out = {"ready": ready(), "running": running, "enabled": enabled, "config": cfg, "config_error": problem,
           "setup": progress_now, "online": online_names()}
    if running:                             # (online: the names it really listens for, of those, when it says)
        out.update({k: v for k, v in st.items() if k in ("state", "heard", "ran", "score", "at", "error", "online", "left_out",
                                                       "engine", "npu_error")})
        # the two phrases it wakes for, beside the saved ones in "config": a refused one differs (2026-11-24); only
        # once it has read the settings the file holds now (a save just made is not read yet: review 2026-11-24)
        if (isinstance(st.get("wake"), str) and isinstance(st.get("assistant"), str)
                and st.get("read") == mtime(CONFIG)):
            out["listening"] = {"wake": st["wake"], "assistant": st["assistant"]}
    elif st.get("state") == "error":
        out["error"] = st.get("error", "")
    return out


def on() -> int:
    if not ready():
        print("not set up: a7a-voice setup (or Set up in the panel's Voice tab)")
        return 1
    if not CONFIG.exists():
        write_json(CONFIG, clean(None))
    systemctl("reset-failed", UNIT)                 # after 4 failed starts systemd would not start it again
    r = systemctl("enable", "--now", UNIT)
    print(r.stdout + r.stderr if r.returncode else "listening: say the wake phrase, then a command")
    return r.returncode and 1


def off() -> int:
    r = systemctl("disable", "--now", UNIT)
    STATUS.unlink(missing_ok=True)
    print(r.stdout + r.stderr if r.returncode else "voice commands off")
    return r.returncode and 1


def save(text: str) -> int:
    try:
        raw = json.loads(text)
    except ValueError as e:
        print(f"not saved: {e}")
        return 1
    if not isinstance(raw, dict):
        print("not saved: the settings are a JSON object")
        return 1
    write_json(CONFIG, clean(raw))
    print(f"saved to {CONFIG}")
    return 0


def npu(switch: str) -> int:
    """`npu on`: the NPU spotter's package into the venv when it is missing, the spotter started once on a second of
    silence (the same files the listener will load), then the setting saved; the listener takes it within 1 s. `npu
    off`: the setting saved off."""
    cfg, problem = load_config()
    if problem:
        print(f"not changed: {problem}")
        return 1
    if switch == "on":
        if not ready():
            print("not set up: a7a-voice setup")
            return 1
        py = str(VENV / "bin" / "python")
        if subprocess.run([py, "-c", "import kaldi_native_fbank"], capture_output=True).returncode != 0:
            print(f"installing {' '.join(NPU_PACKAGES)} into {VENV}", flush=True)
            r = subprocess.run([py, "-m", "pip", "install", "--quiet", "--disable-pip-version-check", "--no-input",
                                "--only-binary=:all:", *NPU_PACKAGES], capture_output=True, text=True)
            if r.returncode != 0:
                print(f"not switched on: pip failed:\n{r.stderr.strip()[-800:]}")
                return 1
        probe = ("import sys, numpy as np; sys.argv = ['a7a-voice']; "
                 "import importlib.machinery, importlib.util; "
                 f"l = importlib.machinery.SourceFileLoader('v', {str(Path(__file__).resolve())!r}); "
                 "s = importlib.util.spec_from_loader('v', l); v = importlib.util.module_from_spec(s); l.exec_module(v); "
                 "cfg, _ = v.load_config(); cfg['online'] = v.online_names(); cfg['npu'] = True; "
                 "k, _, _ = v.spotter(cfg); "
                 "st = k.create_stream(); st.accept_waveform(16000, np.zeros(16000, np.float32)); "
                 "[k.decode_stream(st) for _ in range(8) if k.is_ready(st)]; "
                 "print('NPU-PROBE', v.ENGINE['engine'], v.ENGINE['npu_error'], flush=True)")
        try:
            r = subprocess.run([py, "-c", probe], capture_output=True, text=True, timeout=120)
        except subprocess.TimeoutExpired:
            print("not switched on: the NPU spotter took over 2 minutes to start")
            return 1
        # its own line: VIPLite prints its version on the way out, after it
        out = next((x[len("NPU-PROBE "):] for x in r.stdout.splitlines() if x.startswith("NPU-PROBE ")), "")
        if r.returncode != 0 or not out.startswith("npu"):
            print(f"not switched on: {out or r.stderr.strip()[-800:]}")
            return 1
    raw = json.loads(CONFIG.read_text()) if CONFIG.exists() else {}
    raw["npu"] = switch == "on"
    write_json(CONFIG, clean(raw))
    print(f"the spotter's network on the {'NPU' if switch == 'on' else 'CPU'}")
    return 0


def llm_ready(timeout: float = 3.0) -> bool:
    """The model server answers and has its model loaded (llama.cpp's /health is 503 while it loads)."""
    try:
        with urllib.request.urlopen(f"{LLM}/health", timeout=timeout) as r:
            return r.status == 200
    except (OSError, ValueError):
        return False


def ask(question: str, wait: float = 300.0, to: str = "") -> int:
    """A question said after the Assistant's wake phrase: the answer of the panel's own Assistant (the same model and
    board tools as its tab: a7a-panel --answer) as a notification, which KDE keeps in its history, and read aloud
    when the Assistant tab's speak answers is on. The model server is started first when it is not up (a7a-llm
    serve: the model takes a minute or two to load, and then stays, about 6 GB, until the Assistant tab's Stop
    server). `to`: an online assistant's name ("hey <name>"), which answers instead (no model server needed). Run by
    the listener on its own, in a scope like a command."""
    title = to.title() if to else "Assistant"
    first = notify_id(title, f"“{question}”\nThinking…")
    if not to and not llm_ready():
        notify_id(title, f"“{question}”\nStarting the model first: a minute or two…", first)
        try:
            r = subprocess.run(["a7a-llm", "serve"], stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=180)
        except (OSError, subprocess.SubprocessError) as e:
            return answered(first, f"The model did not start: {e}", title=title)
        out = [line.strip() for line in (r.stdout + r.stderr).splitlines() if line.strip()]
        if r.returncode and not any("already running" in line for line in out):
            return answered(first, f"The model did not start: {out[0] if out else f'a7a-llm exit {r.returncode}'}", title=title)
        end = time.time() + wait
        while not llm_ready():
            if time.time() > end:
                return answered(first, "The model did not get ready (its log: /tmp/a7a-llm.log).", title=title)
            time.sleep(2)
        notify_id(title, f"“{question}”\nThinking…", first)
    try:
        r = subprocess.run(["a7a-panel", "--answer", question, *(["--assistant", to] if to else [])],
                           stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=600)
    except (OSError, subprocess.SubprocessError) as e:
        return answered(first, f"No answer: {e}", title=title)
    text = r.stdout.strip() if r.returncode == 0 else ""
    if not text:
        why = [line for line in r.stderr.splitlines() if line.strip()]
        return answered(first, f"No answer: {why[-1] if why else 'the Assistant failed'}", title=title)
    tell(text)
    plain = re.sub(r"[*_`#]+", "", text)
    if len(plain) > ANSWER_CHARS:
        plain = plain[:ANSWER_CHARS].rsplit(" ", 1)[0] + " …"
    answered(first, plain, ok=True, title=title)
    if speech_settings()["speak"]:
        try:                                # until it has been read, or stopped (a wake phrase, Stop speaking)
            subprocess.run([str(Path(__file__).resolve()), "say"], input=text, text=True, timeout=1800)
        except (OSError, subprocess.SubprocessError) as e:
            tell(f"not read aloud: {e}")
    return 0


def notify_id(title: str, body: str, replace: int = 0, keep: bool = False) -> int:
    """A notification that a later one can take the place of (notify-send --print-id / --replace-id); its id, 0 when
    there is none."""
    argv = ["notify-send", "--app-name=Voice commands", "--icon=audio-input-microphone", "--print-id",
            f"--expire-time={30000 if keep else 0}"]
    if replace:
        argv.append(f"--replace-id={replace}")
    try:
        r = subprocess.run([*argv, html.escape(title, quote=False), html.escape(body, quote=False)], stdin=subprocess.DEVNULL,
                           capture_output=True, text=True, timeout=10)
        return int(r.stdout.strip() or 0)
    except (OSError, subprocess.SubprocessError, ValueError):
        return 0


def answered(first: int, text: str, ok: bool = False, title: str = "Assistant") -> int:
    notify_id(title, text, first, keep=True)
    if not ok:
        tell(text)
    return 0 if ok else 1


def say_aloud(text: str | None = None) -> int:
    """`a7a-voice say`: the text (None: stdin) read aloud now, in the voice chosen, in place of whatever is being
    read; done when it has been read, or ended with its process group by hush (the panel's Stop speaking, a wake
    phrase), or by a hush that came after it started, before it took the lock. The text from stdin is read in the
    venv (into_venv's exec keeps stdin): an answer in the program's arguments would be readable by anyone in /proc,
    and could be too long for them (review 2026-11-19)."""
    if not ready(PARTS["speak"]):
        print("the voice is not set up: turn on speak answers in the panel's Assistant tab (or a7a-voice speak on)")
        return 1
    into_venv(["say"] + ([] if text is None else [text]))
    if text is None:
        text = sys.stdin.buffer.read().decode(errors="replace")
    pieces = speakable(text)
    if not pieces:
        return 0
    since = started()
    try:
        os.setpgrp()                        # a process group of its own, with its player: hush ends both at once
    except OSError:
        pass                                # one already (started by setsid)
    SPEAKING.parent.mkdir(parents=True, exist_ok=True)
    with open(SPEAKING, "a+") as lock:
        for _ in range(40):                 # what is being read stops first, also one started meanwhile
            hush(everything=False)
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                time.sleep(0.05)
        else:
            print("not read aloud: what is being read does not stop")
            return 1
        lock.truncate(0)
        lock.write(str(os.getpid()))
        lock.flush()
        try:
            if hushed_since(since):         # stopped while it was starting
                return 0
            return read_aloud(pieces, speech_settings()["voice"], since)
        except (OSError, RuntimeError) as e:
            print(f"not read aloud: {e}")
            return 1
        finally:
            lock.truncate(0)                # no number left behind for hush to find


def speech_status() -> dict:
    """The Assistant tab's view: answers read aloud or not, the voice, the voice set up, one being read now, the
    voice's download at work (or why it stopped)."""
    prog = read_json(SPEECH_PROGRESS)
    if isinstance(prog, dict) and not prog.get("error") and not setup_running("speak"):
        prog = {"fraction": 0.0, "step": "", "error": "the download stopped before it finished: turn speak answers on again"}
    # busy: a setup of either part at work (one of listening's may make a new venv, and check the voice in it last)
    return dict(speech_settings(), voices=VOICES, ready=ready(PARTS["speak"]), speaking=held(SPEAKING),
                setup=prog if isinstance(prog, dict) else None, busy=setup_running())


def speak(args: list[str]) -> int:
    """`a7a-voice speak [on | off | voice V]`. The first "on" sets the voice up (a download of a minute or two, its
    progress in speech_status); "on" and a new voice read a sample in the voice."""
    if not args:
        print(json.dumps(speech_status(), ensure_ascii=False))
        return 0
    cur = speech_settings()
    if args == ["off"]:
        write_json(SPEECH, dict(cur, speak=False))
        hush()
        print("answers are not read aloud")
        return 0
    if args == ["on"]:
        if not ready(PARTS["speak"]) and setup("speak"):
            return 1
        write_json(SPEECH, dict(cur, speak=True))
        print(f"answers are read aloud, in voice {cur['voice']}")
    elif len(args) == 2 and args[0] == "voice":
        if args[1] not in VOICES:
            print(f"no voice {args[1]}: one of {' '.join(VOICES)}")
            return 1
        write_json(SPEECH, dict(cur, voice=args[1]))
        print(f"voice {args[1]}")
    else:
        return usage()
    if ready(PARTS["speak"]):
        detached([str(Path(__file__).resolve()), "say", SAMPLE])
    return 0


def test(text: str, dry: bool = False, panel: bool = False) -> int:
    """The command `text` matches, run; not with `dry`, nor from the panel (`panel`) when it presses keys or acts on
    the window: it would act on the panel itself (close it, type into it: review 2026-11-22)."""
    cfg, problem = load_config()
    if problem:
        print(f"{problem}: no commands")
        return 1
    heard = words(text)
    match, s = best_match(heard, active(cfg), cfg["match"])
    if match is None:
        closest, cs = best_match(heard, active(cfg), 0.0)
        hint = f": the closest is “{closest['say']}” ({cs:.2f}, {cfg['match']:.2f} needed)" if closest else ""
        print(f"no command matches “{text}”{hint}")
        return 1
    if panel and match["run"].startswith(("a7a-voice key ", "a7a-voice type ", "a7a-voice shortcut ")):
        dry = True
    print(f"“{text}” -> “{match['say']}” ({s:.2f}): {match['run']}" + (" (not run from the panel: it would act on the panel itself)" if dry else ""))
    if not dry:
        launch(match["run"])
    return 0


def usage() -> int:
    print(__doc__.split("\n\n")[1], file=sys.stderr)
    return 2


def main(argv=None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    cmd = argv[0] if argv else ""
    if cmd == "setup" and len(argv) == 1:
        return setup()
    if cmd == "listen" and len(argv) == 1:
        return listen()
    if cmd == "check" and argv[1:] in ([], ["speak"]):
        return check(*argv[1:])
    if cmd == "speak":
        return speak(argv[1:])
    if cmd == "say" and len(argv) <= 2:
        return say_aloud(*argv[1:])
    if cmd == "hush" and len(argv) == 1:
        print("stopped" if hush() else "nothing was being read")
        return 0
    if cmd == "on" and len(argv) == 1:
        return on()
    if cmd == "off" and len(argv) == 1:
        return off()
    if cmd == "status" and len(argv) == 1:
        print(json.dumps(status(), ensure_ascii=False))
        return 0
    if cmd == "save" and len(argv) == 1:
        return save(sys.stdin.read())
    if cmd == "ask" and len(argv) == 2:
        return ask(argv[1])
    if cmd == "ask" and len(argv) == 4 and argv[1] == "--to":
        return ask(argv[3], to=argv[2])
    if cmd == "test" and len(argv) == 2:
        return test(argv[1])
    if cmd == "test" and len(argv) == 3 and argv[1] in ("--dry", "--panel"):
        return test(argv[2], dry=argv[1] == "--dry", panel=argv[1] == "--panel")
    if cmd == "npu" and argv[1:] in (["on"], ["off"]):
        return npu(argv[1])
    if cmd == "scan" and len(argv) == 1:
        return scan()
    if cmd == "app" and len(argv) == 3 and argv[1] in ("open", "close"):
        return app(argv[1], argv[2])
    if cmd == "shortcut" and len(argv) == 2:
        return shortcut(argv[1])
    if cmd == "key" and len(argv) >= 2:
        why = keys(["key " + " ".join(argv[1:])])
        print(why or "pressed")
        return 1 if why else 0
    if cmd == "type" and len(argv) == 2:
        why = keys(type_lines(argv[1]))
        print(why or "typed")
        return 1 if why else 0
    return usage()


if __name__ == "__main__":
    sys.exit(main())
