def app_dirs() -> list[Path]:
    """Where the menu's applications are (the XDG data directories' applications, the owner's first), Flatpak's
    included when the session did not name them (a service's environment may not)."""
    home = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share")
    dirs = [home] + [Path(d) for d in (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":") if d]
    for flatpak in (home / "flatpak/exports/share", Path("/var/lib/flatpak/exports/share")):
        if flatpak not in dirs:
            dirs.insert(1, flatpak)
    return [d / "applications" for d in dirs]


def desktop_entries(dirs: list[Path] | None = None, desktop: str | None = None) -> list[dict]:
    """The applications the menu shows, by their desktop file (an id seen first hides the same id later, as the
    menu does: the owner's own copy of one wins): {"id" ("org.kde.kwrite"), "name", "generic", "wmclass", "path"}.
    Not those hidden from it (NoDisplay, Hidden), shown on other desktops only, run in a terminal, or whose program is
    not there (TryExec). Sorted by name."""
    desktops = set((desktop if desktop is not None else os.environ.get("XDG_CURRENT_DESKTOP") or "KDE").split(":"))
    seen: dict[str, dict | None] = {}
    for d in dirs if dirs is not None else app_dirs():
        for path in sorted(d.rglob("*.desktop")) if d.is_dir() else []:
            app_id = str(path.relative_to(d).with_suffix("")).replace("/", "-")
            if app_id in seen:
                continue
            seen[app_id] = None
            entry = {}
            try:
                section = ""
                for line in path.read_text(errors="replace").splitlines():
                    line = line.strip()
                    if line.startswith("["):
                        section = line
                    elif section == "[Desktop Entry]" and "=" in line and not line.startswith("#"):
                        k, v = line.split("=", 1)
                        entry.setdefault(k.strip(), v.strip())
            except OSError:
                continue
            listed = lambda k: {x for x in entry.get(k, "").split(";") if x}
            try_exec = entry.get("TryExec", "")
            if (entry.get("Type") != "Application" or not entry.get("Exec") or not entry.get("Name")
                    or entry.get("NoDisplay") == "true" or entry.get("Hidden") == "true" or entry.get("Terminal") == "true"
                    or (listed("OnlyShowIn") and not listed("OnlyShowIn") & desktops) or listed("NotShowIn") & desktops
                    or (try_exec and not (shutil.which(try_exec) if "/" not in try_exec else os.access(try_exec, os.X_OK)))):
                continue
            seen[app_id] = {"id": app_id, "name": entry["Name"], "generic": entry.get("GenericName", ""),
                            "wmclass": entry.get("StartupWMClass", ""), "path": str(path)}
    return sorted((e for e in seen.values() if e), key=lambda e: e["name"].lower())


def app_words(e: dict) -> str:
    """How an application is said: its name, unless that is KDE's K and a consonant ("KCalc", "KWrite", "KRDC": not
    words the recogniser writes), then what it is ("scientific calculator") when that is three words at most."""
    if re.match(r"k[^aeiouy\W]", e["name"], re.I) and 0 < len(words(e["generic"])) <= 3:
        return " ".join(words(e["generic"]))
    return " ".join(words(e["name"]))


def same_words(commands: list[dict]) -> list[str]:
    """The words more than one command answers to (of those with a command line), each once: only the first of them
    would ever run."""
    count = collections.Counter(tuple(words(c["say"])) for c in commands if words(c["say"]) and c["run"].strip())
    return [" ".join(w) for w, n in count.items() if n > 1]


def scanned(cfg: dict, entries: list[dict]) -> tuple[list[dict], dict]:
    """The found commands after a scan: "open …" and "close …" for each application, then SYSTEM's. One found before
    keeps the owner's words for it and its on or off (by its id); a new one is on at first unless one of the owner's
    own commands has its words (that one would take it) or SYSTEM has it off. An application gone takes its two with
    it. With what changed: the words added and removed, and those said for more than one command switched on."""
    old = {f["id"]: f for f in cfg.get("found", [])}
    owners = {tuple(words(c["say"])) for c in cfg["commands"] if c["run"].strip()}
    fresh = []
    for e in entries:
        if said := app_words(e):
            q = shlex.quote(e["id"])
            fresh += [(f"open:{e['id']}", f"open {said}", f"a7a-voice app open {q}", True, "app"),
                      (f"close:{e['id']}", f"close {said}", f"a7a-voice app close {q}", True, "app")]
    fresh = [(f"system:{k}", say, run, on, group) for k, say, run, on, group in SYSTEM] + fresh
    found, added = [], []
    for fid, say, run, on, kind in fresh:
        if fid in {f["id"] for f in found}:            # (two entries cannot share an id; a hand-edited file might)
            continue
        if fid in old:
            o = old[fid]                                # the owner's words stay; words the scan made follow the name
            found.append({"id": fid, "say": o["say"] if o["say"] != (o.get("made") or say) else say, "run": run,
                          "on": o["on"], "kind": kind, "made": say})
        else:
            found.append({"id": fid, "say": say, "run": run, "on": on and tuple(words(say)) not in owners, "kind": kind,
                          "made": say})
            added.append(say)
    ids = {f["id"] for f in found}
    removed = [o["say"] for i, o in old.items() if i not in ids]
    return found, {"added": added, "removed": removed, "found": len(found),
                   "same": same_words(cfg["commands"] + [f for f in found if f["on"]])}


def scan() -> int:
    """`a7a-voice scan`: the found commands brought up to date in the settings (a running listener takes them within
    1 s), and what changed, said."""
    cfg, problem = load_config()
    if problem:
        print(f"not scanned: {problem} (save the settings in the panel first)")
        return 1
    cfg["found"], report = scanned(cfg, desktop_entries())
    write_json(CONFIG, cfg)
    on = sum(f["on"] for f in cfg["found"])
    print(f"{report['found']} commands found ({on} on): {len(report['added'])} new, {len(report['removed'])} gone")
    for what, said in (("new", report["added"]), ("gone", report["removed"])):
        if said:
            print(f"{what}: " + ", ".join(f"“{s}”" for s in said[:12]) + (f" and {len(said) - 12} more" if len(said) > 12 else ""))
    for s in report["same"]:
        print(f"“{s}” is said for more than one command: only the first runs; change the words of the others")
    return 0


def keyboard_env() -> dict:
    """The desktop's keyboard layout for dotool (it types for "us" otherwise): KDE's first layout, and its variant."""
    layout = variant = ""
    try:
        for line in (Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "kxkbrc").read_text().splitlines():
            k, _, v = line.partition("=")
            if k.strip() == "LayoutList":
                layout = v.split(",")[0].strip()
            elif k.strip() == "VariantList":
                variant = v.split(",")[0].strip()
    except OSError:
        pass
    return {k: v for k, v in (("DOTOOL_XKB_LAYOUT", layout), ("DOTOOL_XKB_VARIANT", variant)) if v}


def keys(lines: list[str]) -> str:
    """dotool's actions ("key ctrl+l", "type hello"), through the listening listener's dotool (Typist) when it runs,
    else a dotool of its own. "" when they went, else why not."""
    todo = [(line.replace("\n", " ") + "\n").encode() for line in lines]
    try:
        fd = os.open(KEYS_PIPE, os.O_WRONLY | os.O_NONBLOCK)      # ENXIO when no listener reads it
    except OSError:
        fd = -1
    if fd >= 0:
        try:
            while todo:                     # a line at a time, each whole (TYPE_CHUNK keeps it under a pipe's 4 KiB)
                if os.write(fd, todo[0]) != len(todo[0]):
                    break
                todo.pop(0)
        except OSError:
            pass                                                    # the lines not written, to a dotool of its own
        finally:
            os.close(fd)
        if not todo:
            return ""
    data = b"".join(todo)
    try:
        r = subprocess.run(["dotool"], input=data, capture_output=True, timeout=60, env={**os.environ, **keyboard_env()})
    except FileNotFoundError:
        return "typing needs dotool (sudo dnf install dotool)"
    except (OSError, subprocess.SubprocessError) as e:
        return f"dotool: {e}"
    return r.returncode and (r.stderr.decode(errors="replace").strip() or f"dotool failed ({r.returncode})") or ""


def type_lines(text: str) -> list[str]:
    """dotool's lines that type `text`: a line break as Shift+Enter (Enter alone sends a chat message), long text
    in pieces."""
    out = []
    for i, part in enumerate(text.split("\n")):
        if i:
            out.append("key shift+enter")
        out += [f"type {part[j:j + TYPE_CHUNK]}" for j in range(0, len(part), TYPE_CHUNK)]
    return out


class Typist:
    """The listener's keyboard: one dotool kept running for its life (a new one takes the desktop about a second to
    see), fed by the listener's own typing (send) and, through KEYS_PIPE, by `a7a-voice key|type` run as commands.
    A dotool that stopped is started again, at most every 5 s, and what could not be typed is said, never dropped in
    silence; nothing here waits on dotool (the listener's sound must keep coming: review 2026-11-22)."""

    def __init__(self, pipe: Path = KEYS_PIPE, argv=("dotool",)):
        self.pipe, self.argv = pipe, list(argv)
        self.proc, self.started, self.lock, self.inode, self.errors = None, -1e9, threading.Lock(), None, None
        try:
            pipe.unlink(missing_ok=True)
            os.mkfifo(pipe, 0o600)
            fd = os.open(pipe, os.O_RDWR)            # read and write: never at its end between two writers
            self.inode = os.fstat(fd).st_ino
            threading.Thread(target=self.relay, args=(fd,), daemon=True).start()
        except OSError as e:
            print(f"no pipe for the key commands ({e}): they use a dotool of their own", flush=True)

    def relay(self, fd: int) -> None:
        with os.fdopen(fd, "rb") as f:
            for line in f:
                if why := self.send([line.decode(errors="replace").rstrip("\n")]):
                    print(f"a key command was not typed: {why}", flush=True)

    def start(self) -> str:
        """"" when a dotool runs, else why not."""
        if self.proc is not None and self.proc.poll() is None:
            return ""
        why = ""
        if self.proc is not None:
            err = ""
            if self.errors is not None:
                self.errors.seek(0)
                err = self.errors.read().decode(errors="replace").strip().splitlines()[-1:]
                err = err[0][-200:] if err else ""
            why = f"dotool stopped (exit {self.proc.returncode}){': ' + err if err else ''}"
            self.proc = None
        if time.monotonic() - self.started < 5:
            return why or "dotool stopped"
        self.started = time.monotonic()
        # its warnings (a key it does not know) to a file: a pipe nobody read would fill and stop it (review)
        if self.errors is not None:
            self.errors.close()
        self.errors = tempfile.TemporaryFile()
        try:
            self.proc = subprocess.Popen(self.argv, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=self.errors,
                                         env={**os.environ, **keyboard_env()})
        except OSError:
            return "typing needs dotool (sudo dnf install dotool)"
        time.sleep(0.3)                              # one that cannot open /dev/uinput stops at once: said now
        if self.proc.poll() is not None:
            return self.start() or "dotool stopped"
        return ""

    def send(self, lines: list[str]) -> str:
        data = "".join(line.replace("\n", " ") + "\n" for line in lines).encode()
        with self.lock:
            if why := self.start():
                return why
            try:
                self.proc.stdin.write(data)
                self.proc.stdin.flush()
                return ""
            except OSError as e:
                return f"dotool stopped: {e}"

    def close(self) -> None:
        if self.proc is not None:
            self.proc.terminate()
        try:                                         # its own pipe only (another listener's may be there now)
            if self.inode is not None and self.pipe.stat().st_ino == self.inode:
                self.pipe.unlink()
        except OSError:
            pass


def kwin_close(names: list[str]) -> str:
    """The windows of an application closed as their ✕ would (each may ask to save first), by a KWin script: those
    whose desktop file name or window class is one of `names`. "" when KWin took the script, else why not."""
    script = RUNDIR / f"a7a-voice-close-{os.getpid()}.js"
    plugin = script.stem
    script.write_text(
        f"const names = {json.dumps([n.lower() for n in names])};\n"
        "for (const w of workspace.windowList()) {\n"
        "  if (w.normalWindow && (names.includes((w.desktopFileName || '').toLowerCase()) ||\n"
        "                         names.includes((w.resourceClass || '').toLowerCase()))) w.closeWindow();\n"
        "}\n")
    call = ["gdbus", "call", "--session", "--dest", "org.kde.KWin", "--object-path"]
    try:
        r = subprocess.run(call + ["/Scripting", "--method", "org.kde.kwin.Scripting.loadScript", str(script), plugin],
                           capture_output=True, text=True, timeout=10)
        n = re.search(r"-?\d+", r.stdout)
        if r.returncode or not n or int(n.group()) < 0:
            return f"KWin did not take the script: {r.stderr.strip() or r.stdout.strip()}"
        subprocess.run(call + [f"/Scripting/Script{n.group()}", "--method", "org.kde.kwin.Script.run"],
                       capture_output=True, timeout=10)
        time.sleep(0.5)                                     # (unloaded at once, it may not have run)
        return ""
    except (OSError, subprocess.SubprocessError) as e:
        return f"KWin: {e}"
    finally:
        try:
            subprocess.run(call + ["/Scripting", "--method", "org.kde.kwin.Scripting.unloadScript", plugin],
                           capture_output=True, timeout=10)
        except (OSError, subprocess.SubprocessError):
            pass
        script.unlink(missing_ok=True)


def app(action: str, app_id: str) -> int:
    """`a7a-voice app open|close ID`: the application of that desktop file started (as the menu starts it, by gio),
    or its windows closed."""
    e = next((e for e in desktop_entries() if e["id"] == app_id), None)
    if e is None:
        notify("No such application", f"“{app_id}” is not in the menu now: Scan again in the panel's Voice tab.")
        print(f"no application {app_id} in the menu")
        return 1
    if action == "open":
        try:
            r = subprocess.run(["gio", "launch", e["path"]], capture_output=True, text=True, timeout=30)
        except (OSError, subprocess.SubprocessError) as ex:
            print(f"could not start {e['name']}: {ex}")
            return 1
        if r.returncode:
            print(f"could not start {e['name']}: {r.stderr.strip()}")
        return r.returncode and 1
    tail = app_id.rsplit(".", 1)[-1]
    why = kwin_close([app_id] + [n for n in (e["wmclass"], tail if len(tail) >= 4 else "") if n])
    if why:
        print(why)
    return 1 if why else 0


def shortcut(name: str) -> int:
    """`a7a-voice shortcut NAME`: one of KWin's own shortcuts ("Show Desktop", "Window Close"), as if pressed."""
    r = subprocess.run(["gdbus", "call", "--session", "--dest", "org.kde.kglobalaccel", "--object-path", "/component/kwin",
                        "--method", "org.kde.kglobalaccel.Component.invokeShortcut", name], capture_output=True, text=True)
    if r.returncode:
        print(r.stderr.strip())
    return r.returncode and 1


# ---------------------------------------------------------------- typing what is said

# words said for a sign: in an address ("www dot google dot com") they are written as the sign without spaces; in text
# only the punctuation ones (a comma, a full stop) are, and "at" stays a word
SIGNS = {"dot": ".", "slash": "/", "colon": ":", "dash": "-", "hyphen": "-", "underscore": "_", "at": "@"}
PUNCTUATION = [(("question", "mark"), "?"), (("exclamation", "mark"), "!"), (("exclamation", "point"), "!"),
               (("full", "stop"), "."), (("period",), "."), (("comma",), ","), (("colon",), ":"),
               (("semicolon",), ";"), (("new", "line"), "\n"), (("new", "paragraph"), "\n\n")]
ENDS = ".?!\n"
# what an address ends in after its last dot, said (the recogniser writes it as a word)
# the keys a sentence of their words alone presses while dictating ("press enter", "select all"): editing and sending;
# the media, scrolling and other commands' words are typed then ("pause" is a word: review 2026-11-22)
DICTATION_KEYS = {"enter", "tab", "esc", "shift+enter", "ctrl+a", "ctrl+c", "ctrl+v", "ctrl+z"}
# words an "at" after them makes no address of ("visit us at example dot com" is not us@example.com: review)
NOT_NAMES = {"me", "us", "am", "is", "are", "was", "were", "be", "i", "we", "you", "it", "him", "her", "them", "here",
             "there", "home", "work", "look", "meet", "find", "visit", "email", "mail", "write", "online"}
DOMAINS = {"com", "org", "net", "ca", "io", "edu", "gov", "uk", "co", "de", "fr", "info", "app", "dev", "ai", "tv",
           "me", "us", "eu", "xyz"}


def www(ws: list[str]) -> list[str]:
    """"w w w" and "double u double u double u" as the recogniser may write www; and two or three w's before a "dot"
    ("ww dot google dot com"): it drops one of the three at times (the owner's voice, board 2026-11-22: "Type WW.google.com")."""
    s = re.sub(r"\b(?:double u double u double u|double you double you double you|w w w)\b", "www", " ".join(ws))
    ws = [p for n, w in enumerate(s.split()) for p in unglued(s.split(), n, w)]
    out, i = [], 0
    while i < len(ws):
        j = i
        while j < len(ws) and set(ws[j]) == {"w"}:
            j += 1
        if j > i and j < len(ws) and ws[j] == "dot" and sum(map(len, ws[i:j])) in (2, 3):
            out.append("www")
            i = j
        else:
            out.append(ws[i])
            i += 1
    return out


def unglued(ws: list[str], n: int, w: str) -> list[str]:
    """The n-th word w, its "dot" taken apart from the word it is glued to between www and another dot ("ww dotgoogle
    dot com": owner, board 2026-11-23); otherwise whole ("a dotted line", "www dotted")."""
    if w.startswith("dot") and len(w) > 4 and n and ws[n - 1] in ("ww", "www") and ws[n + 1:n + 2] == ["dot"]:
        return ["dot", w[3:]]
    return [w]


def address_runs(ws: list[str]) -> list[tuple[int, int, str]]:
    """The stretches of the words that spell an address, as (start, end, written): a word, then a sign's word and a
    word, again and again ("sam at example dot fr"), with a "dot" before a domain's ending among them. Only those
    words are written as one ("my email is sam at example dot fr": the first three stay words; review 2026-11-22)."""
    runs, i = [], 0
    while i < len(ws):
        if ws[i] in SIGNS:                          # an address begins with a word
            i += 1
            continue
        j = i + 1
        while j + 1 < len(ws) and ws[j] in SIGNS and ws[j + 1] not in SIGNS:
            j += 2
        start = i
        if "at" in ws[i:j]:                         # one "at" at most: the name before the last one ("email me at
            k = i + max(n for n, w in enumerate(ws[i:j]) if w == "at")      # sam at example dot net"), unless
            start = k - 1 if ws[k - 1] not in NOT_NAMES else k + 1         # that is a common word ("visit us at …")
        run = ws[start:j]
        if run and run[0] not in SIGNS and any(a == "dot" and b in DOMAINS for a, b in zip(run, run[1:])):
            written = "".join(SIGNS.get(w, w) for w in run)
            if start and ws[start - 1] in ("ww", "www") and "@" not in written and (not runs or runs[-1][1] < start):
                start, written = start - 1, "www." + written    # its dot not written ("Type www google.com")
            runs.append((start, j, written))
            i = j
        else:
            i += 1
    return runs


def address(ws: list[str]) -> str | None:
    """The first address the words say ("www dot google dot com" is www.google.com, "sam at example dot fr"
    sam@example.fr, "github dot com slash rabs" github.com/rabs), or None."""
    runs = address_runs(www(ws))
    return runs[0][2] if runs else None


def with_addresses(ws: list[str]) -> list[str]:
    """The words, each address they say as one word, written (address_runs)."""
    ws = www(ws)
    out, at = [], 0
    for i, j, written in address_runs(ws):
        out += ws[at:i] + [written]
        at = j
    return out + ws[at:]


def spoken_text(ws: list[str], capital: bool) -> str:
    """The words as text, punctuation said as words written as signs ("hello comma world period" is "hello, world."),
    "i" as "I"; a capital letter where a sentence begins after . ? ! or a line break, and on the first word with
    `capital`. An address said in them is written as one (with_addresses), and never given a capital."""
    ws = with_addresses(ws)
    out, i, cap = "", 0, capital
    while i < len(ws):
        sign = next(((p, s) for p, s in PUNCTUATION if tuple(ws[i:i + len(p)]) == p), None)
        if sign:
            out = out.rstrip(" ") + sign[1]
            i += len(sign[0])
            cap = sign[1][-1] in ENDS
            continue
        w = ws[i]
        w = "I" + w[1:] if w == "i" or w.startswith("i'") else w
        if cap:
            w = w if set(w) & set(".@/") else w[:1].upper() + w[1:]
            cap = False
        out += ("" if not out or out[-1] == "\n" else " ") + w
        i += 1
    return out


def builtin_words(heard: list[str]) -> str:
    """Which of typing by voice's own phrases the words are: "type" ("type …"), "go" ("go to …"), "delete" ("delete
    that"), "start" or "stop" (dictation); "" for none. The phrases a word off are taken too ("start dictating")."""
    if len(heard) >= 2 and heard[0] in ("type", "pe"):     # "pe": the recogniser's "type" after the wake phrase,
        return "type"                                      # 5 times of 8 (owner, board 2026-11-22/23)
    if len(heard) >= 3 and heard[:2] == ["go", "to"]:
        return "go"
    said = "".join(heard)
    for kind, phrase in (("delete", "deletethat"), ("start", "startdictation"), ("stop", "stopdictation")):
        if len(heard) <= 3 and similar(said, phrase) >= 0.85:
            return kind
    return ""


class Actions:
    """What the listener does with what it hears: the chime, the command or the question, the notifications, the
    status file. `launch`, `notify`, `chime` and `hush` are the functions above outside the tests. `kind` is what the
    last wake phrase asked for: "command" (the commands' phrase) or "ask" (the Assistant's). A wake phrase stops an
    answer being read aloud (`interrupted`): said for that, it needs nothing after it, and a miss is not shown.
    `keys` types and presses keys (keys() outside the tests). Typing by voice is built in, before the commands: "type
    …" types the rest, "go to …" opens an address, "delete that" takes back what was typed last, and "start
    dictation" types every sentence after it, without a wake phrase, until "stop dictation" (or a wake phrase, or a
    minute without a word: Listener)."""

    def __init__(self, cfg: dict, launch=launch, notify=notify, chime=chime, status=None, hush=lambda: hush(0.5),
                 reading=lambda: held(SPEAKING), keys=keys):
        self.cfg = cfg
        self.launch, self.notify, self.chime, self.hush, self.reading, self.keys = launch, notify, chime, hush, reading, keys
        self.status = status or (lambda **kw: None)
        self.sound = next((c for c in CHIMES if Path(c).exists()), "")
        self.kind = "command"
        self.interrupted = False
        self.question: list[str] = []      # the words of a question so far (it is asked after a pause: Listener)
        self.commands_spotted = False      # the commands' phrase was spotted inside this question's session
        self.dictating = False
        self.typed: list[tuple[int, str]] = []   # each piece typed, the last last ("delete that"): its characters, and
                                                 # the tail before it (put back when it is taken back)
        self.tail = ""                     # the last character dictation typed: a space or a capital comes next

    def kind_of(self, spotted: str) -> str:
        """Which phrase the spotter heard (it gives the phrase back, as its word pieces spell it): "command", "ask"
        (the board's Assistant) or "ask:<name>" (an online one, "hey <name>")."""
        heard = words(spotted)
        if heard == words(self.cfg["wake"]):    # (an online one named "computer" does not take the commands' phrase)
            return "command"
        if self.cfg.get("assistant") and heard == words(self.cfg["assistant"]):
            return "ask"
        for name in self.cfg.get("online", []):
            if heard == words(f"hey {name}"):
                return f"ask:{name}"
        return "command"

    def phrase(self) -> str:
        if self.kind.startswith("ask:"):
            return f"hey {self.kind[4:]}"
        return self.cfg["assistant"] if self.kind == "ask" else self.cfg["wake"]

    def woke(self, kind: str = "command", new: bool = True) -> None:
        """The wake phrase was spotted: `new` when it opens a session (not said again inside one)."""
        self.kind = kind
        self.interrupted = self.hush() or (self.interrupted and not new)
        if new:
            self.question = []
            self.commands_spotted = False
        print(f"wake phrase heard: {self.phrase()!r}" + (" (the answer being read stopped)" if self.interrupted else ""),
              flush=True)
        self.chime(self.sound)
        self.status(state="awake")

    def command_words(self, text: str, first: bool) -> tuple[list[str] | None, bool]:
        """The words that can hold the command, and whether they are sure: in the first sentence (it began with the
        pre-roll) those after the wake phrase, None while it is not found there, sure when the phrase was found as
        written; in a later one, all but a wake phrase it begins with (a stray spot of the phrase inside a later
        sentence cuts nothing: review 2026-11-18), sure."""
        heard = words(text)
        if not first:
            return lead_wake(heard, self.phrase()), True
        cut = cut_at_wake(heard, self.phrase())
        if cut is None:
            return None, False
        at = cut[0]
        # "type", or "pe" (the recogniser's "type" there: builtin_words), taken into the phrase written close: "hey
        # kubi pe" comes closer to "hey cubie" than "hey kubi" does. Given back, unless the phrase itself ends so
        # ("hey ho pe" for "hey hope", "proto type"): which one it is cannot be told then, and such a phrase is left as
        # it was before (reviews 2026-11-23: closeness rules misread one-word and long phrases). Not when only the
        # phrase's end was caught (no stretch ends at the cut): those words are its end.
        if (at and heard[at - 1] in ("pe", "type")
                and (start := phrase_start(heard, self.phrase(), at)) is not None and start < at - 1
                and not "".join(words(self.phrase())).endswith(heard[at - 1])):
            at -= 1                         # (start < at - 1: "pe" alone taken for the phrase, "peep": review)
        return heard[at:], cut[1]

    def early(self, text: str, first: bool) -> bool:
        """What is heard so far, before the sentence ends: a command whose phrase it holds word for word runs at once,
        unless a longer command's phrase holds that one with more words after it ("volume up" waits while there is a
        "turn volume up to max"). Kroko writes the last word up to 1.7 s after it is said, and the sentence ends 0.8 s
        after that (board, 2026-11-18: "open firefox" whole 0.45 s after the voice stopped, the end 1.75 s after).
        Exact phrases only, found by plain comparison: this runs at every new word. Not before the wake phrase is
        found as written: while it is only close, it may be "my computer" in the pre-roll, with the owner's own
        phrase still to come (the end of the sentence decides then, about 1.2 s later)."""
        if self.kind.startswith("ask") or self.dictating:     # a question, or dictation: whole when the sentence ends
            return False
        heard, sure = self.command_words(text, first)
        if not heard or not sure or builtin_words(unled(heard)):     # "type …" waits for the end of what it types
            return False
        phrases = [(c, say) for c in active(self.cfg) if c["run"].strip() and (say := words(c["say"]))]
        found = [(c, say) for c, say in phrases if (at := find(heard, say)) >= 0 and not negated(heard, at, say)]
        if not found:
            return False
        c, say = max(found, key=lambda f: len(f[1]))
        if any(len(other) > len(say) and holds(other, say) for _, other in phrases):
            return False
        self.ran(c, heard, 1.0)
        return True

    def ran(self, c: dict, heard: list[str], s: float) -> None:
        said = " ".join(heard)
        print(f"heard: {said!r}\n-> {c['say']!r} ({s:.2f}): {c['run']}", flush=True)
        self.launch(c["run"])
        self.notify(f"▶ {c['say']}", c["run"])
        self.status(state="listening", heard=said, ran=c["say"], score=round(s, 2))

    def type_text(self, text: str, what: str) -> None:
        """`text` typed where the cursor is; what typed it, shown as a command's run is."""
        if not text:
            return
        why = self.keys(type_lines(text))
        if why:
            print(f"could not type: {why}", flush=True)
            self.notify("Could not type", why)
            return
        self.typed.append((len(text), self.tail))
        self.tail = text[-1:]
        print(f"typed {len(text)} characters ({what})", flush=True)
        self.status(state="dictating" if self.dictating else "listening", heard=what, ran="type", score=None)

    def builtin(self, heard: list[str]) -> bool:
        """Typing by voice ("type …", "go to …", "delete that", "start dictation"): True when the words were one."""
        kind = builtin_words(heard)
        if kind == "type":
            said = heard[1:]
            if said[:1] == ["dot"] and (runs := address_runs(www(said[1:]))) and runs[0][0] == 0:
                said = said[1:]             # "www" not written, its "dot" was: "type dot google dot com" (the owner's
            self.type_text(spoken_text(said, capital=False), "type")   # voice, board 2026-11-23): google.com
        elif kind == "go":
            # an address said ("go to lemonde dot fr") opens; anything else is searched for, never guessed into a site
            # of its own ("go to my bank" is not mybank.com, a stranger's: review 2026-11-22)
            site, said = address(heard[2:]), " ".join(heard[2:])
            if site:
                line, shown = f"xdg-open {shlex.quote(site if re.match(r'[a-z]+://', site) else 'https://' + site)}", site
            elif shutil.which("firefox"):
                line, shown = f"firefox --search {shlex.quote(said)}", f"search for “{said}”"
            else:
                line, shown = f"xdg-open {shlex.quote('https://duckduckgo.com/?q=' + urllib.parse.quote(said))}", f"search for “{said}”"
            print(f"heard: {' '.join(heard)!r}\n-> {line}", flush=True)
            self.launch(line)
            self.notify(f"▶ go to {site or said}", shown)
            self.status(state="listening", heard=" ".join(heard), ran="go to", score=None)
        elif kind == "delete":
            self.take_back()
        elif kind == "start":
            self.dictating, self.tail = True, ""
            print("dictation on", flush=True)
            self.notify("Dictation on", "What you say is typed where the cursor is. Say “stop dictation” when done.")
            self.status(state="dictating", heard=" ".join(heard), ran="start dictation", score=None)
        elif kind == "stop":
            self.stop_dictation("")
        else:
            return False
        return True

    def take_back(self) -> None:
        if not self.typed:
            self.notify("Nothing to delete", "Nothing was typed by voice since the listener started.")
            return
        n, self.tail = self.typed.pop()
        why = self.keys(["key " + " ".join(["backspace"] * n)])
        print(f"took back {n} characters" + (f": {why}" if why else ""), flush=True)

    def dictate(self, text: str) -> None:
        """A sentence said while dictating: typed (with a space before it, and a capital where a sentence begins),
        unless it is "stop dictation", "delete that", or the words of a typing key's command exactly ("press enter":
        DICTATION_KEYS; other commands' words are typed: "pause" said in a sentence of its own is a word here).
        Punctuation said alone ("new line", "period") is typed, not run, so what comes after it is spaced right."""
        heard = words(text)
        if not heard:
            return
        kind = builtin_words(heard)
        if kind in ("stop", "delete") and len(heard) <= 3:
            self.stop_dictation("") if kind == "stop" else self.take_back()
            return
        typed = spoken_text(heard, capital=self.tail in ("", *ENDS))
        if re.search(r"[A-Za-z0-9]", typed):
            exact = [c for c in active(self.cfg) if c["run"].startswith("a7a-voice key ")
                     and c["run"].removeprefix("a7a-voice key ").strip() in DICTATION_KEYS and words(c["say"]) == heard]
            if exact:
                self.ran(exact[0], heard, 1.0)
                return
        if self.tail and self.tail not in " \n" and typed[:1] not in ",.?!:;\n":
            typed = " " + typed
        self.type_text(typed, "dictation")

    def stop_dictation(self, why: str) -> None:
        if not self.dictating:
            return
        self.dictating = False
        print(f"dictation off{f' ({why})' if why else ''}", flush=True)
        self.notify("Dictation off", why.capitalize() if why else "")
        self.status(state="listening")

    def sentence(self, text: str, first: bool) -> bool:
        """A sentence after (or with) the wake phrase. True when it is dealt with (a command ran, or the miss was
        reported); False when it held nothing yet: nothing after the wake phrase (or the phrase not found in it), or a
        hesitation only ("um", "okay"), and the command may come in the next one; or a question's words, which may go
        on in the next one (asked after a pause: ask). Only the words after the phrase are printed, kept or shown."""
        if self.dictating:
            self.dictate(text)
            return True
        heard, _ = self.command_words(text, first)
        if not heard or all(w in HESITATIONS for w in heard):
            return False
        if self.kind.startswith("ask"):
            if self.commands_spotted and (inside := phrase_inside(heard, self.cfg["wake"])) is not None:
                # "what time is it" [0.6 s] "hey computer, mute": one sentence for the recogniser, the pause too short
                # to end it; the spotter heard the commands' phrase inside the session, and it is written here after
                # the question's words: the question goes, what follows the phrase is a command (2026-11-24). Not on
                # the words alone: "is hey computer a good name?" is a question
                self.question += heard[:inside[0]]
                if any(w not in HESITATIONS for w in self.question):
                    self.ask()
                else:                                   # "hey assistant, uh, hey computer": no question (review)
                    self.question = []
                self.kind = "command"
                rest = heard[inside[1]:]
                return self.sentence(" ".join(rest), False) if rest else False
            raw, said, wake = words(text), unled(heard), words(self.cfg["wake"])
            if (len(lead_wake(raw, self.cfg["wake"])) < len(raw) if not first else
                    len(wake) > 1 and similar("".join(said[:len(wake)]), "".join(wake)) >= WAKE_STRONG):
                # "… what time is it" [pause] "hey computer, mute": the question goes now, and this is a command
                # (the commands' phrase inside the Assistant's session is not spotted as a new one: review); also
                # right after the Assistant's phrase, in one sentence with it ("hey assistant" [1 s] "hey computer,
                # mute": the sentence's end is held for the voice: review 2026-11-23)
                if self.question:
                    self.ask()
                self.kind = "command"
                return self.sentence(text, first)
            self.question += heard
            return False
        # a command said word for word comes before typing by voice's own phrases (the owner's "go to sleep" is not a
        # search, as the panel's Test would not make it one: review 2026-11-22); both after a sound ("uh, type hello",
        # "okay, go to sleep": review)
        said = unled(heard)
        exact = next((c for c in active(self.cfg) if c["run"].strip() and words(c["say"]) in (heard, said)), None)
        if exact is not None:
            self.ran(exact, heard, 1.0)
            return True
        if self.builtin(said):
            return True
        match, s = best_match(heard, active(self.cfg), self.cfg["match"])
        if match is not None:
            self.ran(match, heard, s)
            return True
        said = " ".join(heard)
        # "with the wake phrase": in one breath with it, as the recogniser wrote it (a "pe" for "type" there is its
        # own, not a reset's in a later sentence). Only the words taken for the command are printed, as before: where
        # the phrase begins is not sure enough to print more (reviews 2026-11-23); they hold pre-roll only when
        # cut_at_wake took a pre-roll "my computer" for the phrase (an open matter of the cut, older than this)
        print(f"heard: {said!r}" + (" (with the wake phrase)" if first else "") + "\nno command matched", flush=True)
        # "hey computer, stop" after a reading stopped: done, as asked. Anything else is shown: a command said in one
        # breath with that phrase loses its start (the recogniser begins at the phrase then: Listener.feed)
        if not (self.interrupted and all(w in STOPS for w in heard)):
            self.notify("No command matched", f"Heard: “{said}”")
        self.status(state="listening", heard=said, ran="", score=None)
        return True

    def ask(self) -> None:
        """The question so far, to the Assistant: its own program, in a scope of its own like any command (starting the
        model and the answer take a minute or more, and the listener goes on listening meanwhile)."""
        if self.interrupted and all(w in STOPS for w in self.question):
            # "hey assistant, stop" while an answer is read: stopped, as asked; not a question (its answer would be
            # read aloud in turn: review 2026-11-19)
            print(f"heard: {' '.join(self.question)!r}: the reading stopped", flush=True)
            self.question = []
            self.status(state="listening", heard="", ran="", score=None)
            return
        question, self.question = " ".join(self.question), []
        to = self.kind[4:] if self.kind.startswith("ask:") else ""
        print(f"asked {to or 'the Assistant'}: {question!r}", flush=True)
        self.launch(f"{shlex.quote(str(Path(__file__).resolve()))} ask {f'--to {shlex.quote(to)} ' if to else ''}{shlex.quote(question)}")
        self.status(state="listening", heard=question, ran=to or "the Assistant", score=None)

    def gave_up(self) -> None:
        what = "question" if self.kind.startswith("ask") else "command"
        print(f"no {what} after the wake phrase", flush=True)
        if not self.interrupted:                # said to stop the reading: nothing more was wanted
            self.notify(f"No {what} heard", f"Say a {what} within {self.cfg['window']:.0f} s of “{self.phrase()}”.")
        self.status(state="listening")


class Listener:
    """The wake phrase and the command, from 0.1 s of audio at a time. `kws` and `asr` are sherpa-onnx's KeywordSpotter
    and OnlineRecognizer (endpoint detection on), or anything with their methods; `act` an Actions. The recogniser
    runs only from the wake phrase (fed the last PREROLL chunks first) until the command is dealt with."""

    def __init__(self, kws, asr, act: Actions, now=time.monotonic):
        self.kws, self.asr, self.act, self.now = kws, asr, act, now
        self.ks = kws.create_stream()
        self.rs = None
        self.recent: collections.deque = collections.deque(maxlen=PREROLL)
        self.woke_at = -1.0
        self.opened_at = -1.0               # when the session began (woke_at moves with the phrase said again)
        self.spoke_at = -1.0                # when the last new words came (a question ends after a pause)
        self.first = False                  # the sentence under way is the stream's first, which holds the pre-roll
        self.so_far = ""
        self.unspotted = 0
        self.levels: collections.deque = collections.deque(maxlen=300)
        self.quiet, self.sound = 0, False
        self.held = 0                       # chunks the sentence under way's ends have waited, in all
        self.chunk = 0                      # chunks heard
        self.paused = -1                    # the last chunk of the last pause (STILL_TALKING quiet chunks or more)
                                            # that voice came after
        self.voiced = -1                    # the last chunk with voice
        self.wrote = 0                      # the chunk the recogniser last wrote something new on
        self.began = None                   # the chunk the sentence under way's first word was written on (the
                                            # first one after the wake phrase in the stream's first sentence)
        self.spotted_at = 0                 # the chunk the wake phrase was spotted on (the stream's start)

    def gap(self) -> None:
        """The microphone has gone quiet (unplugged: microphone() yields None): a session under way ends now, its
        question asked, rather than whenever sound comes back (review 2026-11-19)."""
        if self.rs is None:
            return
        self.rs = None
        self.act.stop_dictation("no sound from the microphone")
        if self.act.question:
            self.act.ask()
        else:
            self.act.status(state="listening")

    def spotter(self, kws) -> None:
        """A new keyword spotter (the wake phrase changed)."""
        self.kws, self.ks, self.unspotted = kws, kws.create_stream(), 0

    def hushed(self, samples) -> bool:
        """The chunk is quiet, after sound: HUSH chunks within 6 dB of the room's own noise (the tenth percentile of
        the last 30 s) after one above it. Nobody is in the middle of a phrase then."""
        lv = level(samples)
        self.levels.append(lv)
        if lv < max(2 * sorted(self.levels)[len(self.levels) // 10], 1e-4):
            self.quiet += 1
            if self.quiet >= HUSH and self.sound:
                self.sound = False
                return True
        else:
            self.quiet, self.sound = 0, True
        return False

    def ended(self) -> bool:
        """The sentence under way has ended: the recogniser says so (0.8 s without a new letter written), unless it
        goes on in fact (goes_on) and there is voice it has not written yet: voice in the last STILL_TALKING chunks,
        or voice that came STILL_TALKING chunks or more after the last word written, WORD_LAG at most after it
        stopped (the recogniser writes late: the end came at "type www", the rest said, then the voice stopped, and
        the end was taken before the rest was written: review 2026-11-22). It waits LONGEST_HOLD at most. The recogniser is slow to write letters spelled out: "type double-u double-u double-u
        dot google dot com", said in one go, ended at "type WW" and the rest was lost; "hey cubie" ended while "type"
        was being said, and "ty" went with it ("pe hello world"; the owner's voice, board 2026-11-22: "Type
        www.google.com" whole with this). After a pause, the voice is a new sentence ("… see you" [1 s] "stop dictation"; "hey assistant, what
        time is it" [1.5 s] "hey computer, mute"): it ends where the recogniser says, as it did (review 2026-11-22)."""
        if not self.asr.is_endpoint(self.rs):
            return False
        unwritten = self.quiet < STILL_TALKING or (self.voiced - self.wrote >= STILL_TALKING
                                                   and self.chunk - self.voiced <= WORD_LAG)
        if unwritten and self.held < LONGEST_HOLD and self.goes_on():
            self.held += 1
            return False
        return True

    def goes_on(self) -> bool:
        """The voice heard now is the sentence's own (Listener.ended): no pause came after its first word was
        written. A pause before that is not between sentences: "hey cubie" [0.6 s] "type double-u double-u …" is one
        (review 2026-11-22); after it, the voice is a new sentence ("… see you" [1 s] "stop dictation"; "hey
        assistant, what time is it" [1.5 s] "hey computer, mute": the last word may be written in the pause, but the
        first was written before it). Not in a first sentence without the wake phrase written in it: its end is the
        recogniser's, as it was, and the next sentence is all command (held, the command went into it and was dropped
        with it: the owner's voice, board 2026-11-22). When nothing at all is written yet (the recogniser wrote nothing of
        the pre-roll at times), the words to come are all command now, as the next sentence's would be, and the stream
        goes on unreset: a reset in the voice cut "type" to "pe"."""
        text = self.asr.get_result(self.rs).strip()
        if not text:                        # nothing to put together wrongly
            self.first = False
            return True
        if self.first and self.act.command_words(text, True)[0] is None:
            return False
        return self.began is None or self.paused < self.began

    def fresh(self) -> None:
        """A new recogniser stream for the command, after a first sentence that held none of its own words (the wake
        phrase alone, or written past knowing: "Hey, Kyivi"), fed from just before the voice that came after the
        phrase: from 0.3 s before it, when a pause after the phrase has ended (the voice may be over again, and not
        written yet: "hey cubie" [0.6 s] "mute" [quiet]: review 2026-11-23); from where the phrase was spotted when
        there was voice after it without such a pause (one breath, or a gap under 0.5 s: about 0.4 s after the
        phrase's end, so none of it, though the command's start may be cut: "kyivi type hello" matched nothing, "pe
        hello" types: review); the last 0.3 s when nothing has been said since.
        A reset there, in the command being said, cut its start ("re bar" for "address bar", "pe" for "type"), and a
        stream run on unreset wrote nothing more of it at times; a fresh one wrote "Address bar" from wherever it
        began between the pause and the word (the owner's voice, board 2026-11-23). Its sentences are all command (not
        first)."""
        if self.paused >= self.spotted_at - 3:      # a pause after the phrase (one before it ends 0.9 s earlier or more)
            start = self.paused - 2
        elif self.voiced >= self.spotted_at - 2:    # voice since the phrase (its own ends about 4 chunks before)
            start = self.spotted_at
        else:
            start = self.chunk - 2
        start = max(start, self.chunk - len(self.recent) + 1)
        self.rs = self.asr.create_stream()
        for c in list(self.recent)[start - self.chunk - 1:]:
            self.rs.accept_waveform(RATE, c)
        while self.asr.is_ready(self.rs):
            self.asr.decode_stream(self.rs)
        self.held, self.wrote, self.began, self.so_far = 0, self.chunk, None, ""

    def said_words(self, text: str) -> bool:
        """The sentence under way holds a word said for its own sake: one after the wake phrase, but a hesitation ("hey
        cubie, uh" holds none); any word while dictating ("Okay." is typed: review 2026-11-22). A later sentence's wake
        phrase is the phrase said again ("hey cubie" [0.6 s] "type …" in an open session: review), the commands'
        inside the Assistant's too."""
        if self.first:
            heard = self.act.command_words(text, True)[0] or []
        else:
            heard = lead_wake(self.act.command_words(text, False)[0], self.act.cfg["wake"])
        return bool(heard) if self.act.dictating else any(w not in HESITATIONS for w in heard)

    def feed(self, samples) -> None:
        t = self.now()
        self.recent.append(samples)
        self.unspotted += 1
        quiet = self.quiet
        pause = self.hushed(samples)
        self.chunk += 1
        if not self.quiet:
            self.voiced = self.chunk
            if quiet >= STILL_TALKING:
                self.paused = self.chunk - 1
        if pause and self.rs is None:
            # a fresh spotter stream in every pause: one that has heard much else without its phrase spots it worse
            # (board 2026-11-18, synthetic voices: 1 in 5 against 4 and 5 in 5; resetting its search did not help)
            self.ks, self.unspotted = self.kws.create_stream(), 0
        elif self.rs is None and self.unspotted >= REFRESH:
            # no pause in 10 minutes (steady noise): a fresh stream all the same, given the last 2 s so a phrase being
            # said is not cut
            self.ks, self.unspotted = self.kws.create_stream(), 0
            for c in list(self.recent)[:-1]:
                self.ks.accept_waveform(RATE, c)
        self.ks.accept_waveform(RATE, samples)
        fed = False
        while self.kws.is_ready(self.ks):
            self.kws.decode_stream(self.ks)
            if spotted := self.kws.get_result(self.ks):
                self.kws.reset_stream(self.ks)
                self.unspotted = 0
                if self.act.dictating:              # a wake phrase ends dictation: a command or a question follows
                    self.act.stop_dictation("")
                    self.rs = None
                kind = self.act.kind_of(spotted)
                if self.rs is not None and kind != self.act.kind:
                    # the other phrase inside an open session ("my computer" in a question for the Assistant): the
                    # phrase that opened it decides what it is (review 2026-11-18). The commands' phrase inside a
                    # question is noted: written in the question's sentence as well, it ends the question there
                    # (Actions.sentence), and a command's wait then counts from it (2026-11-24)
                    print("the other wake phrase, inside the session: not taken", flush=True)
                    if kind == "command" and self.act.kind.startswith("ask"):
                        self.act.commands_spotted = True
                        self.woke_at = t
                    continue
                self.woke_at = self.spoke_at = t
                self.act.woke(kind, new=self.rs is None)
                if self.rs is None:
                    self.opened_at = t
                    self.rs = self.asr.create_stream()
                    # the pre-roll (this chunk included), unless the phrase stopped an answer being read: what came
                    # before it then was the speaker's ("… say hey computer, mute" must not mute: review 2026-11-19),
                    # so the recogniser starts here, and its first sentence is all command (no phrase to cut it at)
                    for c in [samples] if self.act.interrupted else self.recent:
                        self.rs.accept_waveform(RATE, c)
                    fed = True
                    self.first = not self.act.interrupted
                    self.so_far = ""
                    self.held, self.wrote, self.began = 0, self.chunk, None
                    self.spotted_at = self.chunk
        if self.rs is None:
            return
        if not fed:
            self.rs.accept_waveform(RATE, samples)
        while self.asr.is_ready(self.rs):
            self.asr.decode_stream(self.rs)
        so_far = self.asr.get_result(self.rs).strip()
        if so_far != self.so_far:
            self.so_far = so_far
            self.spoke_at = t
            self.wrote = self.chunk
            if self.began is None and self.said_words(so_far):
                # the command's first word: its own LONGEST_HOLD from here; the wait on the wake phrase alone spent it
                # (the recogniser wrote nothing for 2.4 s of "type double-u double-u", slowly said: the owner's voice, board
                # 2026-11-23, "type ww" at the cap)
                self.began, self.held = self.chunk, 0
            if so_far and self.act.early(so_far, self.first):
                self.rs = None
                return
        if self.ended():
            self.held = 0
            text = self.asr.get_result(self.rs).strip()
            self.so_far, self.began = "", None
            first, self.first = self.first, False
            if text and self.act.sentence(text, first):
                self.asr.reset(self.rs)
                if not self.act.dictating:          # dictation goes on in the same stream
                    self.rs = None
                return
            heard = self.act.command_words(text, True)[0] if first else None
            if first and (not heard or all(w in HESITATIONS for w in heard)):
                self.fresh()                        # nothing of its own written: the command, or question, is to come
            else:
                self.asr.reset(self.rs)             # (its words were taken: a question goes on; review 2026-11-23)
        if self.act.dictating:
            if t - self.spoke_at > DICTATION_IDLE:
                self.rs = None
                self.act.stop_dictation("a minute without a word")
            return
        if self.act.question:
            # a question goes out after ASK_PAUSE without a new word, or once it has run on for ASK_LONGEST (with what
            # is being said then), or when an answer begins to be read (its words are not the owner's: review); until
            # then the next sentence may still belong to it
            longest = t - self.opened_at > ASK_LONGEST
            if longest and self.so_far:
                self.act.sentence(self.so_far, self.first)
            if longest or (t - self.spoke_at >= ASK_PAUSE and not self.so_far) or self.act.reading():
                if self.act.question:
                    self.act.ask()
                if (self.act.commands_spotted and self.woke_at > self.spoke_at and not longest
                        and not self.act.reading()):
                    # the commands' phrase spotted after the question's last word, its own words not written yet
                    # (the recogniser writes up to 1.7 s late): the session goes on as a command's, its wait counted
                    # from that phrase (review 2026-11-24: the command was dropped without a word)
                    self.act.kind = "command"
                    return
                self.rs = None
            return
        if t - self.woke_at > self.act.cfg["window"] and not self.asr.get_result(self.rs).strip():
            self.rs = None
            self.act.gave_up()


# ---------------------------------------------------------------- the engine (in the venv)

def model_file(d: Path, part: str) -> str:
    """The model's `part` network: its int8 one when it has one."""
    found = sorted(d.glob(f"{part}*.int8.onnx")) or sorted(d.glob(f"{part}*.onnx"))
    if not found:
        raise FileNotFoundError(f"no {part} in {d}: set it up again")
    return str(found[0])


def spotter(cfg: dict):
    """sherpa-onnx's keyword spotter for the wake phrases (their pieces from the model's own sentencepiece model),
    which names the one it heard as those pieces spell it; with the online assistants' names it listens for, and
    why not for the others (keywords)."""
    import sentencepiece
    import sherpa_onnx
    d = MODELS / KWS[0]
    sp = sentencepiece.SentencePieceProcessor(model_file=str(d / "bpe.model"))
    known = {line.split()[0] for line in (d / "tokens.txt").read_text().splitlines() if line.strip()}
    lines, online, left = keywords(cfg, lambda phrase: sp.encode(" ".join(words(phrase)).upper(), out_type=str), known)
    for why in left:
        print(f"not listening for {why}", flush=True)
    KEYWORDS.parent.mkdir(parents=True, exist_ok=True)
    KEYWORDS.write_text("\n".join(lines) + "\n")
    ENGINE.update(engine="cpu", npu_error="")

    def cpu():
        return sherpa_onnx.KeywordSpotter(tokens=str(d / "tokens.txt"), encoder=model_file(d, "encoder"),
                                          decoder=model_file(d, "decoder"), joiner=model_file(d, "joiner"),
                                          keywords_file=str(KEYWORDS), keywords_threshold=cfg["sensitivity"],
                                          num_threads=1, provider="cpu")
    if cfg.get("npu"):
        try:
            kws = Guarded(npu_spotter(d, cfg["sensitivity"]), cpu)
            ENGINE["engine"] = "npu"
            return kws, online, left
        except Exception as e:                       # anything at all: the CPU's spotter instead, and why
            ENGINE["npu_error"] = f"the NPU spotter could not start ({e}): the CPU's is listening"
            print(ENGINE["npu_error"], flush=True)
    return cpu(), online, left


def npu_spotter(d: Path, threshold: float):
    """The spotter with its encoder on the NPU, from the files in NPU (the network, its CPU part's weights, the code),
    the keywords and tokens as the CPU's spotter has them."""
    if str(NPU) not in sys.path:
        sys.path.insert(0, str(NPU))
    import kaldi_native_fbank  # noqa: F401  (its features: here, not first in the listener's create_stream)
    import numpy as np
    import npu_kws
    import npunet
    k = npu_kws.Spotter(npunet.Net(NPU / "kws_encoder_fp16_a733.nb"), NPU / "kws_cpu.npz", d / "tokens.txt",
                        KEYWORDS, keywords_threshold=threshold)
    st = k.create_stream()                           # once through, on a second of silence: it runs, and sanely
    st.accept_waveform(RATE, np.zeros(RATE, np.float32))
    runs = 0
    while k.is_ready(st):
        k.decode_stream(st)
        runs += 1
    if not runs or not all(np.isfinite(x).all() for x in k.states):
        raise OSError("the NPU's encoder gave no usable output on silence")
    k.reset_stream(st)
    return k


class Guarded:
    """The NPU's spotter with the CPU's behind it: the first error from the NPU side (a failed or timed-out run)
    hands the listening to the CPU's spotter for good, said in ENGINE and printed; the audio of that moment is
    lost, the listener goes on. Streams are wrapped so the Listener's stream follows the swap."""

    class Stream:
        def __init__(self, owner):
            self.owner, self.inner, self.gen = owner, owner.k.create_stream(), owner.gen

        def accept_waveform(self, rate, samples):
            self.owner.run(lambda: self.current().accept_waveform(rate, samples))

        def current(self):
            if self.gen != self.owner.gen:           # made before a swap: a fresh stream of the CPU's
                self.inner, self.gen = self.owner.k.create_stream(), self.owner.gen
            return self.inner

    def __init__(self, npu, make_cpu):
        self.k, self.make_cpu, self.gen = npu, make_cpu, 0

    def run(self, f, default=None):
        try:
            return f()
        except Exception as e:
            if self.gen:                             # the CPU's own error: the listener's to handle
                raise
            ENGINE.update(engine="cpu", npu_error=f"the NPU spotter failed ({e}): the CPU's is listening")
            print(ENGINE["npu_error"], flush=True)
            self.k, self.gen = self.make_cpu(), 1
            return default

    def create_stream(self):
        return Guarded.Stream(self)

    def is_ready(self, s):
        return self.run(lambda: self.k.is_ready(s.current()), False)

    def decode_stream(self, s):
        self.run(lambda: self.k.decode_stream(s.current()))

    def get_result(self, s):
        return self.run(lambda: self.k.get_result(s.current()), "")

    def reset_stream(self, s):
        self.run(lambda: self.k.reset_stream(s.current()))


def recogniser():
    import sherpa_onnx
    d = MODELS / ASR[0]
    return sherpa_onnx.OnlineRecognizer.from_transducer(
        tokens=str(d / "tokens.txt"), encoder=model_file(d, "encoder"), decoder=model_file(d, "decoder"),
        joiner=model_file(d, "joiner"), num_threads=1, sample_rate=RATE, feature_dim=80, decoding_method="greedy_search",
        provider="cpu", enable_endpoint_detection=True, rule1_min_trailing_silence=2.4, rule2_min_trailing_silence=0.8,
        rule3_min_utterance_length=15)


def voice_engine():
    """sherpa-onnx's Supertonic, on two threads (four or eight were no quicker: board 2026-11-19)."""
    import sherpa_onnx
    d = MODELS / TTS[0]
    return sherpa_onnx.OfflineTts(sherpa_onnx.OfflineTtsConfig(model=sherpa_onnx.OfflineTtsModelConfig(
        supertonic=sherpa_onnx.OfflineTtsSupertonicModelConfig(
            duration_predictor=model_file(d, "duration_predictor"), text_encoder=model_file(d, "text_encoder"),
            vector_estimator=model_file(d, "vector_estimator"), vocoder=model_file(d, "vocoder"),
            tts_json=str(d / "tts.json"), unicode_indexer=str(d / "unicode_indexer.bin"),
            voice_style=str(d / "voice.bin")),
        num_threads=2, provider="cpu")))


def generation(voice: str):
    import sherpa_onnx
    g = sherpa_onnx.GenerationConfig()
    g.sid, g.num_steps, g.speed = VOICES.index(voice), SPEECH_STEPS, 1.0
    g.extra = {"lang": "en"}
    return g


def trimmed(x, rate: int):
    """A piece's samples without most of the quiet the model puts around it: SPEECH_LEAD s of it kept before the
    voice, 0.15 s after."""
    import numpy as np
    loud = np.flatnonzero(np.abs(x) > 0.01)
    if not len(loud):
        return x[:0]
    return x[max(0, loud[0] - int(SPEECH_LEAD * rate)):loud[-1] + 1 + int(0.15 * rate)]


def player(rate: int) -> list[str]:
    """pw-cat playing raw samples from its stdin, one stream named "Assistant" in the sound settings; for the tests,
    the command line in A7A_VOICE_PLAYER ({rate} in it is the sample rate)."""
    other = os.environ.get("A7A_VOICE_PLAYER")
    if other:
        return shlex.split(other.replace("{rate}", str(rate)))
    return ["pw-cat", "--playback", "--raw", "--format", "f32", "--rate", str(rate), "--channels", "1",
            "-P", '{ application.name = "Assistant" media.name = "Answer read aloud" }', "-"]


def feed(pipe, pieces: queue.Queue) -> None:
    """Writes the pieces' samples to the player as it takes them, until None (then the end); once the player is gone,
    takes the rest and drops it, so whoever puts them never waits on a full queue."""
    ended = False
    try:
        while (b := pieces.get()) is not None:
            pipe.write(b)
        ended = True
        pipe.close()
    except OSError:
        while not ended and pieces.get() is not None:
            pass


def read_aloud(pieces: list[str], voice: str, since: float | None = None) -> int:
    """The pieces read aloud, in the venv: each made while the one before plays (the model lets go of Python's lock
    while it works, so the thread that feeds the player keeps up: board 2026-11-19), into one stream; at most two
    pieces ahead of the player (the rest would be made for nothing when it is stopped). Ends early after a hush that
    came after `since`."""
    import numpy as np
    tts, gen = voice_engine(), generation(voice)
    out: queue.Queue = queue.Queue(maxsize=2)
    p = feeder = None
    stopped = False
    with tempfile.TemporaryFile() as err:          # what the player says, read when it has ended
        try:
            for piece in pieces:
                audio = tts.generate(piece, gen)
                if since is not None and hushed_since(since):
                    if p is not None:
                        p.terminate()                   # what it has not played yet goes with it
                    stopped = True
                    break
                if p is not None and p.poll() is not None:
                    break
                if not len(audio.samples):
                    print(f"the voice made nothing of {piece!r}", flush=True)
                    continue
                if p is None:
                    try:
                        p = subprocess.Popen(player(audio.sample_rate), stdin=subprocess.PIPE,
                                             stdout=subprocess.DEVNULL, stderr=err)
                    except FileNotFoundError:
                        raise RuntimeError("pw-cat is missing: install pipewire-utils") from None
                    feeder = threading.Thread(target=feed, args=(p.stdin, out), daemon=True)
                    feeder.start()
                out.put(trimmed(np.asarray(audio.samples, dtype=np.float32), audio.sample_rate).tobytes())
        finally:
            if p is not None:
                out.put(None)
                feeder.join()
        if p is None or p.wait() == 0 or stopped:
            return 0
        err.seek(0)
        said = err.read().decode(errors="replace").strip().splitlines()
    raise RuntimeError(f"the player stopped (exit {p.returncode}){': ' + said[-1] if said else ''}")


def microphone(mic: str, quiet: float = QUIET, silent=lambda gone: None):
    """The microphone, 0.1 s at a time, as float samples: pw-record at 16 kHz mono (PipeWire resamples). Not a byte
    for `quiet` seconds (the microphone unplugged: the stream waits, unlinked) is told to `silent(True)`, and the
    first sound after it to `silent(False)`; the listener says so and waits on, for the microphone to come back
    (exiting instead met systemd's start limit within two minutes, and left it off for good: review 2026-11-18).
    While there is no sound, None every `quiet` seconds, so the listener still reads new settings (a new "mic")."""
    import numpy as np
    argv = ["pw-record", "--rate", str(RATE), "--channels", "1", "--format", "s16", "--raw", "--latency", "100ms"]
    if mic:
        argv += ["--target", mic]
    try:
        p = subprocess.Popen([*argv, "-"], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except FileNotFoundError:
        raise RuntimeError("pw-record is missing: install pipewire-utils") from None
    fd, buf, gone = p.stdout.fileno(), bytearray(), False
    try:
        while True:
            if not select.select([fd], [], [], quiet)[0]:
                if not gone:
                    gone = True
                    silent(True)
                yield None
                continue
            b = os.read(fd, 1 << 16)
            if not b:
                return
            if gone:
                gone = False
                silent(False)
            buf += b
            while len(buf) >= CHUNK * 2:
                yield np.frombuffer(bytes(buf[:CHUNK * 2]), dtype=np.int16).astype(np.float32) / 32768
                del buf[:CHUNK * 2]
    finally:
        p.terminate()
        try:
            p.wait(timeout=3)
        except subprocess.TimeoutExpired:
            p.kill()


def in_venv() -> bool:
    return Path(sys.prefix).resolve() == VENV.resolve()


def into_venv(argv: list[str]) -> None:
    """Runs this command again with the venv's Python, where sherpa-onnx is."""
    py = VENV / "bin" / "python"
    if not in_venv():
        os.execv(str(py), [str(py), str(Path(__file__).resolve()), *argv])


def listen() -> int:
    if not ready():
        write_json(STATUS, {"state": "error", "error": "not set up: press Set up in the panel's Voice tab", "at": time.time()})
        print("not set up: a7a-voice setup", flush=True)
        return 0                                      # no restart loop: nothing would change until setup runs
    into_venv(["listen"])

    def report(**kw):
        cur.update(kw, at=time.time())
        write_json(STATUS, cur)

    def stop(*_):
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, stop)
    seen = mtime(CONFIG), mtime(PANEL)      # before the reading: a save made while the models load is seen at once
    cfg, problem = load_config()
    cfg["online"] = online_names()
    if problem:
        cfg["commands"] = []                # not the built-in ones, which may hold commands the owner removed
    # "online": the online assistants it listens for ("hey <name>"), "left_out": why not for the others
    # "wake", "assistant": the two phrases it wakes for (the old ones when it could not take a new one; the panel
    # tells a refused phrase by them, 2026-11-24)
    # "read": the settings file's time when it was last read (status() compares the phrases only then: review)
    cur = {"state": "starting", "wake": cfg["wake"], "assistant": cfg["assistant"], "read": seen[0], "pid": os.getpid(),
           "heard": "", "ran": "",
           "error": problem and f"{problem}: no commands until the settings are saved again", "online": [], "left_out": []}
    report()
    typist = Typist()                       # the keyboard typing by voice uses, kept for the listener's life
    if why := typist.start():               # now: the desktop takes about a second to see a new keyboard
        print(f"no typing by voice: {why}", flush=True)
    act = Actions(cfg, status=report, keys=typist.send)
    try:
        kws, online, left = spotter(cfg)
        listener = Listener(kws, recogniser(), act)
        print(f"listening for {heard_as(wake_phrases(dict(cfg, online=online)))}, {len(active(cfg))} commands", flush=True)
        report(state="listening", online=online, left_out=left, **ENGINE)
        quiet = [False, ""]                 # the microphone silent, and the error to show again once it is back

        def silent(gone: bool) -> None:
            quiet[0] = gone
            if gone:
                quiet[1] = cur["error"]
                print("no sound from the microphone", flush=True)
                report(error=f"no sound from the microphone for {QUIET:.0f} s: is it plugged in?")
            else:
                print("the microphone is back", flush=True)
                report(error=quiet[1])

        def settled(error: str) -> None:
            """A reading of the settings went well, or `error`: shown now, or (the microphone's error first) when the
            microphone is back."""
            if quiet[0]:
                quiet[1] = error
            else:
                report(error=error)

        for n, samples in enumerate(microphone(cfg["mic"], silent=silent)):
            if samples is None:
                listener.gap()
            else:
                listener.feed(samples)
                if n % 10:
                    continue
            if any(cur.get(k) != v for k, v in ENGINE.items()):   # the NPU's spotter handed over to the CPU's
                report(**ENGINE)
            if (m := (mtime(CONFIG), mtime(PANEL))) == seen:
                continue
            seen = m
            new, problem = load_config()
            new["online"] = online_names()
            if problem:                             # a file that does not parse: the last good settings stay
                print(problem, flush=True)
                settled(problem)
                continue
            if new["mic"] != cfg["mic"]:
                print("the microphone setting changed: restarting", flush=True)
                return 1                            # systemd starts the listener again, on the new source
            error = ""
            if (wake_phrases(new) != wake_phrases(cfg) or new["sensitivity"] != cfg["sensitivity"]
                    or new["npu"] != cfg["npu"]):
                try:
                    kws, online, left = spotter(new)
                    listener.spotter(kws)
                    report(online=online, left_out=left, **ENGINE)
                except Exception as e:              # a phrase the spotter cannot take: the ones it has stay
                    error = f"{e}; still listening for {heard_as(wake_phrases(cfg))}"
                    print(error, flush=True)
                    new["wake"], new["assistant"], new["sensitivity"] = cfg["wake"], cfg["assistant"], cfg["sensitivity"]
                    new["online"], new["npu"] = cfg.get("online", []), cfg["npu"]
            cfg = act.cfg = new
            print(f"settings reloaded: {heard_as(wake_phrases(dict(cfg, online=cur['online'])))}, {len(active(cfg))} commands", flush=True)
            report(wake=cfg["wake"], assistant=cfg["assistant"], read=seen[0])
            settled(error)
        report(state="error", error="the microphone stream ended")
        print("the microphone stream ended", flush=True)
        return 1
    except SystemExit:
        report(state="off")
        return 0
    except Exception as e:                              # shown in the panel, and systemd tries again
        report(state="error", error=str(e))
        print(f"failed: {e}", flush=True)
        return 1
    finally:
        typist.close()


def engine_problem() -> str:
    """Why the venv's packages do not import, or ""."""
    try:
        import numpy, sentencepiece, sherpa_onnx  # noqa: F401
    except Exception as e:                  # a damaged file in the venv raises others than ImportError (review)
        return f"{type(e).__name__}: {e}"
    return ""


def check(part: str = "listen") -> int:
    """Both models load (with the default wake phrase: a phrase of the owner's that the spotter refuses is the
    listener's error to report, not a failed setup); or the voice loads and says a word (into nothing). Exit 3 when
    the speech engine itself does not load: the venv is at fault then, not the models."""
    into_venv(["check"] + (["speak"] if part == "speak" else []))
    if problem := engine_problem():
        print(f"the speech engine does not load: {problem}")
        return 3
    t = time.time()
    if part == "speak":
        if not len(voice_engine().generate("Ready.", generation(VOICES[0])).samples):
            raise RuntimeError("the voice made no sound")
        print(f"the voice loads and speaks ({time.time() - t:.1f} s)")
        return 0
    spotter(clean(None))
    recogniser()
    print(f"both models load ({time.time() - t:.1f} s)")
    return 0


