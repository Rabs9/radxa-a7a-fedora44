From: a7a-fedora
Subject: [PATCH] sunxi-drm: trace framebuffer and GEM lifetimes; /proc/sunxi-drm/fault-test (debug aids for the DE IOMMU fault)

pr_info lines (visible with kernel.printk console level 7, or in dmesg/journal) for every framebuffer
create/destroy and every GEM free on the sunxi-drm device: device address, size, dumb or imported (with the
dma-buf exporter's name) and the process doing it. That identifies who unmapped a buffer the display engine was
still scanning out. The DE frame-trace ring (/proc/sunxi-drm/debug) gains the fb id and its fault-time dump runs
on the unbound workqueue so it is not stuck behind the faulting CPU.

/proc/sunxi-drm/fault-test (root, write-only): "punch" unmaps the first page of the buffer last committed on
DE-0 plane 0 so the DE faults on purpose, "heal" maps it back. Used to prove the fault recovery of the next patch.
The DRM side of the IOMMU unmap watch: any unmap overlapping a buffer committed to a DE plane in the last 64
updates (and not yet released through a framebuffer destroy) is reported by the IOMMU driver with a stack trace.
---
diff --git a/drivers/drm/sunxi_drm_debug.c b/drivers/drm/sunxi_drm_debug.c
index f47d295..3e2653c 100644
--- a/drivers/drm/sunxi_drm_debug.c
+++ b/drivers/drm/sunxi_drm_debug.c
@@ -26,6 +26,9 @@
 #include <linux/seq_file.h>
 #include <linux/types.h>
 #include <sunxi-iommu.h>
+#include <linux/iommu.h>
+#include <linux/proc_fs.h>
+#include <linux/uaccess.h>
 #include "sunxi_drm_debug.h"
 
 typedef struct trace_buf_info {
@@ -42,6 +45,7 @@ typedef struct trace_buf_info {
 
 	// drm drm_framebuffer unmap record
 	struct drm_framebuffer *fb;
+	u32 fb_id;
 	int name;
 	u64 unmap_ts;
 	u32 mapped;
@@ -92,8 +96,8 @@ static void  __maybe_unused sunxidrm_debug_record_exception(void)
 		spin_unlock_irqrestore(&frame->lock, flags);
 	}
 
-	// schedule dprintk task
-	schedule_work(&dbgdat.work);
+	// schedule dprintk task (unbound: the faulting CPU may be stuck in the IRQ storm)
+	queue_work(system_unbound_wq, &dbgdat.work);
 }
 
 static void sunxidrm_debug_work_func(struct work_struct *work)
@@ -115,11 +119,11 @@ static void sunxidrm_debug_work_func(struct work_struct *work)
 		for (i = 0; i < FRAME_TRACE_LEN; i++) {
 			trace_buf_t *tbuf = &frame->data[i];
 			pr_err("[%02d] %d ts %lld plane %d line %d format 0x%08x %dx%d %d-%d-%d %d-%d-%d %pad "
-			       "map:%d "
+			       "fb:%u map:%d "
 			       "unmap-ts:%lld\n",
 			       i, tbuf->seq, tbuf->update_ts, tbuf->plane, tbuf->cur_line, tbuf->format, tbuf->width,
 			       tbuf->height, tbuf->pitches[0], tbuf->pitches[1], tbuf->pitches[2], tbuf->offsets[0],
-			       tbuf->offsets[1], tbuf->offsets[2], &tbuf->dma_addr, tbuf->mapped, tbuf->unmap_ts);
+			       tbuf->offsets[1], tbuf->offsets[2], &tbuf->dma_addr, tbuf->fb_id, tbuf->mapped, tbuf->unmap_ts);
 		}
 		spin_unlock_irqrestore(&frame->lock, flags);
 	}
@@ -149,12 +153,12 @@ int sunxidrm_debug_show(struct seq_file *sfile, void *offset)
 			trace_buf_t *tbuf = &frame->data[i];
 			seq_printf(sfile,
 				   "[%02d] %d ts %lld plane %d line %d format 0x%08x %dx%d %d-%d-%d %d-%d-%d %pad "
-				   "map:%d "
+				   "fb:%u map:%d "
 				   "unmap-ts:%lld\n",
 				   i, tbuf->seq, tbuf->update_ts, tbuf->plane, tbuf->cur_line, tbuf->format,
 				   tbuf->width, tbuf->height, tbuf->pitches[0], tbuf->pitches[1], tbuf->pitches[2],
-				   tbuf->offsets[0], tbuf->offsets[1], tbuf->offsets[2], &tbuf->dma_addr, tbuf->mapped,
-				   tbuf->unmap_ts);
+				   tbuf->offsets[0], tbuf->offsets[1], tbuf->offsets[2], &tbuf->dma_addr, tbuf->fb_id,
+				   tbuf->mapped, tbuf->unmap_ts);
 		}
 		seq_putc(sfile, '\n');
 
@@ -163,6 +167,101 @@ int sunxidrm_debug_show(struct seq_file *sfile, void *offset)
 	return 0;
 }
 
+/*
+ * a7a-fedora: /proc/sunxi-drm/fault-test (root, write-only), to provoke a display-engine IOMMU fault on purpose
+ * and prove the recovery path (docs/DE-IOMMU-STORM-2026-09-07.md) without waiting for the real race:
+ *   punch   unmap the first page of the framebuffer last committed on DE-0's plane 0 (the DE faults on its next
+ *           frame of that buffer: the fault callback stops the DE, the next flush restarts it)
+ *   heal    map that page back
+ */
+static struct {
+	dma_addr_t iova;
+	phys_addr_t phys;
+} fault_test;
+
+static ssize_t sunxidrm_fault_test_write(struct file *file, const char __user *ubuf, size_t len, loff_t *off)
+{
+	char cmd[16] = { 0 };
+	frame_trace_t *frame;
+	unsigned long flags;
+	dma_addr_t iova = 0;
+	int ret;
+
+	if (len >= sizeof(cmd))
+		return -EINVAL;
+	if (copy_from_user(cmd, ubuf, len))
+		return -EFAULT;
+	if (!global_iommu_domain || !dbgdat.init)
+		return -ENODEV;
+
+	if (!strncmp(cmd, "punch", 5)) {
+		if (fault_test.iova)
+			return -EBUSY;
+		frame = dbgdat.frames[0];
+		spin_lock_irqsave(&frame->lock, flags);
+		if (frame->wpos)
+			iova = frame->data[(frame->wpos - 1) % FRAME_TRACE_LEN].dma_addr;
+		spin_unlock_irqrestore(&frame->lock, flags);
+		if (!iova)
+			return -ENOENT;
+		fault_test.phys = iommu_iova_to_phys(global_iommu_domain, iova);
+		if (!fault_test.phys)
+			return -ENOENT;
+		ret = iommu_unmap(global_iommu_domain, iova, PAGE_SIZE);
+		pr_err("sunxi-drm fault-test: unmapped page %pad (phys %pap) of the current scanout buffer: %d\n",
+		       &iova, &fault_test.phys, ret);
+		fault_test.iova = iova;
+	} else if (!strncmp(cmd, "heal", 4)) {
+		if (!fault_test.iova)
+			return -ENOENT;
+		ret = iommu_map(global_iommu_domain, fault_test.iova, fault_test.phys, PAGE_SIZE,
+				IOMMU_READ | IOMMU_WRITE, GFP_KERNEL);
+		pr_err("sunxi-drm fault-test: mapped page %pad back: %d\n", &fault_test.iova, ret);
+		fault_test.iova = 0;
+		if (ret)
+			return ret;
+	} else {
+		return -EINVAL;
+	}
+	return len;
+}
+
+static const struct proc_ops sunxidrm_fault_test_ops = {
+	.proc_write = sunxidrm_fault_test_write,
+};
+
+void sunxidrm_debug_fault_test_init(struct proc_dir_entry *dir)
+{
+	proc_create("fault-test", 0200, dir, &sunxidrm_fault_test_ops);
+}
+
+/* a7a-fedora: does [iova, iova+size) overlap a buffer committed to a DE plane recently (the last 64 updates)? */
+static bool sunxidrm_debug_unmap_watch(unsigned long iova, size_t size)
+{
+	unsigned long flags;
+	bool hit = false;
+	int id, i;
+
+	if (!dbgdat.init)
+		return false;
+	for (id = 0; id < DE_MAX_COUNT && !hit; id++) {
+		frame_trace_t *frame = dbgdat.frames[id];
+		spin_lock_irqsave(&frame->lock, flags);
+		for (i = 0; i < FRAME_TRACE_LEN; i++) {
+			trace_buf_t *t = &frame->data[i];
+			u64 start = t->dma_addr, end = start + (u64)t->pitches[0] * t->height;
+			if (!t->mapped || !t->dma_addr || !t->height)
+				continue;
+			if (iova < end && iova + size > start) {
+				hit = true;
+				break;
+			}
+		}
+		spin_unlock_irqrestore(&frame->lock, flags);
+	}
+	return hit;
+}
+
 void sunxidrm_debug_init(struct platform_device *pdev)
 {
 	int id = 0;
@@ -185,6 +284,7 @@ void sunxidrm_debug_init(struct platform_device *pdev)
 		dev_info(&pdev->dev, "register iommu fault callback for sunxi-drm, master=%d\n", master);
 		sunxi_iommu_register_fault_cb(sunxidrm_debug_record_exception, master);
 	}
+	sunxi_iommu_register_unmap_watch(sunxidrm_debug_unmap_watch);
 }
 #endif
 
@@ -249,6 +349,7 @@ void sunxidrm_debug_trace_frame(u32 crtc, u32 plane, struct drm_framebuffer *fb)
 	frame->data[index].plane = plane;
 	frame->data[index].update_ts = ktime_get();
 	frame->data[index].fb = fb;
+	frame->data[index].fb_id = fb ? fb->base.id : 0;
 	frame->data[index].mapped = 1;
 	if (fb && fb->format) {
 		frame->data[index].format = fb->format->format;
