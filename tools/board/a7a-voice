# ---------------------------------------------------------------- settings

def number_words(n: int) -> str:
    """0..999 999 as the recogniser writes them ("FIFTY FIVE", "TWO THOUSAND TEN"); larger numbers stay digits."""
    if n < 20:
        return ONES[n]
    if n < 100:
        return TENS[n // 10] + ("" if n % 10 == 0 else " " + ONES[n % 10])
    if n < 1000:
        return ONES[n // 100] + " hundred" + ("" if n % 100 == 0 else " " + number_words(n % 100))
    if n < 1000000:
        return number_words(n // 1000) + " thousand" + ("" if n % 1000 == 0 else " " + number_words(n % 1000))
    return str(n)


def spelled_address(written: str) -> str | None:
    """An address as written ("www.google.com", "sam@example.fr", "github.com/rabs9") in the words said for it ("www
    dot google dot com"), its digits kept ("1password dot com": spelled out, they would fall out of the address and
    leave a stranger's site, password.com: review 2026-11-22); None when no dot in it comes before a domain's ending
    ("e.g.", "3.30")."""
    parts = re.split(r"([.@/])", written)
    if not any(a == "." and b in DOMAINS for a, b in zip(parts, parts[1:])):
        return None
    said = {".": "dot", "@": "at", "/": "slash"}
    return " " + " ".join(said.get(p) or p.replace("-", " dash ") for p in parts) + " "


def spelled(s: str) -> str:
    """Numbers spelled out, a hyphenated word run together ("wi-fi" is "wifi")."""
    s = re.sub(r"(?<=[a-z])-(?=[a-z])", "", s)
    return re.sub(r"\d+", lambda m: f" {number_words(int(m.group())) if len(m.group()) < 7 else m.group()} ", s)


def words(s: str) -> list[str]:
    """Lower-case words as the recogniser writes them: numbers spelled out, a hyphenated word run together ("wi-fi" is
    "wifi"), no punctuation, apostrophes kept. An address it writes as one ("Go to LeMonde.fr": it does, for a site's
    name, "dot" and its ending said, board 2026-11-22) is in the words said for it (spelled_address), as typing by voice finds addresses."""
    s, out, at = s.lower().replace("’", "'"), [], 0
    for m in re.finditer(r"[a-z0-9-]+(?:[.@/][a-z0-9-]+)+", s):
        out.append(spelled(s[at:m.start()]))
        out.append(spelled_address(m.group()) or spelled(m.group()))
        at = m.end()
    return re.findall(r"[a-z0-9]+(?:'[a-z]+)?", "".join(out) + spelled(s[at:]))


def clean(raw) -> dict:
    """The settings the listener uses: the defaults under what `raw` sets, numbers clamped, the wake phrase non-empty.
    Commands are kept as typed (the panel shows them again), as strings; one without words or without a command line
    never matches."""
    cfg = json.loads(json.dumps(DEFAULTS))
    if not isinstance(raw, dict):
        return cfg
    if isinstance(raw.get("wake"), str) and words(raw["wake"]):
        cfg["wake"] = " ".join(raw["wake"].split())
    if isinstance(raw.get("assistant"), str):
        cfg["assistant"] = " ".join(raw["assistant"].split()) if words(raw["assistant"]) else ""
    if words(cfg["assistant"]) == words(cfg["wake"]):      # one phrase cannot mean both
        cfg["assistant"] = ""
    if isinstance(raw.get("commands"), list):
        cfg["commands"] = [{"say": str(c.get("say", "")), "run": str(c.get("run", ""))}
                           for c in raw["commands"] if isinstance(c, dict)]
    for k, (lo, hi) in LIMITS.items():
        v = raw.get(k)
        if isinstance(v, (int, float)) and not isinstance(v, bool):
            cfg[k] = min(hi, max(lo, float(v)))
    if isinstance(raw.get("mic"), str):
        cfg["mic"] = raw["mic"].strip()
    if isinstance(raw.get("npu"), bool):
        cfg["npu"] = raw["npu"]
    if isinstance(raw.get("found"), list):
        cfg["found"] = [{"id": f["id"], "say": str(f.get("say", "")), "run": str(f.get("run", "")),
                         "on": f.get("on") is not False, "kind": str(f.get("kind", "")), "made": str(f.get("made", ""))}
                        for f in raw["found"] if isinstance(f, dict) and isinstance(f.get("id"), str) and f["id"]]
    return cfg


def active(cfg: dict) -> list[dict]:
    """The commands the listener matches: the owner's own first (on a tie the first wins), then those a scan found
    that are switched on."""
    return cfg["commands"] + [f for f in cfg.get("found", []) if f["on"]]


def load_config(path: Path | None = None) -> tuple[dict, str]:
    """(settings, problem): the defaults when the file is missing. When it cannot be used (it does not parse, is not
    an object, or its commands are not a list), the defaults with the reason, for the caller to decide: the listener
    keeps the settings it has, or starts with no commands."""
    path = path or CONFIG
    try:
        raw = json.loads(path.read_text())
    except FileNotFoundError:
        return clean(None), ""
    except (OSError, ValueError) as e:
        return clean(None), f"{path}: {e}"
    if not isinstance(raw, dict):
        return clean(None), f"{path}: the settings are not a JSON object"
    if "commands" in raw and not isinstance(raw["commands"], list):
        return clean(None), f"{path}: its \"commands\" are not a list"
    return clean(raw), ""


def mtime(path: Path) -> int:
    try:
        return path.stat().st_mtime_ns
    except OSError:
        return 0


def write_json(path: Path, value) -> None:
    """Whole or not at all: a reader (the panel, the listener) never sees half a file."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(value, indent=1, ensure_ascii=False) + "\n")
    tmp.replace(path)


def read_json(path: Path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return None


# ---------------------------------------------------------------- matching

FILLER = {"the", "a", "an", "please"}
# what a pause after the wake phrase may hold before the command: the listener waits on (review 2026-11-18)
HESITATIONS = FILLER | {"um", "uh", "er", "erm", "hmm", "mm", "oh", "okay", "ok", "so", "well", "and"}
# sounds said before a command and not part of it ("uh, type hello"); not "and", "so", "well": "and go to bed, kids"
# is talk, not a search (review 2026-11-22)
LEAD_SOUNDS = {"um", "uh", "er", "erm", "hmm", "mm", "oh", "okay", "ok"}


def unled(heard: list[str]) -> list[str]:
    """The words without the sounds (LEAD_SOUNDS) they begin with."""
    n = next((n for n, w in enumerate(heard) if w not in LEAD_SOUNDS), len(heard))
    return heard[n:]
NEGATIONS = {"don't", "dont", "not", "never"}
# what one says to stop an answer being read ("hey computer, stop", "… that's enough"): no "no command" notice for it
STOPS = HESITATIONS | {"stop", "quiet", "enough", "cancel", "shush", "hush", "silence", "shut", "up", "be", "it",
                       "that's", "thats", "now", "talking", "speaking", "reading", "pause", "never", "mind", "fine",
                       "thank", "thanks", "you"}


def similar(a: str, b: str) -> float:
    return difflib.SequenceMatcher(None, a, b).ratio()


def close(a: str, b: str) -> bool:
    """One word close enough to be the other misheard: three quarters of the letters in common, 0.85 when either has
    five letters or fewer ("muted" is "mute"; "minute" is not, nor "look" "lock", nor "town" "down")."""
    return a == b or similar(a, b) >= (0.85 if min(len(a), len(b)) <= 5 else 0.75)


def covered(stretch: list[str], phrase: list[str]) -> float:
    """The share of the phrase's words (fillers aside) the stretch has, each close enough to a word of the stretch or
    two of them run together (the recogniser may write "fire fox"); a phrase word that is not, run together with the
    next one and then nearly the same (typed "wi fi", heard "wifi"; "lock screen" run together is not "screen")."""
    pool = stretch + ["".join(stretch[i:i + 2]) for i in range(len(stretch) - 1)]
    wanted = [w for w in phrase if w not in FILLER] or phrase
    got = i = 0
    while i < len(wanted):
        if any(close(wanted[i], x) for x in pool):
            got, i = got + 1, i + 1
        elif i + 1 < len(wanted) and any(similar(wanted[i] + wanted[i + 1], x) >= 0.9 for x in pool):
            got, i = got + 2, i + 2
        else:
            i += 1
    return got / len(wanted)


def find(heard: list[str], phrase: list[str]) -> int:
    """Where the phrase's words come in the sentence in a row (the last time), or -1."""
    p = len(phrase)
    for i in range(len(heard) - p, -1, -1):
        if heard[i:i + p] == phrase:
            return i
    return -1


def holds(longer: list[str], phrase: list[str]) -> bool:
    """The phrase comes in the longer one with words after it ("volume up" in "turn volume up to max")."""
    p = len(phrase)
    return any(longer[i:i + p] == phrase for i in range(len(longer) - p))


def score(heard: list[str], phrase: list[str], floor: float = 0.0) -> tuple[float, int]:
    """How well the sentence holds the phrase, 0..1, and where that stretch of it starts: 1 when its words come in it
    in a row, else the closest stretch of about as many words, its letters against the phrase's (spaces left out)
    times the share of the phrase's words it has (so "volume" alone is not "volume up", while "lock screen" still is
    "lock the screen"). A stretch whose letters alone fall short of `floor` is not looked at closer (its score cannot
    reach it): a long sentence against many commands stays quick (review 2026-11-18: 283 ms to 37 ms on the laptop)."""
    if not heard or not phrase:
        return 0.0, -1
    at = find(heard, phrase)
    if at >= 0:
        return 1.0, at
    target, p = "".join(phrase), len(phrase)
    best, at = 0.0, -1
    for n in range(max(1, p - 1), p + 2):
        for i in range(max(1, len(heard) - n + 1)):
            stretch = heard[i:i + n]
            r = similar("".join(stretch), target)
            if r > best and r >= floor:
                s = r * covered(stretch, phrase)
                if s > best:
                    best, at = s, i
    return best, at


def negated(heard: list[str], at: int, phrase: list[str]) -> bool:
    """"don't lock the screen": a negation right before the stretch, that the phrase does not have itself (only the
    word right before: "never mind, mute" and "not now, open firefox" are commands)."""
    return at > 0 and heard[at - 1] in NEGATIONS and heard[at - 1] not in phrase


def best_match(heard: list[str], commands: list[dict], floor: float) -> tuple[dict | None, float]:
    """(the command, its score) for a sentence's words; None when no command comes to `floor` (a negated one does not
    count). On a tie, the longer phrase."""
    best, best_score, best_len = None, 0.0, 0
    for c in commands:
        say = words(c.get("say", ""))
        if not say or not c.get("run", "").strip():
            continue
        s, at = score(heard, say, floor)
        if s >= floor and negated(heard, at, say):
            continue
        if s > best_score or (s == best_score and best is not None and len(say) > best_len):
            best, best_score, best_len = c, s, len(say)
    return (best, best_score) if best is not None and best_score >= floor else (None, best_score)


def wake_stretches(heard: list[str], wake: str) -> tuple[list[tuple[int, int, float]], str]:
    """The stretches of about the wake phrase's length that come close to it by their letters (the recogniser may
    write "a computer" for "hey computer"), as (start, end, closeness) in the order of the sentence; and the phrase."""
    w = words(wake)
    target, p = "".join(w), len(w)
    return sorted((i, i + n, r) for n in range(max(1, p - 1), p + 2) for i in range(len(heard) - n + 1)
                  if (r := similar("".join(heard[i:i + n]), target)) >= WAKE_FOUND), target


def first_stretch(found: list[tuple[int, int, float]], heard: list[str], wake: str) -> tuple[int, int, float]:
    """Of the wake phrase's stretches (wake_stretches), the one taken for it (cut_at_wake): the first as written; else
    the first close one, unless its first word cannot be the phrase's misheard ("my computer" in the pre-roll; "a",
    "eh", "he" can be "hey") and a later close one is the phrase word for word, beginning with its very first word
    (the owner's "hey commuter": 2026-11-24, open since 11-23); else the closest. Not covered(), whose run-together
    letters take "the computer" for "hey computer"; not a later stretch over an earlier one that may be the phrase
    ("a computer, type they computed it": "they" is close to "hey", and the command was cut: review 2026-11-24).
    (The recogniser writing "a computer" for the phrase over a pre-roll "my computer" needs timings.)"""
    phrase = words(wake)

    def could_be(x: str) -> bool:           # a word the recogniser writes for the phrase's first one
        return close(x, phrase[0]) or (len(x) <= 2 and x[0] in "aeiouh")

    def word_for_word(f: tuple[int, int, float]) -> bool:
        return (f[1] - f[0] == len(phrase) and heard[f[0]] == phrase[0]
                and all(close(a, b) for a, b in zip(heard[f[0]:f[1]], phrase)))

    if exact := next((f for f in found if f[2] >= WAKE_EXACT), None):
        return exact
    strong = next((f for f in found if f[2] >= WAKE_STRONG), None)
    if strong is not None and not could_be(heard[strong[0]]):
        later = next((f for f in found if f[0] > strong[0] and f[2] >= WAKE_STRONG and word_for_word(f)), None)
        return later or strong
    return strong or max(found, key=lambda f: f[2])


def phrase_start(heard: list[str], wake: str, end: int) -> int | None:
    """Where the wake phrase, as the recogniser wrote it, begins when it ends at `end`: the closest stretch ending there
    (the later of two as close); None when none does (only the phrase's end was caught: cut_at_wake)."""
    found, _ = wake_stretches(heard, wake)
    ends = [f for f in found if f[1] == end]
    return max(ends, key=lambda f: (f[2], f[0]))[0] if ends else None


def cut_at_wake(heard: list[str], wake: str) -> tuple[int, bool] | None:
    """Where the command may begin in the sentence the recogniser began before the phrase was spotted, and whether
    the phrase was found as written: what came before it (the pre-roll's two seconds) is not a command, and is
    dropped, unread. The phrase is the FIRST stretch that comes nearly as written (else the first that comes close,
    else the closest), so a command that holds something like it ("shut down the computer") is not cut, nor an
    earlier "my computer" in the pre-roll taken for it; of the stretches over the same words the closest, the
    longest; and a phrase said twice in a row goes too (review 2026-11-18: sixteen cases). A phrase the pre-roll
    caught only the end of ("...uter, open firefox") leaves that end, dropped too. None when it is not there."""
    found, target = wake_stretches(heard, wake)
    if not found:
        for k in (2, 1):                    # its end only: the first word or two match the phrase's last letters
            tail = "".join(heard[:k])
            if len(heard) > k and len(tail) >= 2 and similar(tail, target[-len(tail):]) >= WAKE_STRONG:
                return k, False
        return None
    first = first_stretch(found, heard, wake)

    def through(i0: int, e0: int) -> tuple[int, float]:
        over = [f for f in found if i0 <= f[0] < e0]
        best = max(r for _, _, r in over)
        return max(e for _, e, r in over if r >= best - 0.05), best

    end, best = through(first[0], first[1])
    while again := [f for f in found if f[0] == end and f[2] >= best - 0.05]:
        f = max(again, key=lambda f: f[2])
        end, best = through(f[0], f[1])
    return end, first[2] >= WAKE_EXACT


def after_wake(heard: list[str], wake: str) -> list[str] | None:
    """The words after the wake phrase in the first sentence (cut_at_wake); None when the phrase is not there."""
    cut = cut_at_wake(heard, wake)
    return None if cut is None else heard[cut[0]:]


def lead_wake(heard: list[str], wake: str) -> list[str]:
    """A later sentence (the wake phrase said again): the whole phrase, where it begins the sentence, goes; a single
    word of it does not ("computer status" stays whole), and a one-word phrase never (it may begin a command)."""
    found, _ = wake_stretches(heard, wake)
    p = len(words(wake))
    starts = [(r, e) for i, e, r in found if i == 0 and e >= p and r >= WAKE_STRONG]
    return heard[max(starts)[1]:] if starts and p > 1 else heard


def phrase_inside(heard: list[str], wake: str) -> tuple[int, int] | None:
    """Where the wake phrase comes in a sentence after words of its own, as written or word for word close ("hey
    commuter"): (start, end), the first time; None when it does not, or only at the start. A one-word phrase never
    (it is too likely in talk)."""
    phrase = words(wake)
    n = len(phrase)
    if n < 2:
        return None
    for i in range(1, len(heard) - n + 1):
        stretch = heard[i:i + n]
        if stretch == phrase or all(close(a, b) for a, b in zip(stretch, phrase)):
            return i, i + n
    return None


def keyword_line(pieces: list[str]) -> str:
    """The wake phrase as the spotter's keyword file wants it: its word pieces, separated by spaces."""
    return " ".join(pieces)


def wake_phrases(cfg: dict) -> list[str]:
    """The phrases the spotter listens for: the commands' one, the Assistant's when there is one, and "hey <name>"
    for each online assistant (cfg["online"]; one that would be another phrase again is left out)."""
    phrases = [cfg["wake"]] + ([cfg["assistant"]] if cfg.get("assistant") else [])
    for name in cfg.get("online", []):
        phrase = f"hey {name}"
        if words(phrase) not in [words(p) for p in phrases]:
            phrases.append(phrase)
    return phrases


# the panel's providers (prefs.rs Provider::key) and the words it numbers a name taken already with
PROVIDERS = ("google", "cloudflare", "brave", "mistral", "perplexity", "openrouter", "groq", "openai", "other")
ORDINALS = ("second", "third", "fourth", "fifth", "sixth")
# what Rust's str::trim takes off (Unicode White_Space; Python's strip takes \x1c-\x1f too: review 2026-11-19)
RUST_SPACE = "\t\n\x0b\x0c\r \x85\xa0\u1680" + "".join(chr(c) for c in range(0x2000, 0x200b)) + "\u2028\u2029\u202f\u205f\u3000"
SHORTEST = 3            # letters an online assistant's name needs to be a wake phrase ("hey ai" is in too much talk)


def online_name(name: str) -> str:
    """A name as the panel keeps it (prefs.rs online_name): lower-case letters only, at most 3 words, 24 characters."""
    cleaned = "".join(c if "a" <= c <= "z" else " " for c in name.lower())
    return " ".join(cleaned.split()[:3])[:24].strip()


def online_names(path: Path | None = None) -> list[str]:
    """The online assistants the panel's settings switch on, with a key, by name: "hey <name>" asks one by voice
    (a7a-panel --answer --assistant <name>). Named as the panel names them (prefs.rs from_json and cleaned: the
    provider's name for none, a name taken already numbered "second …", a seventh dropped), or the panel would not
    know the name it is asked for. The names only: the keys stay in the panel's file."""
    raw = read_json(path or PANEL)
    if not isinstance(raw, dict) or not isinstance(raw.get("online"), list):
        return []
    named: list[str] = []                   # every one's, switched on or not: they are numbered together
    names: list[str] = []
    for o in raw["online"]:
        if not isinstance(o, dict):
            continue
        provider = o["provider"].strip(RUST_SPACE).lower() if isinstance(o.get("provider"), str) else ""
        base = online_name(o["name"] if isinstance(o.get("name"), str) else "") or (provider if provider in PROVIDERS else "other")
        name = base
        for k in ORDINALS:
            if name not in named:
                break
            name = f"{k} {base}"
        if name in named:
            continue
        named.append(name)
        on = o["on"] if isinstance(o.get("on"), bool) else True
        if on and isinstance(o.get("key"), str) and o["key"].strip(RUST_SPACE):
            names.append(name)
    return names


def keywords(cfg: dict, pieces_of, known: set) -> tuple[list[str], list[str], list[str]]:
    """The spotter's keyword lines (`pieces_of` a phrase's word pieces, `known` the ones the spotter has): the
    commands' phrase, the Assistant's, and "hey <name>" for each online assistant it can tell from those; with the
    names it listens for, and why it does not for the others. The spotter names the first phrase it hears whole, so
    one that begins another (or is another) would take it: of the two, the one first in the list stays."""
    lines: list[str] = []
    taken: list[list[str]] = []
    online: list[str] = []
    left: list[str] = []
    for phrase in [cfg["wake"]] + ([cfg["assistant"]] if cfg.get("assistant") else []):
        pieces = pieces_of(phrase)
        if missing := [x for x in pieces if x not in known]:
            raise ValueError(f"the wake phrase “{phrase}” has pieces the spotter does not know: {missing}")
        lines.append(keyword_line(pieces))
        taken.append(pieces)
    for name in cfg.get("online", []):
        phrase = f"hey {name}"
        pieces = pieces_of(phrase)
        if missing := [x for x in pieces if x not in known]:
            left.append(f"“{phrase}”: the spotter does not know some of its sounds ({' '.join(missing)})")
        elif sum(c.isalpha() for c in name) < SHORTEST:
            left.append(f"“{phrase}”: too short, a name needs {SHORTEST} letters or more")
        elif pieces in taken:
            left.append(f"“{phrase}”: another wake phrase already")
        elif any(t[:len(pieces)] == pieces or pieces[:len(t)] == t for t in taken):
            left.append(f"“{phrase}”: it begins like another wake phrase, or another begins like it")
        else:
            lines.append(keyword_line(pieces))
            taken.append(pieces)
            online.append(name)
    return lines, online, left


def heard_as(phrases: list[str]) -> str:
    return " and ".join(f"“{p}”" for p in phrases)


def level(samples) -> float:
    """A chunk's loudness (RMS, 1.0 = full scale)."""
    n = len(samples)
    if not n:
        return 0.0
    dot = getattr(samples, "dot", None)
    return math.sqrt(float(dot(samples)) / n) if dot else math.sqrt(sum(x * x for x in samples) / n)


# ---------------------------------------------------------------- reading answers aloud

# signs and units the voice reads badly, in words ("52 °C" came out as "fifty two DC", "6 GB" as "six G B": board
# 2026-11-19)
SAID_AS = [(r"\s*°\s*C\b", " degrees Celsius"), (r"\s*°\s*F\b", " degrees Fahrenheit"), (r"\s*°", " degrees"),
           (r"(?<=\d)\s*%", " percent"), (r"(?<=\d)\s*(?:GiB|GB)\b", " gigabytes"),
           (r"(?<=\d)\s*(?:MiB|MB)\b", " megabytes"), (r"(?<=\d)\s*(?:KiB|kB|KB)\b", " kilobytes"),
           (r"(?<=\d)\s*GHz\b", " gigahertz"), (r"(?<=\d)\s*MHz\b", " megahertz"),
           (r"\btok(?:ens)?/s\b", "tokens a second"), (r"\s&\s", " and ")]
SAID = set(".,;:!?'\"()-+=$€£%")      # signs besides letters, digits and spaces that stay in what is read
FIRST_PIECE = 100     # characters: the first piece of an answer, which is made whole before anything plays (about
                      # 6 s of speech, 3 s of work); a longer sentence is cut after a comma, else between two words
PIECE = 200           # ... and every later one, made while the one before plays


def speakable(text: str) -> list[str]:
    """An answer (markdown) as the voice reads it, in pieces of about a sentence: code blocks, the addresses of links,
    markdown's marks and the signs a voice cannot say left out, units in words, each line of a list or a table a
    sentence of its own."""
    text = re.sub(r"```.*?(?:```|\Z)", "\n", text, flags=re.S)
    text = re.sub(r"!?\[([^\]]*)\]\([^)]*\)", r"\1", text)
    text = re.sub(r"<?\bhttps?://[^\s)>\]]*[^\s)>\].,;:!?'\"]>?", "the link", text)
    text = re.sub(r"[^\s.,;:!?]{40,}", " ", text)        # a hash, a key: nothing to say
    sentences = []
    for line in text.splitlines():
        line = line.strip()
        if "-" in line and re.fullmatch(r"\|?[\s:|-]+\|?", line):          # a table's rule
            continue
        line = re.sub(r"^(?:#{1,6}|>|[-*+]|\d+[.)])\s+", "", line)
        if "|" in line:
            line = line.strip("|").replace("|", ", ")
        line = re.sub(r"\*\*|__|~~|[`*]", "", line)
        line = re.sub(r"(?<=\w)_(?=\w)", " ", line).replace("_", "")
        for pattern, said in SAID_AS:
            line = re.sub(pattern, said, line)
        line = "".join(c if c in SAID or unicodedata.category(c)[0] in "LNZ" else " " for c in line)
        line = re.sub(r"\s+([,.;:!?])", r"\1", " ".join(line.split())).strip(" ,;")
        if not re.search(r"\w", line):
            continue
        if line[-1] not in ".!?:":
            line += "."
        sentences += re.split(r"(?<=[.!?])\s+", line)
    pieces: list[str] = []
    for s in sentences:
        while len(s) > (most := PIECE if pieces else FIRST_PIECE):
            cut = (max((m.end() for m in re.finditer(r"[,;:]\s", s[:most])), default=0) or s.rfind(" ", 0, most) + 1
                   or most)
            pieces.append(s[:cut].strip())
            s = s[cut:].strip()
        pieces.append(s)
    return [p for p in pieces if re.search(r"\w", p)]


