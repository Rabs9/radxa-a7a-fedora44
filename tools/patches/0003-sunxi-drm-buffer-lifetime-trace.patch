 }
 
+/* a7a-fedora buffer lifetime trace (see sunxi_gem_dma_free) */
+static void sunxi_drm_fb_trace(const char *what, struct drm_framebuffer *fb)
+{
+	struct drm_gem_dma_object *dma_obj = fb->obj[0] ? to_drm_gem_dma_obj(fb->obj[0]) : NULL;
+	dma_addr_t addr = dma_obj ? dma_obj->dma_addr : 0;
+
+	pr_info("sunxi-drm: fb %u %s %ux%u %p4cc mod=0x%llx pitch=%u dma_addr=%pad %s by %s[%d]\n",
+		fb->base.id, what, fb->width, fb->height, &fb->format->format,
+		fb->modifier, fb->pitches[0], &addr,
+		(fb->obj[0] && fb->obj[0]->import_attach) ? "imported" : "dumb",
+		current->comm, task_pid_nr(current));
+}
+
 static void sunxi_drm_gem_fb_destroy(struct drm_framebuffer *fb)
 {
+	sunxi_drm_fb_trace("destroy", fb);
 	sunxidrm_debug_trace_framebuffer_unmap(fb);
 	drm_gem_fb_destroy(fb);
 }
@@ -115,8 +130,12 @@ struct drm_framebuffer *
 sunxi_drm_gem_fb_create(struct drm_device *dev, struct drm_file *file,
 			const struct drm_mode_fb_cmd2 *mode_cmd)
 {
-	return drm_gem_fb_create_with_funcs(dev, file, mode_cmd,
-					    &sunxi_drm_gem_fb_funcs);
+	struct drm_framebuffer *fb = drm_gem_fb_create_with_funcs(dev, file, mode_cmd,
+								  &sunxi_drm_gem_fb_funcs);
+
+	if (!IS_ERR(fb))
+		sunxi_drm_fb_trace("create", fb);
+	return fb;
 }
 
 static int sunxi_drm_atomic_helper_commit(struct drm_device *dev,
@@ -1193,6 +1212,7 @@ static int sunxi_drm_procfs_create(void)
 static int sunxi_drm_procfs_init(struct drm_device *drm)
 {
 	proc_create_single_data("debug", 444, proc_entry, sunxidrm_debug_show, NULL);
+	sunxidrm_debug_fault_test_init(proc_entry);
 
 	proc_create_single_data("status", 444, proc_entry,
 				sunxi_drm_procfs_status_show, drm);
diff --git a/drivers/drm/sunxi_drm_gem.c b/drivers/drm/sunxi_drm_gem.c
index 593e0cf..614afd9 100644
--- a/drivers/drm/sunxi_drm_gem.c
+++ b/drivers/drm/sunxi_drm_gem.c
@@ -12,6 +12,8 @@
 
 #include <linux/dma-buf.h>
 #include <linux/dma-direction.h>
+#include <linux/sched.h>
+#include <linux/printk.h>
 #include <drm/drm.h>
 #include <drm/drm_fb_helper.h>
 #include <drm/drm_gem.h>
@@ -133,6 +135,18 @@ void sunxi_gem_dma_free(struct sunxi_gem_object *sgem_obj)
 	struct drm_gem_object *gem_obj = &dma_obj->base;
 	struct iosys_map map = IOSYS_MAP_INIT_VADDR(dma_obj->vaddr);
 
+	/*
+	 * a7a-fedora buffer lifetime trace: the device address is what the
+	 * display engine scans out from; when it is unmapped under a plane
+	 * the DE faults on it (sunxi-iommu "Bug is in DE0 module").
+	 */
+	pr_info("sunxi-drm: gem free %s dma_addr=%pad size=%zu name=%d%s%s by %s[%d]\n",
+		gem_obj->import_attach ? "imported" : "dumb", &dma_obj->dma_addr,
+		gem_obj->size, gem_obj->name,
+		gem_obj->import_attach ? " exporter=" : "",
+		gem_obj->import_attach ? gem_obj->import_attach->dmabuf->exp_name : "",
+		current->comm, task_pid_nr(current));
+
 	if (gem_obj->import_attach) {
 		if (dma_obj->vaddr)
 			dma_buf_vunmap_unlocked(gem_obj->import_attach->dmabuf, &map);
