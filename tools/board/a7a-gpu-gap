def _vk_items():
    """every Vulkan requirement the gates depend on: its declared class (limit = the driver reports a number below
    the gate and the mechanism exists; project = something to implement, even when it reads like a limit, e.g.
    timestampValidBits) and the GLES fact that proves the hardware has it, for this item alone (second reviewer
    pass: a flag-level "ES 3.2" proved items ES never requires). None = nothing in GLES proves it."""
    it = {}

    def put(reqs, cls, gles):
        for r in reqs:
            it[r] = {"class": cls, "gles": gles}

    vfmt = "fmt:VK_FORMAT_%s_PACK32:buffer:VK_FORMAT_FEATURE_VERTEX_BUFFER_BIT"
    put(_XFB, "project", "es:3.0")                                   # transform feedback is core ES 3.0
    put(["limit:maxUniformBufferRange>=16384"], "limit", "es:3.0|glesint:GL_MAX_UNIFORM_BLOCK_SIZE>=16384")
    put(["limit:maxPerStageDescriptorUniformBuffers>=13"], "limit", "es:3.0|glesint:GL_MAX_VERTEX_UNIFORM_BLOCKS>=12")
    put(["limit:maxPerStageDescriptorUniformBuffers>=15"], "limit", "glesint:GL_MAX_VERTEX_UNIFORM_BLOCKS>=14")
    put(["feat:fragmentStoresAndAtomics"], "project", "glesint:GL_MAX_FRAGMENT_SHADER_STORAGE_BLOCKS>=1")
    put(["limit:maxPerStageDescriptorStorageBuffers>=1"], "limit", "glesint:GL_MAX_FRAGMENT_SHADER_STORAGE_BLOCKS>=1")
    put(["limit:maxPerStageDescriptorStorageBuffers>=2"], "limit", "glesint:GL_MAX_FRAGMENT_SHADER_STORAGE_BLOCKS>=2")
    put(["feat:shaderStorageImageExtendedFormats", "feat:shaderStorageImageWriteWithoutFormat"], "project", None)
    put(["limit:maxPerStageDescriptorStorageImages>=1"], "limit", "es:3.1")
    put(["limit:maxPerStageDescriptorSamplers>=16", "limit:maxPerStageDescriptorSampledImages>=16"], "limit",
        "es:3.0|glesint:GL_MAX_TEXTURE_IMAGE_UNITS>=16")
    put(["fmt:VK_FORMAT_%s:optimal:VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT" % f for f in ("R8G8B8A8_UNORM", "R8G8B8A8_SRGB")],
        "project", "es:3.0")
    put(["fmt:VK_FORMAT_%s:optimal:VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT" % f
         for f in ("R16_UNORM", "R16G16_UNORM", "R16_SNORM", "R16G16_SNORM")], "project", "glesext:GL_EXT_texture_norm16")
    put(["limit:maxComputeWorkGroupInvocations>=1024"], "project", "glesint:GL_MAX_COMPUTE_WORK_GROUP_INVOCATIONS>=1024")
    put([_ES31_COMPAT[-2]], "project", "es:3.0")                     # sampled depth/stencil texture
    put(["limit:framebufferNoAttachmentsSampleCounts>=4"], "limit", "es:3.1|glesint:GL_MAX_FRAMEBUFFER_SAMPLES>=4")
    put(_RGB32_TBO, "project", "es:3.2|glesext:GL_EXT_texture_buffer|glesext:GL_OES_texture_buffer")
    put(_VOTE[:1], "project", None)
    put(_VOTE[1:], "project", "glesext:GL_EXT_shader_group_vote")
    put(["feat:dualSrcBlend"], "project", "glesext:GL_EXT_blend_func_extended")
    put(["limit:maxFragmentDualSrcAttachments>=1"], "project", "glesint:GL_MAX_DUAL_SOURCE_DRAW_BUFFERS>=1")
    # a timer-query extension may count 0 bits: only the counter bits prove timestamps
    put(["limit:timestampValidBits>=1"], "project", "glesint:GL_QUERY_COUNTER_BITS_TIMESTAMP>=1")
    # ES 3.0 has the 2_10_10_10 vertex types in RGBA order (normalized and not); no GLES has the BGRA order
    put([vfmt % ("A2B10G10R10_" + t) for t in ("UNORM", "SNORM", "USCALED", "SSCALED")], "project", "es:3.0")
    put([vfmt % ("A2R10G10B10_" + t) for t in ("UNORM", "SNORM", "USCALED", "SSCALED")], "project", None)
    put(["fmt:VK_FORMAT_B10G11R11_UFLOAT_PACK32:buffer:VK_FORMAT_FEATURE_VERTEX_BUFFER_BIT"], "project", None)
    put(["feat:tessellationShader"], "project",
        "es:3.2|glesext:GL_EXT_tessellation_shader|glesext:GL_OES_tessellation_shader")
    put(["ext:VK_KHR_maintenance2"], "project", None)
    put(["feat:multiViewport", "limit:maxViewports>=16"], "project", "glesint:GL_MAX_VIEWPORTS>=16")
    put(["feat:robustBufferAccess"], "project", "glesext:GL_KHR_robust_buffer_access_behavior")
    put(["feat:robustImageAccess2|feat:robustImageAccess"], "project", None)    # GLES robustness says nothing on images
    put(["ext:VK_KHR_draw_indirect_count"], "project", None)
    put(["ext:VK_KHR_dynamic_rendering_local_read"], "project",
        "glesext:GL_EXT_shader_framebuffer_fetch|glesext:GL_EXT_shader_framebuffer_fetch_non_coherent")
    put(["feat:geometryShader"], "project", "es:3.2|glesext:GL_EXT_geometry_shader|glesext:GL_OES_geometry_shader")
    put(["limit:maxGeometryShaderInvocations>=32"], "project", "glesint:GL_MAX_GEOMETRY_SHADER_INVOCATIONS>=32")
    put(["feat:imageCubeArray"], "project", "es:3.2|glesext:GL_EXT_texture_cube_map_array")
    put(["limit:maxImageDimension1D>=16384", "limit:maxImageDimension2D>=16384"], "limit",
        "glesint:GL_MAX_TEXTURE_SIZE>=16384")
    put(["limit:maxImageDimensionCube>=16384"], "limit", "glesint:GL_MAX_CUBE_MAP_TEXTURE_SIZE>=16384")
    put(["limit:maxImageDimension3D>=2048"], "limit", "glesint:GL_MAX_3D_TEXTURE_SIZE>=2048")
    put(["limit:maxImageArrayLayers>=2048"], "limit", "glesint:GL_MAX_ARRAY_TEXTURE_LAYERS>=2048")
    return it


